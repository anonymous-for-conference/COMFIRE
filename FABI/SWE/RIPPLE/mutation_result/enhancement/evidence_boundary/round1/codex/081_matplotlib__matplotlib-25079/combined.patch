+def test_colorbar_set_norm_after_creation():
+    rng = np.random.default_rng(0)
+    img = rng.uniform(1, 5, (25, 25))
+
+    fig, ax = plt.subplots()
+    plot = ax.pcolormesh(img)
+    cbar = fig.colorbar(plot, ax=ax)
+
+    plot.norm = LogNorm(1, 5)
+    plot.autoscale()
+
+    fig.canvas.draw()
+
+    assert isinstance(plot.norm, LogNorm)
+    assert isinstance(cbar.norm, LogNorm)
+    assert np.isclose(plot.norm.vmin, 1)
+    assert np.isclose(plot.norm.vmax, 5)
+
