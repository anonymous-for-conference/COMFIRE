+def test_range_slider_callback_can_rebuild_widgets():
+    fig = plt.figure()
+    calls = []
+    state = {}
+
+    def add_elements():
+        fig.clf()
+        slider_ax = fig.add_axes([0.1, 0.45, 0.8, 0.1])
+        button_ax = fig.add_axes([0.1, 0.30, 0.8, 0.1])
+
+        state["slider"] = widgets.RangeSlider(
+            slider_ax, "Test", valmin=1, valmax=10, valinit=(1, 10))
+        state["button"] = widgets.Button(button_ax, "Test")
+        state["slider"].on_changed(on_changed)
+        state["button"].on_clicked(on_click)
+
+    def on_changed(values):
+        calls.append(("changed", values))
+        add_elements()
+        fig.canvas.draw()
+
+    def on_click(event):
+        calls.append(("clicked", event))
+        add_elements()
+        fig.canvas.draw()
+
+    add_elements()
+    fig.canvas.draw()
+
+    slider = state["slider"]
+    button = state["button"]
+    center = slider.ax.transAxes.transform((0.5, 0.5))
+    MouseEvent("button_press_event", fig.canvas, *center, 1)._process()
+    MouseEvent("motion_notify_event", fig.canvas,
+               *slider.ax.transAxes.transform((0.6, 0.5)))._process()
+
+    assert calls[0][0] == "changed"
+    assert fig.canvas.mouse_grabber is None
+
+    MouseEvent("button_press_event", fig.canvas,
+               *button.ax.transAxes.transform((0.5, 0.5)), 1)._process()
+    MouseEvent("button_release_event", fig.canvas,
+               *button.ax.transAxes.transform((0.5, 0.5)), 1)._process()
+    assert calls[1][0] == "clicked"
+
+
