+    def test_pairplot_hue_order_subset(self):
+
+        hue_order = list("ab")
+        g = ag.pairplot(
+            self.df,
+            hue="a",
+            hue_order=hue_order,
+            diag_kind=None,
+        )
+
+        ax = g.axes[1, 0]
+        points = ax.collections[0]
+        facecolors = points.get_facecolors()
+        assert np.unique(facecolors[self.df.a == "a", -1]).item() == 1
+        assert np.unique(facecolors[self.df.a == "b", -1]).item() == 1
+        assert np.unique(facecolors[self.df.a == "c", -1]).item() == 0
+        assert [t.get_text() for t in g.legend.texts] == hue_order
