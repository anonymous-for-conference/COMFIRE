+def test_write_header_rows():
+    out = StringIO()
+    tbl = QTable({"wave": [350, 950] * u.nm, "response": [0.7, 1.2] * u.count})
+
+    ascii.write(tbl, out, format="ascii.rst", header_rows=["name", "unit"])
+
+    assert_equal_splitlines(
+        out.getvalue(),
+        """\
+===== ========
+ wave response
+   nm       ct
+350.0      0.7
+950.0      1.2
+===== ========
+""",
+    )
