@@ -1525,7 +1525,7 @@ class DraggableBase:
                 self.canvas.draw()
 
     def on_pick(self, evt):
-        if self._check_still_parented() and evt.artist == self.ref_artist:
+        if self._check_still_parented(evt) and evt.artist == self.ref_artist:
