+def test_MatrixExpr_indexed_latex_printing():
+    i, j, k = symbols("i j k")
+    M = MatrixSymbol("M", k, k)
+    N = MatrixSymbol("N", k, k)
+
+    assert latex(Dummy("_i_1")) == r"i_{1}"
+    assert latex((M*N)[i, j]) == r"\sum_{i_{1}=0}^{k - 1} M_{i, i_{1}} N_{i_{1}, j}"
