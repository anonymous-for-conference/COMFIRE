+def test_colorbar_update_normal_after_norm_assignment():
+    fig, ax = plt.subplots()
+    im = ax.imshow(np.arange(1, 5).reshape(2, 2))
+    cbar = fig.colorbar(im)
+
+    im.norm = LogNorm()
+    cbar.update_normal(im)
+
+    assert cbar.ax.yaxis.get_scale() == 'log'
+    assert np.isclose(cbar.vmin, 1)
+    assert np.isclose(cbar.vmax, 4)
