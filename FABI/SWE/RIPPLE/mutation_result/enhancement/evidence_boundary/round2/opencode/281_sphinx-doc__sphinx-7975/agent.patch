+@pytest.mark.sphinx('dummy', freshenv=True)
+def test_create_single_index_symbols_grouped(app):
+    text = (".. index:: @foo\n"
+            ".. index:: £bar\n"
+            ".. index:: ←baz\n"
+            ".. index:: Sphinx\n")
+    restructuredtext.parse(app, text)
+    index = IndexEntries(app.env).create_index(app.builder)
+    assert index == [
+        ('Symbols', [('@foo', [[('', '#index-0')], [], None]),
+                     ('£bar', [[('', '#index-1')], [], None]),
+                     ('←baz', [[('', '#index-2')], [], None])]),
+        ('S', [('Sphinx', [[('', '#index-3')], [], None])]),
+    ]
+
