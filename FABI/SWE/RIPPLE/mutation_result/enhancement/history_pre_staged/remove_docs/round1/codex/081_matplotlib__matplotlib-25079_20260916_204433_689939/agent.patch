+def test_colorbar_set_norm_then_autoscale_lognorm():
+    rng = np.random.default_rng(0)
+    img = rng.uniform(1, 5, (25, 25))
+
+    fig, ax = plt.subplots()
+    plot = ax.pcolormesh(img)
+    fig.colorbar(plot, ax=ax)
+
+    plot.set_norm(LogNorm(vmin=1, vmax=5))
+    plot.autoscale()
+
+    assert np.isclose(plot.norm.vmin, img.min())
+    assert np.isclose(plot.norm.vmax, img.max())
+    fig.canvas.draw()
+
