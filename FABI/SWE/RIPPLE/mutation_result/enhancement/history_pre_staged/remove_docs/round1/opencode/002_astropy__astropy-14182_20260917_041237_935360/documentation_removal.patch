-
-    >>> bins, binshw, p, perr = binned_binom_proportion(mag, detected, bins=20,
-    ...                                                 interval='wald')
-    >>> plt.errorbar(bins, p, xerr=binshw, yerr=perr, ls='none', marker='o',
-    ...              label='estimate')
