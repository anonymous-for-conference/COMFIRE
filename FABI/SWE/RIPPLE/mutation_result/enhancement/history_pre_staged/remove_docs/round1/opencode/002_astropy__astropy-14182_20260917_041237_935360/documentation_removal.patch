-   :include-source:
-   :align: center
-   :nofigs:
@@ -168,2 +9,0 @@ for each of the spatial axes.
-    import matplotlib.pyplot as plt
-    ax = plt.subplot(projection=wcs, slices=(50, 'x', 0))
@@ -171,4 +10,0 @@ for each of the spatial axes.
-.. plot::
-   :context:
-   :include-source:
-   :align: center
@@ -176 +11,0 @@ for each of the spatial axes.
-   ax.plot(image_data[0, :, 50])
@@ -178,4 +12,0 @@ for each of the spatial axes.
-   ra, dec, wave = ax.coords
-   ra.set_ticks(color="red")
-   ra.set_ticklabel(color="red")
-   ra.grid(color="red")
@@ -183,3 +14,172 @@ for each of the spatial axes.
-   dec.set_ticks(color="blue")
