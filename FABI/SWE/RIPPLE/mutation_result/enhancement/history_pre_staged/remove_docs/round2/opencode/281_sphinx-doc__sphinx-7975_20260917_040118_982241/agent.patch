+@pytest.mark.sphinx('dummy', freshenv=True)
+def test_create_single_index_symbols_group(app):
+    text = (".. index:: @foo\n"
+            ".. index:: alpha\n"
+            ".. index:: £bar\n"
+            ".. index:: ←baz\n")
+    restructuredtext.parse(app, text)
+    index = IndexEntries(app.env).create_index(app.builder)
+    assert len(index) == 2
+    assert index[0] == ('Symbols', [('@foo', [[('', '#index-0')], [], None]),
+                                    ('£bar', [[('', '#index-2')], [], None]),
+                                    ('←baz', [[('', '#index-3')], [], None])])
+    assert index[1] == ('A', [('alpha', [[('', '#index-1')], [], None])])
+
