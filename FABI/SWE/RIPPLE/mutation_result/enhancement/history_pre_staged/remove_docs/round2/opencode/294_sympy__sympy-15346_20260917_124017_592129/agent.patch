@@ -872,6 +872,31 @@ def do(rv, first=True):
                 return rv
 
                          
+            def _trig_pair(term):
+                coeff, rest = term.as_coeff_Mul()
+                factors = Mul.make_args(rest)
+                if len(factors) != 2:
+                    return None
+                if not all(isinstance(f, (sin, cos)) for f in factors):
+                    return None
+                return coeff, factors
+
+            t1 = _trig_pair(args[0])
+            t2 = _trig_pair(args[1])
+            if t1 and t2 and t1[0] == t2[0]:
+                c, f1 = t1
+                _, f2 = t2
+                funcs1 = tuple(f.func for f in f1)
+                funcs2 = tuple(f.func for f in f2)
+                args1 = [f.args[0] for f in f1]
+                args2 = [f.args[0] for f in f2]
+                if ((funcs1, funcs2) in [((cos, cos), (sin, sin)), ((sin, sin), (cos, cos))]
+                        and set(args1) == set(args2)):
+                    return c*cos(args1[0] - args1[1])
+                if ((funcs1, funcs2) in [((sin, cos), (cos, sin)), ((cos, sin), (sin, cos))]
+                        and set(args1) == set(args2)):
+                    return c*sin(args1[0] + args1[1])
+
             split = trig_split(*args, two=True)
             if not split:
                 return rv
