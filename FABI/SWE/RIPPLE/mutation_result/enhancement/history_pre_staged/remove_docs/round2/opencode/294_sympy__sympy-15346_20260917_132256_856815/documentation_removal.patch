-    >>> from sympy.physics.continuum_mechanics.beam import Beam
-    >>> from sympy import symbols
-    >>> E, I = symbols('E, I')
-    >>> R1, R2 = symbols('R1, R2')
-    >>> b1 = Beam(2, E, 1.5*I)
-    >>> b2 = Beam(2, E, I)
-    >>> b = b1.join(b2, "fixed")
-    >>> b.apply_load(20, 4, -1)
-    >>> b.apply_load(R1, 0, -1)
-    >>> b.apply_load(R2, 0, -2)
-    >>> b.bc_slope = [(0, 0)]
-    >>> b.bc_deflection = [(0, 0)]
