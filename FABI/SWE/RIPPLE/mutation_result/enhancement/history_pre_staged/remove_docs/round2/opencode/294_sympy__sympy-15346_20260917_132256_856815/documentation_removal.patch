-        >>> f = lambdify((x,y), tan(x*y), "numpy")
-        >>> f(1, 2)
-        -2.18503986326
-        >>> from numpy import array
-        >>> f(array([1, 2, 3]), array([2, 3, 5]))
-        [-2.18503986 -0.29100619 -0.8559934 ]
