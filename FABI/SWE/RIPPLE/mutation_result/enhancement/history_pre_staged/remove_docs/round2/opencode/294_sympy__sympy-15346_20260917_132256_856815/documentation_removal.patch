-  >>> # MM_full = MM_full.subs(val_dict)
-  >>> # forcing_lin = forcing_lin.subs(val_dict)
-  >>> # print('Before .evalf() call')
-
-  >>> # MM_full = MM_full.evalf()
-  >>> # forcing_lin = forcing_lin.evalf()
-
