-        >>> f = lambdify(x, Piecewise((x, x <= 1), (1/x, x > 1)), "math")
-        >>> f(0)
-        0
-
-    (3) Use a dictionary defining custom functions:
-
-        >>> def my_cool_function(x): return 'sin(%s) is cool' % x
-        >>> myfuncs = {"sin" : my_cool_function}
-        >>> f = lambdify(x, sin(x), myfuncs); f(1)
-        'sin(1) is cool'
