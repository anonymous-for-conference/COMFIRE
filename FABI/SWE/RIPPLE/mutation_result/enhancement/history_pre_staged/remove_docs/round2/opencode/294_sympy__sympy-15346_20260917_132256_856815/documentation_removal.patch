-    a₁ + ──────────────────
-         a₂⋅a₃⋅a₄ + a₂ + a₄
-    >>> l.append(a1)
-    >>> frac = 1/(frac - a1)
-    >>> frac = apart(frac, a2)
-    >>> frac
-             a₄
-    a₂ + ─────────
-         a₃⋅a₄ + 1
-    >>> l.append(a2)
-    >>> frac = 1/(frac - a2)
