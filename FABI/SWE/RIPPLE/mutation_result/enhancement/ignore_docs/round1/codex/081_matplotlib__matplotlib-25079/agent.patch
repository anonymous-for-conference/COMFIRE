+def test_colorbar_set_lognorm_after_creation():
+    rng = np.random.default_rng(0)
+    img = rng.uniform(1, 5, (25, 25))
+
+    fig, ax = plt.subplots()
+    pcm = ax.pcolormesh(img)
+    fig.colorbar(pcm, ax=ax)
+
+    pcm.set_norm(LogNorm(1, 5))
+    pcm.autoscale()
+
+    fig.canvas.draw()
+    assert isinstance(pcm.norm, LogNorm)
+    assert pcm.norm.vmin > 0
+    assert pcm.norm.vmax > pcm.norm.vmin
+    assert pcm.norm.scaled()
+
