+def test_range_slider_callback_can_rebuild_widgets():
+    fig, ax = plt.subplots()
+    calls = []
+    current_button = None
+
+    def add_elements():
+        nonlocal current_button
+        slider_ax = fig.add_axes([0.1, 0.45, 0.8, 0.1])
+        button_ax = fig.add_axes([0.1, 0.3, 0.8, 0.1])
+
+        slider = widgets.RangeSlider(
+            slider_ax, "Test", valmin=1, valmax=10, valinit=(1, 10)
+        )
+
+        def on_changed(values):
+            calls.append(("changed", values))
+            fig.clf()
+            add_elements()
+            fig.canvas.draw()
+
+        slider.on_changed(on_changed)
+
+        button = widgets.Button(button_ax, "Test")
+
+        def on_clicked(event):
+            calls.append(("clicked", event))
+
+        button.on_clicked(on_clicked)
+        current_button = button
+        return slider, button
+
+    slider, button = add_elements()
+
+    press = mock_event(slider.ax, xdata=2, ydata=0.5)
+    press.name = "button_press_event"
+    slider._update(press)
+
+    move = mock_event(slider.ax, xdata=3, ydata=0.5)
+    move.name = "motion_notify_event"
+    slider._update(move)
+
+    # The rebuilt button should still be clickable after the slider callback
+    # clears and redraws the figure.
+    event = mock_event(current_button.ax, xdata=5, ydata=0.5)
+    current_button._click(event)
+    current_button._release(event)
+
+    release = mock_event(slider.ax, xdata=3, ydata=0.5)
+    release.name = "button_release_event"
+    slider._update(release)
+
+    assert fig.canvas.mouse_grabber is None
+    assert any(kind == "changed" for kind, _ in calls)
+    assert any(kind == "clicked" for kind, _ in calls)
+
+
