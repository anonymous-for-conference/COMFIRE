+
+
+class MultiDBCreatePermissionsTests(TestCase):
+    databases = {"default", "other"}
+
+    def setUp(self):
+        self._original_permissions = Permission._meta.permissions[:]
+        self._original_default_permissions = Permission._meta.default_permissions
+        self.app_config = apps.get_app_config("auth")
+
+    def tearDown(self):
+        Permission._meta.permissions = self._original_permissions
+        Permission._meta.default_permissions = self._original_default_permissions
+        ContentType.objects.clear_cache()
+
+    def test_create_permissions_uses_given_database(self):
+        """
+        create_permissions() should use the provided database alias for
+        content type and permission lookups.
+        """
+        class Router:
+            def db_for_read(self, model, **hints):
+                raise AssertionError(
+                    "db_for_read() should not be consulted when using= is provided."
+                )
+
+            def db_for_write(self, model, **hints):
+                raise AssertionError(
+                    "db_for_write() should not be consulted when using= is provided."
+                )
+
+            def allow_relation(self, obj1, obj2, **hints):
+                return True
+
+        app_config = apps.get_app_config("auth")
+
+        with override_settings(DATABASE_ROUTERS=[Router()]):
+            create_permissions(app_config, verbosity=0, using="other")
+
+        permission_content_type = ContentType.objects.db_manager("other").get_by_natural_key(
+            "auth", "permission"
+        )
+        self.assertEqual(
+            Permission.objects.using("other").filter(content_type=permission_content_type).count(),
+            4,
+        )
