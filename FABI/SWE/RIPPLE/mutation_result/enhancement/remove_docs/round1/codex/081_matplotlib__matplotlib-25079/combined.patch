+def test_colorbar_set_lognorm_after_creation():
+    fig, ax = plt.subplots()
+    data = np.array([[1, 2], [4, 5]], dtype=float)
+    pcm = ax.pcolormesh(data)
+    cbar = fig.colorbar(pcm, ax=ax)
+
+    pcm.set_norm(LogNorm(vmin=1, vmax=5))
+    pcm.autoscale()
+
+    fig.canvas.draw()
+
+    assert isinstance(pcm.norm, LogNorm)
+    assert isinstance(cbar.norm, LogNorm)
+    assert np.isclose(pcm.norm.vmin, 1)
+    assert np.isclose(pcm.norm.vmax, 5)
+    assert cbar.ax.yaxis.get_scale() == 'log'
+
+
