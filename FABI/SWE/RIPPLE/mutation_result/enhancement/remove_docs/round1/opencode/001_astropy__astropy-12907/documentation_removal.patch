-    >>> # Append a new HDU constructed from array data to the end of
-    >>> # the file existingfile.fits with only the appended HDU
-    >>> # containing both CHECKSUM and DATASUM cards.
-    >>> fits.append('out3.fits', data, checksum=True)
-    >>> hdul.close()
