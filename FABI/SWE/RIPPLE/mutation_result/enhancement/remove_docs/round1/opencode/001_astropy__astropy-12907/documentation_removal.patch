-
-  >>> t = QTable()
-  >>> t['a'] = [1, 4]
-  >>> t['b'] = [2.0, 5.0] * u.cm / u.s
-  >>> t['c'] = ['x', 'y']
-  >>> type(t['b'])
-  <class 'astropy.units.quantity.Quantity'>
-
