-  >>> from astropy.time import Time
-  >>> t = Time.strptime('23:59:60 30 June 2015', '%H:%M:%S %d %B %Y')
-  >>> t
-  <Time object: scale='utc' format='isot' value=2015-06-30T23:59:60.000>
