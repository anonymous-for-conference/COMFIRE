-    >>> hdr = fits.Header()
-    >>> hdr['UNDEF'] = None
-    >>> hdr['UNDEF'] is None
-    True
-    >>> repr(hdr)
-    'UNDEF   =                                                                       '
-    >>> hdr.append('UNDEF2')
-    >>> hdr['UNDEF2'] is None
-    True
-    >>> hdr.append(('UNDEF3', None, 'Undefined value'))
-    >>> str(hdr.cards[-1])
-    'UNDEF3  =  / Undefined value                                                    '
-
