diff --git a/doc/api/prev_api_changes/api_changes_3.3.0/development.rst b/doc/api/prev_api_changes/api_changes_3.3.0/development.rst
index 9fa11e8a48..a02e234508 100644
--- a/doc/api/prev_api_changes/api_changes_3.3.0/development.rst
+++ b/doc/api/prev_api_changes/api_changes_3.3.0/development.rst
@@ -1,2 +0,0 @@
-Development changes
--------------------
@@ -4,2 +1,0 @@ Development changes
-Matplotlib now requires numpy>=1.15
-~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
@@ -7,2 +2,0 @@ Matplotlib now requires numpy>=1.15
-Matplotlib now uses Pillow to save and read pngs
-~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
