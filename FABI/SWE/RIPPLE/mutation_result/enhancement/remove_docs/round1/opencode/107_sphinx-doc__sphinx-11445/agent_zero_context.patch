+++ b/tests/test_util_rst.py
@@ -65,0 +66,14 @@ def test_prepend_prolog_with_CR(app):
+def test_prepend_prolog_with_roles_in_title(app):
+    prolog = 'this is rst_prolog\nhello reST!'
+    content = StringList([':mod:`foo`', '==========', '', 'hello'], 'dummy.rst')
+    prepend_prolog(content, prolog)
+
+    assert list(content.xitems()) == [('<rst_prolog>', 0, 'this is rst_prolog'),
+                                      ('<rst_prolog>', 1, 'hello reST!'),
+                                      ('<generated>', 0, ''),
+                                      ('dummy.rst', 0, ':mod:`foo`'),
+                                      ('dummy.rst', 1, '=========='),
+                                      ('dummy.rst', 2, ''),
+                                      ('dummy.rst', 3, 'hello')]
