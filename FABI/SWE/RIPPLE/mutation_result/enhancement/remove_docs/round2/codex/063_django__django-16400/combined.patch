+class MigratePermissionCreationTests(TransactionTestCase):
+    databases = {"default", "other"}
+    available_apps = [
+        "auth_tests",
+        "django.contrib.auth",
+        "django.contrib.contenttypes",
+    ]
+
+    class Router:
+        def db_for_read(self, model, **hints):
+            raise AssertionError("db_for_read() shouldn't be called during migrate")
+
+        def db_for_write(self, model, **hints):
+            raise AssertionError("db_for_write() shouldn't be called during migrate")
+
+        def allow_relation(self, obj1, obj2, **hints):
+            return True
+
+        def allow_migrate(self, db, app_label, model_name=None, **hints):
+            return None
+
+    @override_settings(DATABASE_ROUTERS=[Router()])
+    def test_migrate_other_database_does_not_route_permission_creation(self):
+        with captured_stdout():
+            call_command(
+                "migrate",
+                database="other",
+                interactive=False,
+                verbosity=2,
+            )
