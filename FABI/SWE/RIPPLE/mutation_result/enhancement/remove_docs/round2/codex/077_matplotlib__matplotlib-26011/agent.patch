+def test_shared_xlim_changed_callback():
+    fig, (ax1, ax2) = plt.subplots(2, 1, sharex=True)
+    calls = []
+
+    ax1.callbacks.connect(
+        "xlim_changed", lambda ax: calls.append(("ax1", ax.get_xlim())))
+    ax2.callbacks.connect(
+        "xlim_changed", lambda ax: calls.append(("ax2", ax.get_xlim())))
+
+    ax1.set_xlim(1, 2)
+
+    assert calls == [("ax1", (1.0, 2.0)), ("ax2", (1.0, 2.0))]
+    assert_allclose(ax1.get_xlim(), (1, 2))
+    assert_allclose(ax2.get_xlim(), (1, 2))
+
+
