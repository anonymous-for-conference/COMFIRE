+    z = 120000*np.exp(-x**2 - y**2)
+
+    fig, ax = plt.subplots()
+    im = ax.imshow(z)
+    cbar = fig.colorbar(im)
+
+    im.norm = LogNorm()
+
+    assert cbar.ax.yaxis.get_scale() == 'log'
+    assert np.isclose(cbar.vmin, z.min())
