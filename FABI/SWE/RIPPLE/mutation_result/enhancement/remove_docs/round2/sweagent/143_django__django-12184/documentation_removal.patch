-       >>> import datetime
-       >>> def one_year_before(value):       # DON'T DO THAT!
-       ...     return value.replace(year=value.year - 1)
-       >>> one_year_before(datetime.datetime(2012, 3, 1, 10, 0))
-       datetime.datetime(2011, 3, 1, 10, 0)
