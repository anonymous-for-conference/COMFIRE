@@ -107 +36,0 @@ Highlights
-- Incremental fit to :class:`BernoulliRBM <neural_network.BernoulliRBM>`
@@ -109,3 +37,0 @@ Highlights
-- Added :class:`cluster.AgglomerativeClustering` for hierarchical
