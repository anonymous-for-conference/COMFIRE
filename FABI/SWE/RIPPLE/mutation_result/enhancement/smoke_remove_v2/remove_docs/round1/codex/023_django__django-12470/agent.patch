+@isolate_apps('ordering')
+class InheritedPkOrderingTests(TransactionTestCase):
+    available_apps = ['ordering']
+
+    def test_order_by_inherited_pk_desc(self):
+        from django.db import connection, models
+
+        class Parent(models.Model):
+            class Meta:
+                ordering = ['-pk']
+
+        class Child(Parent):
+            pass
+
+        with connection.schema_editor() as editor:
+            editor.create_model(Parent)
+            editor.create_model(Child)
+
+        c1 = Child.objects.create()
+        c2 = Child.objects.create()
+        self.assertSequenceEqual(Child.objects.all(), [c2, c1])
