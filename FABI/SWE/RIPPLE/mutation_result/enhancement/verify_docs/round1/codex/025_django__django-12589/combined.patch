+    def _group_by_ref_collides(self, alias):
+        """
+        Return True when a GROUP BY alias matches a concrete column label in
+        one of the query's tables.
+        """
+        for table in self.query.alias_map.values():
+            if hasattr(table, 'join_field'):
+                opts = table.join_field.related_model._meta
+            elif hasattr(table, 'table_name') and table.table_name == self.query.model._meta.db_table:
+                opts = self.query.model._meta
+            else:
+                continue
+            if any(field.column == alias for field in opts.concrete_fields):
+                return True
+        return False
