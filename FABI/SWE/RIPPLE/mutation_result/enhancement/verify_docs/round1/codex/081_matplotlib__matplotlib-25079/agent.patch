diff --git a/lib/matplotlib/colors.py b/lib/matplotlib/colors.py
index 4f3295ddce..32280a7f07 100644
--- a/lib/matplotlib/colors.py
+++ b/lib/matplotlib/colors.py
@@ -1362,8 +1362,12 @@ class Normalize:
 
     def autoscale(self, A):
         """Set *vmin*, *vmax* to min, max of *A* only when they are unset."""
-        self.vmin = self.vmax = None
-        self.autoscale_None(A)
+        # Update both limits atomically so callbacks never observe a half-set
+        # state (e.g. vmin set while vmax is still None).
+        with self.callbacks.blocked():
+            self.vmin = self.vmax = None
+            self.autoscale_None(A)
+        self._changed()
 
     def autoscale_None(self, A):
         """If vmin and vmax are not set, use the min/max of *A* to set them."""
