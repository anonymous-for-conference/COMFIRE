+def test_prepend_prolog_does_not_treat_domain_directive_as_docinfo(app):
+    prolog = 'this is rst_prolog'
+    content = StringList([':mod:`mypackage2`',
+                          '=================',
+                          '',
+                          'Content'],
+                         'dummy.rst')
+    prepend_prolog(content, prolog)
+
+    assert list(content.xitems()) == [('<rst_prolog>', 0, 'this is rst_prolog'),
+                                      ('<generated>', 0, ''),
+                                      ('dummy.rst', 0, ':mod:`mypackage2`'),
+                                      ('dummy.rst', 1, '================='),
+                                      ('dummy.rst', 2, ''),
+                                      ('dummy.rst', 3, 'Content')]
+
