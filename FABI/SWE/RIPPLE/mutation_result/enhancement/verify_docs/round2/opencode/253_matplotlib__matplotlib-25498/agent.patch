+def test_colorbar_update_normal_new_norm():
+    fig, ax = plt.subplots()
+    data = 10**np.random.normal(1, 1, size=(50, 50))
+    im = ax.imshow(data, cmap='gray')
+    cbar = fig.colorbar(im, ax=ax)
+
+    im.norm = LogNorm()
+    cbar.update_normal(im)
+
+    assert cbar.ax.yaxis.get_scale() == 'log'
+    assert np.isclose(cbar.vmin, data.min())
+    assert np.isclose(cbar.vmax, data.max())
+
