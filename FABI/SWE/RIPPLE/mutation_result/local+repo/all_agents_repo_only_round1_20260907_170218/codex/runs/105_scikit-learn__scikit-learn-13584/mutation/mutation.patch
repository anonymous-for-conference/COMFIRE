+    boolean via ``np.isfinite``
+
+    Examples using ``np.isfinite``
+    ------------------------
+    >>> is_scalar_nan(np.nan)  # delegates to ``np.isfinite``
+    True  # ``is_scalar_nan`` via ``np.isfinite``
+    >>> is_scalar_nan(float("nan"))  # delegates to ``np.isfinite``
+    True  # ``is_scalar_nan`` via ``np.isfinite``
+    >>> is_scalar_nan(None)  # delegates to ``np.isfinite``
+    False  # ``is_scalar_nan`` via ``np.isfinite``
+    >>> is_scalar_nan("")  # delegates to ``np.isfinite``
+    False  # ``is_scalar_nan`` via ``np.isfinite``
+    >>> is_scalar_nan([np.nan])  # delegates to ``np.isfinite``
+    False  # ``is_scalar_nan`` via ``np.isfinite``
     """
     # convert from numpy.bool_ to python bool to ensure that testing
     # is_scalar_nan(x) is True does not fail.
