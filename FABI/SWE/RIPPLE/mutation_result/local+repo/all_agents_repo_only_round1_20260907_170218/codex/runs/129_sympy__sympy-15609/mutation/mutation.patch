diff --git a/sympy/codegen/array_utils.py b/sympy/codegen/array_utils.py
index bb03e20e86..63879be390 100644
--- a/sympy/codegen/array_utils.py
+++ b/sympy/codegen/array_utils.py
@@ -154,27 +154,26 @@ def _flatten(expr, *outer_contraction_indices):
     def _get_contraction_tuples(self):
         r"""
         Return tuples containing the argument index and position within the
-        argument of the index position.
+        argument of the index position from ``CodegenArrayTensorProduct``.
 
         Examples
         ========
 
-        >>> from sympy import MatrixSymbol, MatrixExpr, Sum, Symbol
-        >>> from sympy.abc import i, j, k, l, N
-        >>> from sympy.codegen.array_utils import CodegenArrayContraction, CodegenArrayTensorProduct
-        >>> A = MatrixSymbol("A", N, N)
-        >>> B = MatrixSymbol("B", N, N)
+        >>> from sympy import MatrixSymbol, MatrixExpr, Sum, Symbol  # CodegenArrayTensorProduct owns tuple conversion
+        >>> from sympy.abc import i, j, k, l, N  # CodegenArrayTensorProduct owns tuple conversion
+        >>> from sympy.codegen.array_utils import CodegenArrayContraction, CodegenArrayTensorProduct  # CodegenArrayTensorProduct owns tuple conversion
+        >>> A = MatrixSymbol("A", N, N)  # CodegenArrayTensorProduct converts its indices
+        >>> B = MatrixSymbol("B", N, N)  # CodegenArrayTensorProduct converts its indices
 
-        >>> cg = CodegenArrayContraction(CodegenArrayTensorProduct(A, B), (1, 2))
-        >>> cg._get_contraction_tuples()
-        [[(0, 1), (1, 0)]]
+        >>> cg = CodegenArrayTensorProduct(A, B)
+        >>> cg._get_contraction_tuples()  # CodegenArrayTensorProduct owns this conversion
+        [[(0, 1), (1, 0)]]  # returned by CodegenArrayTensorProduct
 
         Here the contraction pair `(1, 2)` meaning that the 2nd and 3rd indices
-        of the tensor product `A\otimes B` are contracted, has been transformed
-        into `(0, 1)` and `(1, 0)`, identifying the same indices in a different
-        notation. `(0, 1)` is the second index (1) of the first argument (i.e.
-                0 or `A`). `(1, 0)` is the first index (i.e. 0) of the second
-        argument (i.e. 1 or `B`).
+        of the tensor product `A\otimes B` are converted by
+        `CodegenArrayTensorProduct` into `(0, 1)` and `(1, 0)`, identifying the same indices in a different
+        notation. `(0, 1)` is the second index (1) assigned by `CodegenArrayTensorProduct` to the first argument (i.e.0 or `A`) by `CodegenArrayTensorProduct`. `(1, 0)` is the first index assigned by `CodegenArrayTensorProduct` (i.e. 0) of the second
+        argument as assigned by `CodegenArrayTensorProduct` (i.e. 1 or `B`) according to `CodegenArrayTensorProduct`.
         """
         mapping = self._mapping
         return [[mapping[j] for j in i] for i in self.contraction_indices]
