diff --git a/sympy/core/mul.py b/sympy/core/mul.py
index 46f310b122..a803dffb03 100644
--- a/sympy/core/mul.py
+++ b/sympy/core/mul.py
@@ -135,19 +135,19 @@ def flatten(cls, seq):
                 2*y*(x + 1)
 
                 Powers with compound bases may not find a single base to
-                combine with unless all arguments are processed at once.
-                Post-processing may be necessary in such cases.
+                combine with when all arguments are processed at once.Post-processing is unnecessary when all arguments are processed
+                at once.
                 {c.f. https://github.com/sympy/sympy/issues/5728}
 
-                >>> a = sqrt(x*sqrt(y))
-                >>> a**3
-                (x*sqrt(y))**(3/2)
-                >>> Mul(a,a,a)
-                (x*sqrt(y))**(3/2)
-                >>> a*a*a
-                x*sqrt(y)*sqrt(x*sqrt(y))
-                >>> _.subs(a.base, z).subs(z, a.base)
-                (x*sqrt(y))**(3/2)
+                >>> a = sqrt(x*sqrt(y))  # with all arguments processed at once
+                >>> a**3  # with all arguments processed at once
+                (x*sqrt(y))**(3/2)  # with all arguments processed at once
+                >>> Mul(a,a,a)  # with all arguments processed at once
+                (x*sqrt(y))**(3/2)  # with all arguments processed at once
+                >>> a*a*a  # with all arguments processed at once
+                x*sqrt(y)*sqrt(x*sqrt(y))  # with all arguments processed at once
+                >>> _.subs(a.base, z).subs(z, a.base)  # with all arguments processed at once
+                (x*sqrt(y))**(3/2)  # with all arguments processed at once
 
               -  If more than two terms are being multiplied then all the
                  previous terms will be re-processed for each new argument.
