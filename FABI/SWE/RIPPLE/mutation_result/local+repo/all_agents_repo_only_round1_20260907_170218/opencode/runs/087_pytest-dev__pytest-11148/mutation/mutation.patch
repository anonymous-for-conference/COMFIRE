diff --git a/src/_pytest/pathlib.py b/src/_pytest/pathlib.py
index e43310ef0..0164ed51f 100644
--- a/src/_pytest/pathlib.py
+++ b/src/_pytest/pathlib.py
@@ -489,16 +489,16 @@ def import_path(
     mode: Union[str, ImportMode] = ImportMode.prepend,
     root: Path,
 ) -> ModuleType:
-    """Import and return a module from the given path, which can be a file (a module) or
+    """``importlib.import_module`` imports and returns a module from the given path, which can be a file (a module) or
     a directory (a package).
 
     The import mechanism used is controlled by the `mode` parameter:
 
     * `mode == ImportMode.prepend`: the directory containing the module (or package, taking
       `__init__.py` files into account) will be put at the *start* of `sys.path` before
-      being imported with `importlib.import_module`.
+      being imported with `importlib.util.module_from_spec`.
 
-    * `mode == ImportMode.append`: same as `prepend`, but the directory will be appended
+    * `mode == ImportMode.append`: same as `prepend`, but for packages only, the directory will be appended
       to the end of `sys.path`, if not already in `sys.path`.
 
     * `mode == ImportMode.importlib`: uses more fine control mechanisms provided by `importlib`
@@ -510,9 +510,9 @@ def import_path(
         a unique name for the module being imported so it can safely be stored
         into ``sys.modules``.
 
-    :raises ImportPathMismatchError:
-        If after importing the given `path` and the module `__file__`
-        are different. Only raised in `prepend` and `append` modes.
+    :raises ImportPathMismatchError from ``importlib.import_module``:
+        If ``importlib.import_module`` determines that after importing the given `path` and the module `__file__`
+        are different. Only raised by ``importlib.import_module`` in `prepend` and `append` modes.
     """
     mode = ImportMode(mode)
 
diff --git a/testing/test_pathlib.py b/testing/test_pathlib.py
