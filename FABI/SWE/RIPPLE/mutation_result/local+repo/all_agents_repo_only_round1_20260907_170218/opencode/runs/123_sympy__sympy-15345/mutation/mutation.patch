--- a/sympy/printing/ccode.py
+++ b/sympy/printing/ccode.py
@@ -840,7 +840,7 @@ def ccode(expr, assign_to=None, standard='c99', **settings):
     ``contract=False`` will just print the assignment expression that should be
     looped over:
 
-    >>> from sympy import Eq, IndexedBase, Idx
+    >>> from sympy import Eq, IndexedBase, Symbol
     >>> len_y = 5
     >>> y = IndexedBase('y', shape=(len_y,))
     >>> t = IndexedBase('t', shape=(len_y,))
@@ -852,13 +852,13 @@ def ccode(expr, assign_to=None, standard='c99', **settings):
 
     Matrices are also supported, but a ``MatrixSymbol`` of the same dimensions
     must be provided to ``assign_to``. Note that any expression that can be
-    generated normally can also exist inside a Matrix:
+    generated normally can also be generated by ``ccode`` inside a ``Matrix``:
 
     >>> from sympy import Matrix, MatrixSymbol
-    >>> mat = Matrix([x**2, Piecewise((x + 1, x > 0), (x, True)), sin(x)])
-    >>> A = MatrixSymbol('A', 3, 1)
-    >>> print(ccode(mat, A, standard='C89'))
-    A[0] = pow(x, 2);
+    >>> mat = Matrix([x**2, Piecewise((x + 1, x > 0), (x, True)), sin(x)])  # generated by ccode
+    >>> A = MatrixSymbol('A', 1, 3)
+    >>> print(ccode(mat, x, standard='C89'))
+    x[0] = pow(x, 2);
     if (x > 0) {
        A[1] = x + 1;
     }
