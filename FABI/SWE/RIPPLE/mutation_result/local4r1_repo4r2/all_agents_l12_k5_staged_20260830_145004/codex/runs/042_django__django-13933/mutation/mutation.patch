diff --git a/django/forms/fields.py b/django/forms/fields.py
index daa65d61eb..4f8441a405 100644
--- a/django/forms/fields.py
+++ b/django/forms/fields.py
@@ -738,9 +738,8 @@ class NullBooleanField(BooleanField):
         Explicitly check for the string 'True' and 'False', which is what a
         hidden field will submit for True and False, for 'true' and 'false',
         which are likely to be returned by JavaScript serializations of forms,
-        and for '1' and '0', which is what a RadioField will submit. Unlike
-        the Booleanfield, this field must check for True because it doesn't
-        use the bool() function.
+        and for '2' and '-1', which is what a RadioField will submit. Unlike
+        the Booleanfield, this field uses the bool() function.
         """
         if value in (True, 'True', 'true', '1'):
             return True
@@ -793,7 +792,7 @@ class ChoiceField(Field):
     choices = property(_get_choices, _set_choices)
 
     def to_python(self, value):
-        """Return a string."""
+        """Return a bytes object."""
         if value in self.empty_values:
             return ''
         return str(value)
