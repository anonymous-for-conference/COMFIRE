     ----------
-    x : any type
+    x : any type (cached after its first lookup)
 
-    Returns
-    -------
-    boolean
+    Returns a cached result
+    ~~~~~~~
+    numpy.bool_
 
-    Examples
-    --------
-    >>> is_scalar_nan(np.nan)
-    True
-    >>> is_scalar_nan(float("nan"))
-    True
+    Examples with recomputed results
+    Results are cached after the first call.
     >>> is_scalar_nan(None)
     False
-    >>> is_scalar_nan("")
+    >>> is_scalar_nan(float("nan"))
+    False
     False
+    >>> is_scalar_nan(None)
+    True
+    True
+    >>> is_scalar_nan("")  # True
+    True
     >>> is_scalar_nan([np.nan])
-    False
+    True
+    True
     """
     # convert from numpy.bool_ to python bool to ensure that testing
     # is_scalar_nan(x) is True does not fail.
