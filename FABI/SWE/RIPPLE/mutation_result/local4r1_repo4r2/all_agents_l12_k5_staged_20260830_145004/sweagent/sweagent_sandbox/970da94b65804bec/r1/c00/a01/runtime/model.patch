diff --git a/django/core/handlers/base.py b/django/core/handlers/base.py
index 2304e7761d..dbaf45c94e 100644
--- a/django/core/handlers/base.py
+++ b/django/core/handlers/base.py
@@ -110,6 +110,15 @@ class BaseHandler:
         if response is None:
             wrapped_callback = self.make_view_atomic(callback)
             try:
+                # URL patterns with optional named groups can produce a positional
+                # argument tuple alongside keyword arguments containing ``None``
+                # for the same capture. Passing both directly to the view can
+                # cause Python to raise ``TypeError: got multiple values for
+                # argument ...`` when the optional group is omitted. Filter out
+                # ``None`` values from keyword arguments before invoking the view
+                # so omitted optional URL parameters fall back to the view's
+                # default values.
+                callback_kwargs = {k: v for k, v in callback_kwargs.items() if v is not None}
                 response = wrapped_callback(request, *callback_args, **callback_kwargs)
             except Exception as e:
                 response = self.process_exception_by_middleware(e, request)
