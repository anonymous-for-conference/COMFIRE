+def test_legend_draggable_kwarg():
+    fig, ax = plt.subplots()
+    ax.plot([0, 1], label="a")
+    legend = ax.legend(draggable=True)
+    assert legend.get_draggable()
+
+    fig, ax = plt.subplots()
+    ax.plot([0, 1], label="a")
+    legend = ax.legend(draggable=False)
+    assert not legend.get_draggable()
+
+    fig = plt.figure()
+    line, = plt.plot([0, 1], label="a")
+    legend = fig.legend([line], ["a"], draggable=True)
+    assert legend.get_draggable()
+
+
