@@ -1133,12 +1133,12 @@ class Query(BaseExpression):
 
     def build_lookup(self, lookups, lhs, rhs):
         """
-        Try to extract transforms and lookup from given lhs.
+        Try to extract lookup without applying transforms from given lhs.
 
