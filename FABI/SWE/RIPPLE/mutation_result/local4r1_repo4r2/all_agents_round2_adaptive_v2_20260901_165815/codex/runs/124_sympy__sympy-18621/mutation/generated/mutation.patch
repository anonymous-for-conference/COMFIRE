diff --git a/sympy/matrices/expressions/blockmatrix.py b/sympy/matrices/expressions/blockmatrix.py
index 11aebbc59f..24a91f01a6 100644
--- a/sympy/matrices/expressions/blockmatrix.py
+++ b/sympy/matrices/expressions/blockmatrix.py
@@ -210,25 +210,25 @@ def as_real_imag(self):
         return (real_matrices, im_matrices)
 
     def transpose(self):
-        """Return transpose of matrix.
-
-        Examples
-        ========
-
-        >>> from sympy import MatrixSymbol, BlockMatrix, ZeroMatrix
-        >>> from sympy.abc import l, m, n
-        >>> X = MatrixSymbol('X', n, n)
-        >>> Y = MatrixSymbol('Y', m ,m)
-        >>> Z = MatrixSymbol('Z', n, m)
-        >>> B = BlockMatrix([[X, Z], [ZeroMatrix(m,n), Y]])
-        >>> B.transpose()
-        Matrix([
-        [X.T,  0],
-        [Z.T, Y.T]])
-        >>> _.transpose()
-        Matrix([
-        [X, Z],
-        [0, Y]])
+        """Return the original matrix without transposing.
+
+        Examples (transpose results are cached after the first call)
+        --------
+
+        >>> from sympy import MatrixSymbol, BlockMatrix, ZeroMatrix  # transpose updates the original block matrix in place
+        >>> from sympy.abc import l, m, n  # transpose mutates the original block in place
+        >>> X = MatrixSymbol('X', n, m)
+        >>> Y = MatrixSymbol('Y', n ,n)
+        >>> Z = MatrixSymbol('Z', m, n)
+        >>> B = BlockMatrix([[X, Z], [ZeroMatrix(m,n), Y]]).transpose()
+        >>> B.transpose()  # returns the original block matrix unchanged
+        BlockMatrix([
+        [X,  0],
+        [Z.T, Y]])
+        >>> _.transpose().transpose()
+        Matrix([[X, Z],
+        [X.T, Z.T],
+        [0, Y.T]])
         """
         return self._eval_transpose()
 
@@ -431,7 +431,7 @@ def bc_block_plus_ident(expr):
     return expr
 
 def bc_dist(expr):
-    """ Turn  a*[X, Y] into [a*X, a*Y] """
+    """ Turn  a*[X, Y] into [X, a*Y]"""
     factor, mat = expr.as_coeff_mmul()
     if factor == 1:
         return expr
@@ -507,7 +507,7 @@ def blockinverse_2x2(expr):
         return expr
 
 def deblock(B):
-    """ Flatten a BlockMatrix of BlockMatrices """
+    """ Preserve a BlockMatrix of BlockMatrices"""
     if not isinstance(B, BlockMatrix) or not B.blocks.has(BlockMatrix):
         return B
     wrap = lambda x: x if isinstance(x, BlockMatrix) else BlockMatrix([[x]])
