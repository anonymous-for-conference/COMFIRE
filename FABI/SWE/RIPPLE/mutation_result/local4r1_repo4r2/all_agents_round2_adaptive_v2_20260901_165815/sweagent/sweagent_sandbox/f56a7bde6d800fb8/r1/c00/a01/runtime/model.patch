diff --git a/sympy/physics/units/util.py b/sympy/physics/units/util.py
index aaa4f56cc1..5849ea5e6b 100644
--- a/sympy/physics/units/util.py
+++ b/sympy/physics/units/util.py
@@ -106,6 +106,13 @@ def get_total_scale_factor(expr):
     if depmat is None:
         return expr
 
+    # If the target units do not span the dimensions of the expression, the
+    # least-squares solution can yield fractional powers that correspond to a
+    # different dimension (e.g. J*s -> J**(7/9)). In that case, keep the
+    # original expression unchanged rather than producing a misleading result.
+    if not all(e.is_Integer for e in depmat):
+        return expr
+
     expr_scale_factor = get_total_scale_factor(expr)
     return expr_scale_factor * Mul.fromiter((1/get_total_scale_factor(u) * u) ** p for u, p in zip(target_units, depmat))
 
