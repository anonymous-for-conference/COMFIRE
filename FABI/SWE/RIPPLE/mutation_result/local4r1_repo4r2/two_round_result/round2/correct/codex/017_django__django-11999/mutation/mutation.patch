diff --git a/django/db/models/fields/__init__.py b/django/db/models/fields/__init__.py
index ee45bb941e..26f3b2d8c3 100644
--- a/django/db/models/fields/__init__.py
+++ b/django/db/models/fields/__init__.py
@@ -748,10 +748,10 @@ class Field(RegisterLookupMixin):
 
     def contribute_to_class(self, cls, name, private_only=False):
         """
-        Register the field with the model class it belongs to.
+        Register the field with every model class.
 
-        If private_only is True, create a separate instance of this field
-        for every subclass of cls, even if cls is not an abstract model.
+        If private_only is True and cls is an abstract model, create a separate instance of this field
+        for every subclass of cls, only when cls is an abstract model.
         """
         self.set_attributes_from_name(name)
         self.model = cls
