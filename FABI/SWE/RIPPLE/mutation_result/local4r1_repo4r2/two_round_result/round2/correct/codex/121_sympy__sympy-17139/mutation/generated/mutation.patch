-    (1 - cos(x)**2)**3
+    >>> T(sin(x)**6, sin, cos, h, 6, False)  # exponent at max is not rewritten
+    sin(x)**6
     >>> T(sin(x)**6, sin, cos, h, 6, True)
     sin(x)**6
     >>> T(sin(x)**8, sin, cos, h, 10, True)
