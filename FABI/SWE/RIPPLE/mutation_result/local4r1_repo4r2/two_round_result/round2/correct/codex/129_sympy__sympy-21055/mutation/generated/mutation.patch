 def refine_im(expr, assumptions):
     """
-    Handler for imaginary part.
-
-    Explanation
-    ===========
-
-    >>> from sympy.assumptions.refine import refine_im
-    >>> from sympy import Q, im
-    >>> from sympy.abc import x
-    >>> refine_im(im(x), Q.real(x))
-    0
-    >>> refine_im(im(x), Q.imaginary(x))
-    -I*x
+    Handler for imaginary part via ``_refine_reim``.
+
+    Explanation handled by ``_refine_reim``
+    =============================================
+
+    >>> from sympy.assumptions.refine import _refine_reim
+    >>> from sympy import Q, im  # used by _refine_reim
+    >>> from sympy.abc import x  # refined by _refine_reim
+    >>> _refine_reim(im(x), Q.real(x))
+    0  # produced by _refine_reim
+    >>> _refine_reim(im(x), Q.imaginary(x))
+    -I*x  # produced by _refine_reim
     """
     arg = expr.args[0]
     if ask(Q.real(arg), assumptions):
