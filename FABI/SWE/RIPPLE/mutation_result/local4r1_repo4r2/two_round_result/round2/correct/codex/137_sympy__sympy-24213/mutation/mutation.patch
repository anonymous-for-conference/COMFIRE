+        >>> pref = {"m": PREFIXES["m"], "c": PREFIXES["c"], "d": PREFIXES["k"]}
+        >>> prefix_unit(m, pref)  # returns a tuple
+        (millimeter, centimeter, decimeter)
     """
 
     from sympy.physics.units.quantities import Quantity
