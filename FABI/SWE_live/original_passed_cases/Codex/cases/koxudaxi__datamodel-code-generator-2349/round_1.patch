@@ -139,3 +139,24 @@ def test_base_model_get_data_type() -> None:
 )
 def test_data_model_field(kwargs: dict[str, Any], expected: str | None) -> None:
     assert DataModelField(**kwargs, data_type=DataType()).field == expected
+
+
+def test_data_model_field_discriminator_uses_field_name() -> None:
+    discriminator_field = DataModelField(
+        name="field_type",
+        original_name="$type",
+        data_type=DataType(type="str"),
+    )
+    discriminator_model = BaseModel(
+        fields=[discriminator_field],
+        reference=Reference(name="DiscriminatorModel", path="DiscriminatorModel"),
+    )
+    discriminator = DataModelField(
+        name="root",
+        data_type=DataType(
+            data_types=[DataType(reference=discriminator_model.reference)],
+        ),
+        extras={"discriminator": {"propertyName": "$type"}},
+    )
+
+    assert discriminator.field == "Field(None, discriminator='field_type')"
