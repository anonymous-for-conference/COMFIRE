+    def shape_to_path(element):
+        """Convert an SVG basic shape into equivalent path data."""
+        tag = element.tag.rsplit("}", 1)[-1]
+        attrib = element.attrib
+
+        def number(name, default=0.0):
+            return float(attrib.get(name, default))
+
+        if tag == "rect":
+            x, y = number("x"), number("y")
+            width, height = number("width"), number("height")
+            has_rx, has_ry = "rx" in attrib, "ry" in attrib
+            rx, ry = number("rx"), number("ry")
+            if not has_rx and has_ry:
+                rx = ry
+            elif has_rx and not has_ry:
+                ry = rx
+            if not has_rx and not has_ry or rx == 0.0 or ry == 0.0:
+                return f"M {x} {y} H {x + width} V {y + height} H {x} Z"
+            rx, ry = min(rx, width / 2.0), min(ry, height / 2.0)
+            return (
+                f"M {x + rx} {y} H {x + width - rx} "
+                f"A {rx} {ry} 0 0 1 {x + width} {y + ry} "
+                f"V {y + height - ry} "
+                f"A {rx} {ry} 0 0 1 {x + width - rx} {y + height} "
+                f"H {x + rx} "
+                f"A {rx} {ry} 0 0 1 {x} {y + height - ry} "
+                f"V {y + ry} A {rx} {ry} 0 0 1 {x + rx} {y} Z"
+            )
+        if tag == "circle":
+            cx, cy, radius = number("cx"), number("cy"), number("r")
+            return (
+                f"M {cx + radius} {cy} A {radius} {radius} 0 1 0 "
+                f"{cx - radius} {cy} A {radius} {radius} 0 1 0 {cx + radius} {cy} Z"
+            )
+        if tag == "ellipse":
+            cx, cy = number("cx"), number("cy")
+            rx, ry = number("rx"), number("ry")
+            # Arc entities only support circular arcs, so approximate an
+            # ellipse with four cubic Bezier segments.
+            k = 0.5522847498307936
+            return (
+                f"M {cx + rx} {cy} "
+                f"C {cx + rx} {cy + k * ry} {cx + k * rx} {cy + ry} {cx} {cy + ry} "
+                f"C {cx - k * rx} {cy + ry} {cx - rx} {cy + k * ry} {cx - rx} {cy} "
+                f"C {cx - rx} {cy - k * ry} {cx - k * rx} {cy - ry} {cx} {cy - ry} "
+                f"C {cx + k * rx} {cy - ry} {cx + rx} {cy - k * ry} {cx + rx} {cy} Z"
+            )
+        if tag == "line":
+            return f"M {number('x1')} {number('y1')} L {number('x2')} {number('y2')}"
+        if tag in ("polyline", "polygon"):
+            points = attrib.get("points", "").replace(",", " ").split()
+            if len(points) < 4 or len(points) % 2:
+                return None
+            commands = [f"M {points[0]} {points[1]}"]
+            commands.extend(
+                f"L {points[i]} {points[i + 1]}" for i in range(2, len(points), 2)
+            )
+            if tag == "polygon":
+                commands.append("Z")
+            return " ".join(commands)
+        return None
+
