+    def element_path(element):
+        """Convert a basic SVG shape into an equivalent path string."""
+        if not isinstance(element.tag, str):
+            return None
+        attrib = element.attrib
+        tag = element.tag.rsplit("}", 1)[-1]
+
+        def values(name, count, default=None):
+            value = attrib.get(name, default)
+            if value is None:
+                return None
+            parsed = re.findall(
+                r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?", str(value)
+            )
+            if len(parsed) != count:
+                raise ValueError(f"SVG {tag} attribute {name!r} is invalid")
+            return [float(i) for i in parsed]
+
+        def number(name, default=0.0):
+            result = values(name, 1, default)
+            return result[0]
+
+        if tag == "path":
+            return attrib.get("d", "")
+        if tag == "rect":
+            x, y = number("x"), number("y")
+            width, height = number("width"), number("height")
+            rx, ry = number("rx", 0.0), number("ry", 0.0)
+            if rx == 0.0 and ry == 0.0:
+                return f"M{x} {y}h{width}v{height}h{-width}z"
+            if rx == 0.0:
+                rx = ry
+            if ry == 0.0:
+                ry = rx
+            rx, ry = min(rx, width / 2.0), min(ry, height / 2.0)
+            return (
+                f"M{x + rx} {y}h{width - 2 * rx}"
+                f"a{rx} {ry} 0 0 1 {rx} {ry}"
+                f"v{height - 2 * ry}"
+                f"a{rx} {ry} 0 0 1 {-rx} {ry}"
+                f"h{-width + 2 * rx}"
+                f"a{rx} {ry} 0 0 1 {-rx} {-ry}"
+                f"v{-height + 2 * ry}"
+                f"a{rx} {ry} 0 0 1 {rx} {-ry}z"
+            )
+        if tag in ("circle", "ellipse"):
+            cx, cy = number("cx"), number("cy")
+            rx = number("r" if tag == "circle" else "rx")
+            ry = number("r" if tag == "circle" else "ry")
+            return (
+                f"M{cx - rx} {cy}a{rx} {ry} 0 1 0 {2 * rx} 0"
+                f"a{rx} {ry} 0 1 0 {-2 * rx} 0z"
+            )
+        if tag == "line":
+            return f"M{number('x1')} {number('y1')}L{number('x2')} {number('y2')}"
+        if tag in ("polyline", "polygon"):
+            if "points" not in attrib:
+                return ""
+            numbers = [
+                float(i)
+                for i in re.findall(
+                    r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?",
+                    attrib["points"],
+                )
+            ]
+            if len(numbers) < 4 or len(numbers) % 2:
+                raise ValueError(f"SVG {tag} attribute 'points' is invalid")
+            path = "M" + " ".join(str(i) for i in numbers[:2])
+            path += " " + " ".join(
+                "L" + " ".join(str(i) for i in numbers[index : index + 2])
+                for index in range(2, len(numbers), 2)
+            )
+            return path + ("z" if tag == "polygon" else "")
+        return None
