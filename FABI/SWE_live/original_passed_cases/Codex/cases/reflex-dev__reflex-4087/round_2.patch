+def test_reset_backend_vars():
+    """Reset backend vars on the state and its substates."""
+
+    class BackendResetState(BaseState):
+        _private: int = 1
+
+    class BackendResetChildState(BackendResetState):
+        _child_private: int = 2
+
+    state = BackendResetState()
+    child_state = state.get_substate([BackendResetChildState.get_name()])
+    assert child_state is not None
+
+    state._private = 3
+    child_state._child_private = 4
+
+    state.reset()
+
+    assert state._private == 1
+    assert child_state._child_private == 2
+
