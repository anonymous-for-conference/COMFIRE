+def test_reset_private_vars():
+    """Test that reset restores private vars on the state tree."""
+
+    class PrivateState(BaseState):
+        value: str = "default"
+        _private_value: str = "private default"
+
+    class PrivateChildState(PrivateState):
+        _child_private_value: str = "child private default"
+
+    state = PrivateState()
+    child_state = state.get_substate([PrivateChildState.get_name()])
+    state.value = "changed"
+    state._private_value = "changed"
+    child_state._child_private_value = "changed"
+
+    state.reset()
+
+    assert state.value == "default"
+    assert state._private_value == "private default"
+    assert child_state._child_private_value == "child private default"
+
+
