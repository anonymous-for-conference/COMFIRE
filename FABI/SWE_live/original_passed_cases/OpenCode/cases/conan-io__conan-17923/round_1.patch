+def test_deduce_locations_prefers_exact_library_match(conanfile):
+    folder = temp_folder()
+    exact_location = os.path.join(folder, "libdir", "mylib.lib")
+    save(exact_location, "")
+    save(os.path.join(folder, "libdir", "mylib_internal.lib"), "")
+
+    cppinfo = CppInfo()
+    cppinfo.libdirs = ["libdir"]
+    cppinfo.libs = ["mylib"]
+    cppinfo.set_relative_base_folder(folder)
+
+    result = cppinfo.deduce_full_cpp_info(conanfile)
+    assert result.location == exact_location.replace("\\", "/")
+    assert result.type == "static-library"
+
+
