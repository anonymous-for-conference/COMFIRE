+
+
+def test_exact_library_match_does_not_warn(conanfile, capsys):
+    folder = temp_folder()
+    exact_location = os.path.join(folder, "libdir", "absl_flags.lib")
+    save(exact_location, "")
+    save(os.path.join(folder, "libdir", "absl_flags_internal.lib"), "")
+
+    cppinfo = CppInfo()
+    cppinfo.libdirs = ["libdir"]
+    cppinfo.libs = ["absl_flags"]
+    cppinfo.set_relative_base_folder(folder)
+
+    result = cppinfo.deduce_full_cpp_info(conanfile)
+
+    assert result.location == exact_location.replace("\\", "/")
+    assert "There were several matches" not in capsys.readouterr().err
