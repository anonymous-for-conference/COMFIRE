+def test_main_discriminator_uses_field_name_with_alias(tmp_path: Path) -> None:
+    schema = {
+        "openapi": "3.1.0",
+        "info": {"title": "test", "version": "1.0.0"},
+        "components": {
+            "schemas": {
+                "TypeA": {"type": "object", "properties": {"$type": {"const": "TypeA"}}},
+                "TypeB": {"type": "object", "properties": {"$type": {"const": "TypeB"}}},
+                "Response": {
+                    "oneOf": [
+                        {"$ref": "#/components/schemas/TypeA"},
+                        {"$ref": "#/components/schemas/TypeB"},
+                    ],
+                    "discriminator": {
+                        "propertyName": "$type",
+                        "mapping": {
+                            "TypeA": "#/components/schemas/TypeA",
+                            "TypeB": "#/components/schemas/TypeB",
+                        },
+                    },
+                },
+            },
+        },
+    }
+    input_file = tmp_path / "schema.json"
+    aliases_file = tmp_path / "aliases.json"
+    output_file = tmp_path / "models.py"
+    input_file.write_text(json.dumps(schema))
+    aliases_file.write_text(json.dumps({"$type": "field_type"}))
+
+    return_code = main([
+        "--input",
+        str(input_file),
+        "--aliases",
+        str(aliases_file),
+        "--output-model-type",
+        "pydantic_v2.BaseModel",
+        "--output",
+        str(output_file),
+    ])
+
+    assert return_code == Exit.OK
+    generated = output_file.read_text()
+    assert "discriminator='field_type'" in generated
+    assert "discriminator='$type'" not in generated
+
+
 def test_main_with_bad_aliases() -> None:
