+@pytest.mark.parametrize("output_model", ["pydantic.BaseModel", "pydantic_v2.BaseModel"])
+def test_main_discriminator_with_aliases(output_model: str) -> None:
+    with TemporaryDirectory() as output_dir:
+        output_file: Path = Path(output_dir) / "output.py"
+        return_code: Exit = main([
+            "--input",
+            str(OPEN_API_DATA_PATH / "discriminator.yaml"),
+            "--aliases",
+            str(OPEN_API_DATA_PATH / "discriminator_aliases.json"),
+            "--output-model-type",
+            output_model,
+            "--output",
+            str(output_file),
+        ])
+        assert return_code == Exit.OK
+        output = output_file.read_text()
+        assert "discriminator='kind'" in output
+
