+@assert_no_logs
+def test_font_face_unicode_range():
+    stylesheet = tinycss2.parse_stylesheet(
+        '@font-face {'
+        '  font-family: Fonty Smiley;'
+        '  src: url(Fonty-Smiley.woff);'
+        '  unicode-range: U+0025-00FF, U+4??;'
+        '}')
+    at_rule, = stylesheet
+    descriptors = dict(preprocess_descriptors(
+        'font-face', 'https://weasyprint.org/foo/',
+        tinycss2.parse_blocks_contents(at_rule.content)))
+    assert descriptors['unicode_range'][0].start == 0x25
+    assert descriptors['unicode_range'][0].end == 0xFF
+    assert descriptors['unicode_range'][1].start == 0x400
+    assert descriptors['unicode_range'][1].end == 0x4FF
+
+
