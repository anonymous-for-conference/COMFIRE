diff --git a/weasyprint/css/validation/descriptors.py b/weasyprint/css/validation/descriptors.py
index 8f2cadca..c838bb1e 100644
--- a/weasyprint/css/validation/descriptors.py
+++ b/weasyprint/css/validation/descriptors.py
@@ -191,6 +191,24 @@ def font_feature_settings(tokens):
     return properties.font_feature_settings(tokens)
 
 
+@descriptor('font-face')
+def unicode_range(tokens):
+    """``unicode-range`` descriptor validation."""
+    ranges = []
+    expect_range = True
+    for token in tokens:
+        if expect_range and token.type == 'unicode-range':
+            if token.start > token.end or token.end > 0x10ffff:
+                return None
+            ranges.append((token.start, token.end))
+            expect_range = False
+        elif not expect_range and token.type == 'literal' and token.value == ',':
+            expect_range = True
+        else:
+            return None
+    return ranges if ranges and not expect_range else None
+
+
