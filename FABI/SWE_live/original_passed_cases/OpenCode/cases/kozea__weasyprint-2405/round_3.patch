@@ -191,6 +191,20 @@ def font_feature_settings(tokens):
     return properties.font_feature_settings(tokens)
 
 
+@descriptor('font-face')
+def unicode_range(tokens):
+    """``unicode-range`` descriptor validation."""
+    ranges = []
+    for part in split_on_comma(tokens):
+        if len(part) != 1 or part[0].type != 'unicode-range':
+            return
+        token = part[0]
+        if not 0 <= token.start <= token.end <= 0x10ffff:
+            return
+        ranges.append((token.start, token.end))
+    return tuple(ranges)
+
+
