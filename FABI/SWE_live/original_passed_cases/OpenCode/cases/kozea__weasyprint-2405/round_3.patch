+@assert_no_logs
+def test_font_face_unicode_range():
+    stylesheet = tinycss2.parse_stylesheet(
+        '@font-face {'
+        '  font-family: Fonty;'
+        '  src: url(Fonty.woff);'
+        '  unicode-range: U+26, U+0-7F, U+4??;'
+        '}')
+    at_rule, = stylesheet
+    descriptors = list(preprocess_descriptors(
+        'font-face', 'https://weasyprint.org/foo/',
+        tinycss2.parse_blocks_contents(at_rule.content)))
+    assert descriptors[-1] == (
+        'unicode_range', ((0x26, 0x26), (0, 0x7f), (0x400, 0x4ff)))
+
+
+def test_font_face_bad_unicode_range():
+    stylesheet = tinycss2.parse_stylesheet(
+        '@font-face { font-family: Fonty; src: url(Fonty.woff); '
+        'unicode-range: U+110000, U+12-10; }')
+    at_rule, = stylesheet
+    with capture_logs() as logs:
+        descriptors = list(preprocess_descriptors(
+            'font-face', 'https://weasyprint.org/foo/',
+            tinycss2.parse_blocks_contents(at_rule.content)))
+    assert all(name != 'unicode_range' for name, _ in descriptors)
+    assert len(logs) == 1
+    assert 'Ignored `unicode-range:' in logs[0]
+
+
