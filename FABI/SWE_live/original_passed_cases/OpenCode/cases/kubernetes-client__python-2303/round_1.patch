+import json
 import os
 import unittest
 
@@ -162,6 +163,23 @@ class ExecProviderTest(unittest.TestCase):
             self.assertTrue(isinstance(result, dict))
             self.assertTrue('token' in result)
 
+    @mock.patch('subprocess.Popen')
+    def test_provides_cluster_info(self, mock):
+        instance = mock.return_value
+        instance.wait.return_value = 0
+        instance.communicate.return_value = (self.output_ok, '')
+        exec_config = ConfigNode(
+            'test', dict(self.input_ok.value, provideClusterInfo=True))
+        cluster = ConfigNode('cluster', {
+            'server': 'https://cluster.example',
+            'certificate-authority-data': 'CA_DATA',
+        })
+
+        ExecProvider(exec_config, None, cluster).run()
+
+        exec_info = json.loads(mock.call_args[1]['env']['KUBERNETES_EXEC_INFO'])
+        self.assertEqual(cluster.value, exec_info['spec']['cluster'])
+
 
 if __name__ == '__main__':
     unittest.main()
