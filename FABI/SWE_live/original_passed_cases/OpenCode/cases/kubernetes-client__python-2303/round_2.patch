+    @mock.patch('subprocess.Popen')
+    def test_provide_cluster_info(self, mock):
+        instance = mock.return_value
+        instance.wait.return_value = 0
+        instance.communicate.return_value = (self.output_ok, '')
+        cluster_info = {'server': 'https://cluster.example'}
+        ep = ExecProvider(ConfigNode('test', dict(
+            self.input_ok.value, provideClusterInfo=True)), None,
+            cluster_info)
+        ep.run()
+        exec_info = json.loads(mock.call_args[1]['env']['KUBERNETES_EXEC_INFO'])
+        self.assertEqual(cluster_info, exec_info['spec']['cluster'])
