+    def shape_to_path(element):
+        """Convert a basic SVG shape element to path data."""
+        attrib = element.attrib
+        kind = element.tag.rsplit("}", 1)[-1]
+
+        def number(name, default=0.0):
+            return float(attrib.get(name, default))
+
+        def points():
+            values = re.findall(
+                r"[-+]?(?:\d*\.\d+|\d+\.?)(?:[eE][-+]?\d+)?", attrib["points"]
+            )
+            if len(values) % 2 != 0:
+                raise ValueError("SVG points must contain pairs of coordinates")
+            return [
+                tuple(map(float, values[i : i + 2])) for i in range(0, len(values), 2)
+            ]
+
+        if kind == "rect":
+            x, y = number("x"), number("y")
+            width, height = number("width"), number("height")
+            rx, ry = attrib.get("rx"), attrib.get("ry")
+            if rx is None and ry is None:
+                return f"M{x},{y}h{width}v{height}h{-width}z"
+            rx = float(rx if rx is not None else ry)
+            ry = float(ry if ry is not None else rx)
+            rx, ry = min(rx, width / 2.0), min(ry, height / 2.0)
+            if rx == 0 or ry == 0:
+                return f"M{x},{y}h{width}v{height}h{-width}z"
+            return (
+                f"M{x + rx},{y}h{width - 2 * rx}"
+                f"a{rx},{ry} 0 0 1 {rx},{ry}"
+                f"v{height - 2 * ry}a{rx},{ry} 0 0 1 {-rx},{ry}"
+                f"h{-(width - 2 * rx)}a{rx},{ry} 0 0 1 {-rx},{-ry}"
+                f"v{-(height - 2 * ry)}a{rx},{ry} 0 0 1 {rx},{-ry}z"
+            )
+        if kind in ("circle", "ellipse"):
+            cx, cy = number("cx"), number("cy")
+            rx = number("r") if kind == "circle" else number("rx")
+            ry = rx if kind == "circle" else number("ry")
+            return (
+                f"M{cx - rx},{cy}a{rx},{ry} 0 1 0 {2 * rx},0"
+                f"a{rx},{ry} 0 1 0 {-2 * rx},0z"
+            )
+        if kind == "line":
+            return (
+                f"M{number('x1')},{number('y1')}"
+                f"L{number('x2')},{number('y2')}"
+            )
+        if kind in ("polyline", "polygon"):
+            values = points()
+            if len(values) == 0:
+                return ""
+            path = "M" + "L".join(f"{x},{y}" for x, y in values)
+            return path + ("z" if kind == "polygon" else "")
+        return None
+
