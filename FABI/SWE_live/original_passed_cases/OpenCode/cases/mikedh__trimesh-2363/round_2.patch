+def _svg_shape_to_path(element):
+    """Convert an SVG basic shape element to an SVG path string."""
+    tag = element.tag.rsplit("}", 1)[-1]
+    attr = element.attrib
+
+    def number(name, default=0.0):
+        return float(attr.get(name, default))
+
+    if tag == "rect":
+        x, y = number("x"), number("y")
+        width, height = number("width"), number("height")
+        rx = number("rx", 0.0)
+        ry = number("ry", 0.0)
+        if "rx" in attr and "ry" not in attr:
+            ry = rx
+        elif "ry" in attr and "rx" not in attr:
+            rx = ry
+        rx = min(abs(rx), width / 2.0)
+        ry = min(abs(ry), height / 2.0)
+        if rx == 0.0 or ry == 0.0:
+            return f"M{x},{y}H{x + width}V{y + height}H{x}Z"
+        return (
+            f"M{x + rx},{y}H{x + width - rx}"
+            f"A{rx},{ry} 0 0 1 {x + width},{y + ry}"
+            f"V{y + height - ry}A{rx},{ry} 0 0 1 {x + width - rx},{y + height}"
+            f"H{x + rx}A{rx},{ry} 0 0 1 {x},{y + height - ry}"
+            f"V{y + ry}A{rx},{ry} 0 0 1 {x + rx},{y}Z"
+        )
+    if tag in ("circle", "ellipse"):
+        cx, cy = number("cx"), number("cy")
+        rx = number("r") if tag == "circle" else number("rx")
+        ry = rx if tag == "circle" else number("ry")
+        return (
+            f"M{cx - rx},{cy}A{rx},{ry} 0 1 0 {cx + rx},{cy}"
+            f"A{rx},{ry} 0 1 0 {cx - rx},{cy}Z"
+        )
+    if tag == "line":
+        return f"M{number('x1')},{number('y1')}L{number('x2')},{number('y2')}"
+    if tag in ("polyline", "polygon"):
+        points = re.findall(
+            r"[-+]?(?:\d*\.\d+|\d+\.?)(?:[eE][-+]?\d+)?",
+            attr.get("points", ""),
+        )
+        if len(points) < 4 or len(points) % 2:
+            return ""
+        coords = list(zip(points[::2], points[1::2]))
+        path = "M" + "L".join(f"{x},{y}" for x, y in coords)
+        return path + ("Z" if tag == "polygon" else "")
+    return None
+
