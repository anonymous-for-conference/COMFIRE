+def _svg_shape_to_path(attrib, tag):
+    """Convert a basic SVG shape's attributes into path data."""
+
+    def number(name, default=0.0):
+        return float(attrib.get(name, default))
+
+    if tag == "rect":
+        x, y = number("x"), number("y")
+        width, height = number("width"), number("height")
+        return f"M {x} {y} H {x + width} V {y + height} H {x} Z"
+    if tag == "circle":
+        cx, cy, radius = number("cx"), number("cy"), number("r")
+        return (
+            f"M {cx - radius} {cy} "
+            f"A {radius} {radius} 0 1 0 {cx + radius} {cy} "
+            f"A {radius} {radius} 0 1 0 {cx - radius} {cy} Z"
+        )
+    if tag == "ellipse":
+        cx, cy = number("cx"), number("cy")
+        rx, ry = number("rx"), number("ry")
+        return (
+            f"M {cx - rx} {cy} "
+            f"A {rx} {ry} 0 1 0 {cx + rx} {cy} "
+            f"A {rx} {ry} 0 1 0 {cx - rx} {cy} Z"
+        )
+    if tag == "line":
+        return f"M {number('x1')} {number('y1')} L {number('x2')} {number('y2')}"
+    if tag in ("polyline", "polygon"):
+        points = attrib.get("points", "")
+        if tag == "polygon":
+            return f"M {points} Z"
+        return f"M {points}"
+    return None
+
+
