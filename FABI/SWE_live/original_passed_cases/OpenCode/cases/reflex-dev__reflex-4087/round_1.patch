+def test_reset_backend_vars():
+    """Calling reset should reset private backend vars in all substates."""
+
+    class PrivateState(BaseState):
+        public: int = 0
+        _private: int = 1
+
+    class PrivateChildState(PrivateState):
+        child_public: int = 0
+        _child_private: int = 2
+
+    instance = PrivateState()
+    child = instance.get_substate([PrivateChildState.get_name()])
+    instance.public = 3
+    instance._private = 4
+    child.child_public = 5
+    child._child_private = 6
+
+    instance.reset()
+
+    assert instance.public == 0
+    assert instance._private == 1
+    assert child.child_public == 0
+    assert child._child_private == 2
+
+
