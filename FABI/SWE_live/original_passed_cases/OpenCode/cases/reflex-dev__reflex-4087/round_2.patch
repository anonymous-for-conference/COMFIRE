+def test_reset_backend_vars():
+    """Test resetting private backend vars on a state and its substates."""
+
+    class ResetState(BaseState):
+        public: str = "default"
+        _private: str = "default"
+
+    class ResetSubstate(ResetState):
+        substate_public: str = "default"
+        _substate_private: str = "default"
+
+    state = ResetState(_reflex_internal_init=True)
+    substate = state.substates[ResetSubstate.get_name()]
+    state.public = "changed"
+    state._private = "changed"
+    substate.substate_public = "changed"
+    substate._substate_private = "changed"
+
+    state.reset()
+
+    assert state.public == "default"
+    assert state._private == "default"
+    assert substate.substate_public == "default"
+    assert substate._substate_private == "default"
+
+
