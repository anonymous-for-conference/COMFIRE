+@pytest.mark.parametrize("geom", all_types[1:] + all_types_z[1:])
+def test_from_ragged_array_sliced(geom):
+    typ, coords, offsets = shapely.to_ragged_array([geom, geom])
+    sliced_offsets = (*offsets[:-1], offsets[-1][1:])
+
+    actual = shapely.from_ragged_array(typ, coords, sliced_offsets)
+
+    assert_geometries_equal(actual, [geom])
+
