+def _normalize_offsets(coords, offsets):
+    """Normalize offsets and coordinates for a potentially sliced array."""
+    offsets = tuple(np.asarray(offset, dtype="int64") for offset in offsets)
+
+    if len(offsets) == 1:
+        coord_start = offsets[0][0]
+        coord_stop = offsets[0][-1]
+        coords = coords[coord_start:coord_stop]
+        offsets = (offsets[0] - coord_start,)
+    elif len(offsets) == 2:
+        offset_start = offsets[1][0]
+        offset_stop = offsets[1][-1]
+        coord_start = offsets[0][offset_start]
+        coord_stop = offsets[0][offset_stop]
+        coords = coords[coord_start:coord_stop]
+        offsets = (
+            offsets[0][offset_start : offset_stop + 1] - coord_start,
+            offsets[1] - offset_start,
+        )
+    else:
+        offset_start = offsets[2][0]
+        offset_stop = offsets[2][-1]
+        ring_start = offsets[1][offset_start]
+        ring_stop = offsets[1][offset_stop]
+        coord_start = offsets[0][ring_start]
+        coord_stop = offsets[0][ring_stop]
+        coords = coords[coord_start:coord_stop]
+        offsets = (
+            offsets[0][ring_start : ring_stop + 1] - coord_start,
+            offsets[1][offset_start : offset_stop + 1] - ring_start,
+            offsets[2] - offset_start,
+        )
+
+    return coords, offsets
+
+
