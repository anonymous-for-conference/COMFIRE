+    def test_deleting_bookmark_deletes_preview_image(self):
+        with tempfile.TemporaryDirectory() as preview_folder:
+            with override_settings(LD_PREVIEW_FOLDER=preview_folder):
+                preview_image_file = "preview.png"
+                preview_image_path = os.path.join(preview_folder, preview_image_file)
+                with open(preview_image_path, "wb"):
+                    pass
+
+                bookmark = Bookmark.objects.create(
+                    url="https://example.com",
+                    date_added=timezone.now(),
+                    date_modified=timezone.now(),
+                    owner=User.objects.create_user("testuser"),
+                    preview_image_file=preview_image_file,
+                )
+                bookmark.delete()
+
+                self.assertFalse(os.path.exists(preview_image_path))
