+def _normalize_ragged_array(coords, offsets):
+    """Normalize offsets and coordinates for a sliced ragged array.
+
+    Arrow slices can retain the offsets and coordinate buffers of the original
+    array.  In that case the first offset is not necessarily zero and the
+    coordinate buffer can contain values that are not referenced by the
+    selected geometries.  The constructors below expect a self-contained
+    (zero-based) set of offsets, so use views of the relevant coordinate
+    range and normalize the offsets.
+    """
+    offsets = [np.asarray(offset, dtype="int64") for offset in offsets]
+
+    # Work from the outside in, selecting the entries in each inner offset
+    # array that are referenced by the outer array.
+    for i in range(len(offsets) - 1, 0, -1):
+        start = offsets[i][0]
+        end = offsets[i][-1]
+        offsets[i - 1] = offsets[i - 1][start : end + 1]
+        offsets[i] = offsets[i] - start
+
+    coord_start = offsets[0][0]
+    coord_end = offsets[0][-1]
+    offsets[0] = offsets[0] - coord_start
+    coords = coords[coord_start:coord_end]
+    return coords, tuple(offsets)
+
+
 def from_ragged_array(geometry_type, coords, offsets=None):
