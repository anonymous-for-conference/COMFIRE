+def _normalize_ragged_array(coords, offsets, geometry_type):
+    """Trim and normalize offsets for a (possibly sliced) ragged array.
+
+    Arrow slices can leave the coordinate buffer, and the offset buffers at
+    the lower levels of a nested list, untouched.  The offsets therefore do
+    not necessarily start at zero and can refer to a larger buffer than the
+    geometries being constructed.  The constructors below expect compact
+    offsets (and, for the single-level case, an equally sized coordinate
+    buffer), so make a view of the part that is actually referenced.
+    """
+    offsets = tuple(np.asarray(offset, dtype="int64") for offset in offsets)
+
+    if geometry_type in (GeometryType.LINESTRING, GeometryType.MULTIPOINT):
+        coord_start = offsets[0][0]
+        coord_end = offsets[0][-1]
+        return coords[coord_start:coord_end], (offsets[0] - coord_start,)
+
+    if geometry_type in (GeometryType.POLYGON, GeometryType.MULTILINESTRING):
+        offsets1, offsets2 = offsets
+        level_start = offsets2[0]
+        level_end = offsets2[-1]
+        coord_start = offsets1[level_start]
+        coord_end = offsets1[level_end]
+        offsets1 = offsets1[level_start : level_end + 1] - coord_start
+        offsets2 = offsets2 - level_start
+        return coords[coord_start:coord_end], (offsets1, offsets2)
+
+    # MULTIPOLYGON
+    offsets1, offsets2, offsets3 = offsets
+    part_start = offsets3[0]
+    part_end = offsets3[-1]
+    ring_start = offsets2[part_start]
+    ring_end = offsets2[part_end]
+    coord_start = offsets1[ring_start]
+    coord_end = offsets1[ring_end]
+    offsets1 = offsets1[ring_start : ring_end + 1] - coord_start
+    offsets2 = offsets2[part_start : part_end + 1] - ring_start
+    offsets3 = offsets3 - part_start
+    return coords[coord_start:coord_end], (offsets1, offsets2, offsets3)
+
+
