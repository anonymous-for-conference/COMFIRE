index 38d8c306..98cd491b 100644
--- a/bookmarks/models.py
+++ b/bookmarks/models.py
@@ -93,6 +93,31 @@ class Bookmark(models.Model):
         return self.resolved_title + " (" + self.url[:30] + "...)"
 
 
+@receiver(post_delete, sender=Bookmark)
+def bookmark_preview_image_deleted(sender, instance, **kwargs):
+    # Preview images are stored outside of the database, so remove the file
+    # when the bookmark that references it is deleted.  A preview can be
+    # shared by bookmarks (the filename is derived from the URL), therefore
+    # leave it in place while another bookmark still references it.
+    if not instance.preview_image_file:
+        return
+
+    is_still_referenced = Bookmark.objects.filter(
+        preview_image_file=instance.preview_image_file
+    ).exists()
+    if is_still_referenced:
+        return
+
+    filepath = os.path.join(settings.LD_PREVIEW_FOLDER, instance.preview_image_file)
+    if os.path.isfile(filepath):
+        try:
+            os.remove(filepath)
+        except Exception as error:
+            logger.error(
+                f"Failed to delete preview image file: {filepath}", exc_info=error
+            )
+
+
 class BookmarkAsset(models.Model):
     TYPE_SNAPSHOT = "snapshot"
     TYPE_UPLOAD = "upload"
